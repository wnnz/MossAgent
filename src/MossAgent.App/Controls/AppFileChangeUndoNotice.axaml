<ui:AppUserControl xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:MossAgent.App.Controls"
                   x:Class="MossAgent.App.Controls.AppFileChangeUndoNotice" x:CompileBindings="False">
  <StackPanel Classes="file-change-undo-notice" IsVisible="{Binding HasNotice}">
    <ui:AppText Classes="type-12 subtle" Text="{Binding Notice}" TextWrapping="Wrap" />
    <WrapPanel>
      <ui:AppButton Classes="file-change-review" Content="{Binding ConfirmLabel}"
                    Command="{Binding ConfirmCommand}" IsVisible="{Binding CanConfirm}" />
      <ui:AppButton Classes="file-change-review" Content="{Binding RetrySaveLabel}"
                    Command="{Binding RetrySaveCommand}" IsVisible="{Binding HasUnsavedRecord}" />
      <ui:AppButton Classes="ghost file-change-undo-action" Content="{Binding CancelLabel}"
                    Command="{Binding CancelCommand}" IsVisible="{Binding !HasUnsavedRecord}" />
    </WrapPanel>
  </StackPanel>
</ui:AppUserControl>
