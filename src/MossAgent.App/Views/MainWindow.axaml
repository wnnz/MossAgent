<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MossAgent.App.Views"
        x:Class="MossAgent.App.Views.MainWindow"
        x:CompileBindings="False"
        Title="MossAgent"
        Width="1480" Height="920"
        MinWidth="1100" MinHeight="700"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="42"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid RowDefinitions="42,*">
    <!-- 沉浸式顶栏：隐藏原生标题栏，预留右侧165px系统控制区，杜绝重叠 -->
    <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
            Padding="16,0,165,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <!-- 左侧：极简菜单导航 -->
        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <TextBlock Text="MossAgent" FontSize="13" FontWeight="SemiBold"
                     Classes="muted" VerticalAlignment="Center" />
          <TextBlock Text="文件" FontSize="12" Classes="subtle" VerticalAlignment="Center" />
          <TextBlock Text="编辑" FontSize="12" Classes="subtle" VerticalAlignment="Center" />
          <TextBlock Text="视图" FontSize="12" Classes="subtle" VerticalAlignment="Center" />
          <TextBlock Text="帮助" FontSize="12" Classes="subtle" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 右侧：加大舒适点击尺寸的纯图标操作按钮 -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="{Binding ThemeIcon}" Classes="ghost"
                  Width="32" Height="32" Padding="0" CornerRadius="6"
                  FontSize="15" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Command="{Binding ToggleThemeCommand}"
                  ToolTip.Tip="切换明暗主题模式" />

          <Button Content="◫" Classes="ghost"
                  Width="32" Height="32" Padding="0" CornerRadius="6"
                  FontSize="15" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Command="{Binding ToggleRightPanelCommand}"
                  ToolTip.Tip="切换右侧边栏显隐" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 主工作区：三栏布局（侧边栏、主对话工作台、右侧检查器） -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
      <!-- 左栏：会话与项目侧边栏（包含左下角唯一的系统设置入口） -->
      <views:WorkspaceSidebar Grid.Column="0" DataContext="{Binding Workspace.Catalog}"
                              Width="260" Margin="10,10,4,10" />

      <!-- 中栏：主任务对话与执行工作台 -->
      <views:WorkspaceChatView Grid.Column="1" DataContext="{Binding Workspace}"
                               Margin="4,10,4,10" />

      <!-- 右栏：上下文检查器面板（可按需隐藏） -->
      <views:InspectorPane Grid.Column="2" DataContext="{Binding}"
                           Width="380" Margin="4,10,10,10"
                           IsVisible="{Binding IsRightPanelOpen}" />
    </Grid>

    <!-- 浮动层：工具调用审批确认卡片 -->
    <Border Grid.Row="1" Classes="card" IsVisible="{Binding Approval.IsPending}"
            HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Width="520" Margin="0,0,0,32"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderDefaultBrush}"
            BorderThickness="1" BoxShadow="0 12 36 0 #55000000">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="Auto,*">
          <Border Background="#452B0C" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
            <TextBlock Text="⚠️ 需审批" FontSize="11" Foreground="#FBBF24" FontWeight="SemiBold" />
          </Border>
          <TextBlock Grid.Column="1" Text="工具调用需要您的确认" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <TextBlock Text="{Binding Approval.ToolName}" FontFamily="Consolas" FontSize="13" />
        <TextBlock Text="{Binding Approval.Description}" TextWrapping="Wrap" Classes="muted" FontSize="12" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
          <Button Classes="danger" Content="拒绝" Command="{Binding Approval.DenyCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Classes="primary" Content="批准本次调用" Command="{Binding Approval.ApproveCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- 浮动全屏覆盖层：统一系统设置抽屉 -->
    <views:SettingsOverlay Grid.Row="0" Grid.RowSpan="2" DataContext="{Binding}"
                           IsVisible="{Binding IsSettingsOpen}" />
  </Grid>
</Window>
