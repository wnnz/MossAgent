<ui:AppUserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MossAgent.App.Controls"
             xmlns:labels="clr-namespace:MossAgent.App.Resources"
             x:Class="MossAgent.App.Views.McpSettingsPane"
             x:CompileBindings="False">
  <ui:AppUserControl.Resources>
    <ui:McpServerSummaryConverter x:Key="McpServerSummaryConverter" />
  </ui:AppUserControl.Resources>
  <Grid>
    <Grid Classes="settings-content-column" RowDefinitions="Auto,Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
          <StackPanel Spacing="2">
            <ui:AppText Text="插件" Classes="settings-title" />
            <ui:AppText Text="通过 MCP 连接外部工具和服务。" Classes="settings-description" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ui:AppButton Content="重新连接" Classes="ghost" Command="{Binding ReloadCommand}" />
            <ui:AppActionButton Label="添加 MCP 服务" IconData="{StaticResource UiIconPlus}" Classes="primary" Command="{Binding OpenCreateFormCommand}" />
          </StackPanel>
        </Grid>
    <ui:AppCard Grid.Row="1" Classes="card card-inset-list">
      <StackPanel>
        <StackPanel Margin="12,16" Spacing="6" IsVisible="{Binding HasNoItems}">
          <ui:AppText Classes="type-14 weight-semibold" Text="还没有 MCP 服务" />
          <ui:AppText Text="添加服务后，它提供的工具会在允许的任务中可用。"
                     Classes="muted type-12" />
        </StackPanel>
        <ui:AppListBox MaxHeight="560" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <ui:AppSettingsItemRow Title="{Binding Name}"
                    Subtitle="{Binding ., Converter={StaticResource McpServerSummaryConverter}}"
                    ActionTarget="{Binding}" IsPrimaryAlternate="{Binding IsEnabled}"
                    PrimaryLabel="{x:Static labels:SettingsItemLabels.Enable}"
                    AlternatePrimaryLabel="{x:Static labels:SettingsItemLabels.Disable}"
                    PrimaryCommand="{Binding $parent[UserControl].DataContext.ToggleEnabledCommand}"
                    SecondaryLabel="{x:Static labels:SettingsItemLabels.Edit}"
                    SecondaryCommand="{Binding $parent[UserControl].DataContext.OpenEditFormCommand}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ui:AppListBox>
      </StackPanel>
    </ui:AppCard>

    <ui:AppText Grid.Row="2" Text="{Binding Status}" Classes="muted type-12"
                TextWrapping="Wrap" Margin="0,12,0,0" IsVisible="{Binding HasStatus}" />
    </Grid>

    <ui:AppSettingsDialog Classes="wide" IsOpen="{Binding IsFormOpen}"
                          Title="{Binding EditorTitle}" CloseCommand="{Binding CloseFormCommand}">
            <StackPanel Spacing="9">
            <ui:AppText Text="Server 名称" Classes="muted type-12" />
            <ui:AppInput Text="{Binding Name}" PlaceholderText="例如 filesystem" />
            <ui:AppText Text="传输协议" Classes="muted type-12" />
            <ui:AppComboBox ItemsSource="{Binding TransportOptions}" SelectedItem="{Binding SelectedTransportOption}"
                            DisplayMemberBinding="{Binding DisplayName}" HorizontalAlignment="Stretch" />
            <StackPanel Spacing="9" IsVisible="{Binding IsStdioTransport}">
              <ui:AppText Text="stdio 命令" Classes="muted type-12" />
              <ui:AppInput Text="{Binding Command}" PlaceholderText="例如 npx" />
              <ui:AppText Text="参数 JSON 数组" Classes="muted type-12" />
              <ui:AppInput Text="{Binding ArgumentsJson}" AcceptsReturn="True" Classes="code-font json-editor" />
              <ui:AppText Text="工作目录" Classes="muted type-12" />
              <ui:AppInput Text="{Binding WorkingDirectory}" />
              <ui:AppText Text="环境变量 JSON 对象" Classes="muted type-12" />
              <ui:AppInput Text="{Binding EnvironmentJson}" AcceptsReturn="True" Classes="code-font json-editor" />
            </StackPanel>
            <StackPanel Spacing="9" IsVisible="{Binding IsHttpTransport}">
              <ui:AppText Text="Streamable HTTP URL" Classes="muted type-12" />
              <ui:AppInput Text="{Binding Url}" PlaceholderText="http://localhost:8000/sse" />
              <ui:AppText Text="HTTP 请求头 JSON 对象" Classes="muted type-12" />
              <ui:AppInput Text="{Binding HeadersJson}" AcceptsReturn="True" Classes="code-font json-editor" />
              <ui:AppText Text="HTTP 网络代理" Classes="muted type-12" />
              <ui:AppComboBox ItemsSource="{Binding ProxyOptions}" SelectedItem="{Binding SelectedProxy}"
                              DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <ui:AppCheckBox Content="启用此 MCP Server" IsChecked="{Binding IsEnabled}" Margin="0,4" />
            </StackPanel>
          <ui:AppSettingsDialog.Footer>
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <ui:AppButton Classes="primary" Content="保存并连接" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" />
              <ui:AppButton Grid.Column="1" Classes="danger" Content="{Binding DeleteButtonText}"
                            Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" />
              <ui:AppButton Grid.Column="2" Content="取消" Command="{Binding CloseFormCommand}" />
            </Grid>
            <ui:AppText Text="{Binding Status}" Classes="subtle type-11" TextWrapping="Wrap" IsVisible="{Binding HasStatus}" />
          </StackPanel>
          </ui:AppSettingsDialog.Footer>
    </ui:AppSettingsDialog>
  </Grid>
</ui:AppUserControl>
