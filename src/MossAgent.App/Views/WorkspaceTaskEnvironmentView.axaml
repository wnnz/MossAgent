<ui:AppUserControl xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:MossAgent.App.Controls"
                   x:Class="MossAgent.App.Views.WorkspaceTaskEnvironmentView"
                   x:CompileBindings="False" IsVisible="{Binding HasProject}">
  <ui:AppActionButton x:Name="EnvironmentButton" Classes="composer-context-button composer-environment-button"
                      Label="{Binding Label}" IsEnabled="{Binding CanChoose}" ToolTip.Tip="{Binding Hint}"
                      AutomationProperties.Name="{Binding Label}" TrailingIconData="{StaticResource UiIconChevronDown}">
    <Button.Flyout>
      <ui:AppFlyout Placement="TopEdgeAlignedLeft"
                    IsOpen="{Binding IsPickerOpen, Mode=TwoWay}">
        <ui:AppCard Classes="flyout-surface card-inset-menu composer-environment-menu">
          <StackPanel Spacing="4">
            <ui:AppActionButton Classes="ghost menu-option align-leading" Label="{Binding ProjectDirectoryLabel}"
                                IconData="{StaticResource UiIconFolder}" Command="{Binding UseProjectDirectoryCommand}" />
            <ui:AppText Classes="type-11 muted" Text="{Binding BaseReferenceLabel}" />
            <ui:AppInput x:Name="BaseReferenceInput" Text="{Binding BaseReference, Mode=TwoWay}"
                             PlaceholderText="{Binding BaseReferencePlaceholder}" MaxLength="512"
                             AutomationProperties.Name="{Binding BaseReferenceLabel}" IsEnabled="{Binding CanChoose}" />
            <StackPanel DataContext="{Binding GitReferences}" IsVisible="{Binding IsAvailable}" Spacing="4">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <ui:AppInput Text="{Binding Search, Mode=TwoWay}" PlaceholderText="{Binding SearchPlaceholder}"
                             AutomationProperties.Name="{Binding SearchLabel}" IsEnabled="{Binding CanLoad}" />
                <ui:AppIconButton Grid.Column="1" Classes="icon-compact" Command="{Binding SearchCommand}"
                                  Label="{Binding SearchLabel}" IconData="{StaticResource UiIconSearch}" />
              </Grid>
              <ui:AppText Text="{Binding Preview}" Classes="type-10-5 text-muted" TextWrapping="Wrap"
                          IsVisible="{Binding HasPreview}" />
              <ui:AppScrollViewer Classes="composer-agent-options" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="4">
                  <ui:AppExpander IsExpanded="True" IsVisible="{Binding HasBranches}">
                    <ui:AppExpander.Header>
                      <ui:AppText Text="{Binding BranchLabel}" Classes="type-11 weight-semibold" />
                    </ui:AppExpander.Header>
                    <ui:AppItemsControl ItemsSource="{Binding Branches}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <ui:AppActionButton Classes="ghost menu-option align-leading" Label="{Binding Name}"
                                              Command="{Binding SelectCommand}"
                                              IconData="{StaticResource UiIconBranch}"
                                              AutomationProperties.Name="{Binding AutomationLabel}"
                                              ToolTip.Tip="{Binding CommitLabel}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ui:AppItemsControl>
                  </ui:AppExpander>
                  <ui:AppExpander IsExpanded="True" IsVisible="{Binding HasTags}">
                    <ui:AppExpander.Header>
                      <ui:AppText Text="{Binding TagLabel}" Classes="type-11 weight-semibold" />
                    </ui:AppExpander.Header>
                    <ui:AppItemsControl ItemsSource="{Binding Tags}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <ui:AppActionButton Classes="ghost menu-option align-leading" Label="{Binding Name}"
                                              Command="{Binding SelectCommand}"
                                              IconData="{StaticResource UiIconBranch}"
                                              AutomationProperties.Name="{Binding AutomationLabel}"
                                              ToolTip.Tip="{Binding CommitLabel}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ui:AppItemsControl>
                  </ui:AppExpander>
                  <ui:AppText Text="{Binding EmptyLabel}" Classes="type-10-5 text-muted"
                              IsVisible="{Binding IsEmpty}" TextWrapping="Wrap" />
                  <ui:AppButton Classes="ghost menu-option" Content="{Binding MoreLabel}"
                                Command="{Binding MoreCommand}" IsVisible="{Binding HasMore}" />
                  <ui:AppText Text="{Binding ErrorLabel}" Classes="status-warning type-10-5"
                              IsVisible="{Binding HasError}" TextWrapping="Wrap" />
                </StackPanel>
              </ui:AppScrollViewer>
            </StackPanel>
            <ui:AppActionButton Classes="ghost menu-option align-leading" Label="{Binding WorktreeLabel}"
                                IconData="{StaticResource UiIconBranch}" Command="{Binding UseWorktreeCommand}" />
            <ui:AppText Classes="type-11 muted" Text="{Binding Hint}" TextWrapping="Wrap" />
          </StackPanel>
        </ui:AppCard>
      </ui:AppFlyout>
    </Button.Flyout>
  </ui:AppActionButton>
</ui:AppUserControl>
