<ui:AppUserControl xmlns="https://github.com/avaloniaui" xmlns:res="clr-namespace:MossAgent.App.Resources"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MossAgent.App.Controls"
             x:Class="MossAgent.App.Controls.AppModelPickerMenu"
             x:CompileBindings="False" MaxHeight="460">
  <ui:AppCard Classes="flyout-surface card-inset-compact">
    <Grid RowDefinitions="Auto,Auto">
      <ui:AppText Text="{Binding CatalogNotice}" Classes="type-11"
                  Classes.muted="{Binding IsLoading}"
                  Classes.status-error="{Binding HasLoadError}"
                  Classes.status-warning="{Binding IsSelectedUnavailable}"
                  IsVisible="{Binding HasCatalogNotice}" MaxWidth="207" Margin="6,0,6,8"
                  TextWrapping="Wrap" />
      <Grid Grid.Row="1" Width="207" RowDefinitions="Auto,Auto,Auto"
            IsVisible="{Binding IsQuickMenuVisible}">
        <Grid ColumnDefinitions="*,Auto">
          <ui:AppActionButton x:Name="QuickNavigationButton" Classes="ghost model-picker-nav align-leading"
                        HorizontalAlignment="Stretch"
                        Label="{Binding ReasoningDisplayName}"
                        TrailingIconData="{StaticResource UiIconChevronRight}"
                        Command="{Binding ShowModelListCommand}"
                        AutomationProperties.Name="{res:L '选择模型'}" />
          <ui:AppIconButton Grid.Column="1" Classes="icon-compact"
                            Command="{Binding ResetReasoningCommand}"
                            Label="{res:L '恢复模型默认思考强度'}"
                            IconData="{StaticResource UiIconRefresh}" />
        </Grid>
        <ui:AppText Grid.Row="1" Text="{Binding SelectedModelName}"
                    Classes="muted type-11" Margin="6,0,6,8"
                    TextTrimming="CharacterEllipsis" />
        <ui:AppDiscreteSlider Grid.Row="2" StepValues="{Binding ReasoningSteps}"
                              SelectedStep="{Binding ReasoningSliderLabel, Mode=TwoWay}"
                              IsEnabled="{Binding CanUseSelectedModel}"
                              AutomationProperties.Name="{res:L '思考强度'}" />
      </Grid>

      <Grid Grid.Row="1" Width="207" RowDefinitions="Auto,Auto,Auto"
            IsVisible="{Binding IsModelListVisible}">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
          <ui:AppIconButton Classes="icon-compact"
                            Command="{Binding ShowQuickMenuCommand}"
                            Label="{res:L '返回思考强度'}"
                            IconData="{StaticResource UiIconArrowLeft}" />
          <ui:AppText Grid.Column="1" Classes="type-12 weight-semibold"
                      Text="{res:L '选择模型'}" Margin="6,0,0,0" />
          <ui:AppIconButton Grid.Column="2" Classes="icon-compact"
                            Command="{Binding RefreshCommand}" Label="{res:L '刷新模型列表'}"
                            IconData="{StaticResource UiIconRefresh}" />
        </Grid>
        <ui:AppInput x:Name="ModelSearchInput" Grid.Row="1" Text="{Binding SearchQuery}"
                     PlaceholderText="{res:L '搜索模型...'}" Margin="0,0,0,8"
                     AutomationProperties.Name="{res:L '搜索模型'}"
                     IsVisible="{Binding ShowSearch}" />
        <Grid Grid.Row="2">
          <StackPanel IsVisible="{Binding HasNoModels}" Spacing="4" Margin="6,10">
            <ui:AppText Classes="type-12 weight-semibold" Text="{Binding EmptyModelTitle}" />
            <ui:AppText Text="{Binding EmptyModelDescription}"
                        Classes="muted type-11" TextWrapping="Wrap" />
            <ui:AppButton Content="{Binding OpenProviderSettingsLabel}"
                          Classes="ghost menu-option" HorizontalAlignment="Left"
                          Command="{Binding OpenProviderSettingsCommand}" />
          </StackPanel>
          <ui:AppText IsVisible="{Binding HasNoMatches}" Classes="muted type-12"
                      Text="{res:L '没有匹配的模型'}" Margin="8,12" />
          <ui:AppScrollViewer MaxHeight="280" IsVisible="{Binding HasModels}"
                              IsEnabled="{Binding CanChooseModel}">
            <ui:AppItemsControl ItemsSource="{Binding FilteredGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,4">
                    <ui:AppIconLabel Classes="model-provider-label" Margin="6,4"
                                     IsVisible="{Binding $parent[UserControl].DataContext.ShowProviderHeaders}"
                                     IconData="{StaticResource UiIconBranch}" Label="{Binding ProviderName}" />
                    <ui:AppItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <ui:AppActionButton Classes="ghost model-option align-leading" HorizontalAlignment="Stretch"
                                        Margin="0,1"
                                        Label="{Binding DisplayName}"
                                        IconData="{StaticResource UiIconDocument}"
                                        TrailingIconData="{StaticResource UiIconCheck}"
                                        IsTrailingIconVisible="{Binding IsSelected}"
                                        AutomationProperties.Name="{Binding AccessibleName}"
                                        Command="{Binding $parent[UserControl].DataContext.SelectItemCommand}"
                                        CommandParameter="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ui:AppItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ui:AppItemsControl>
          </ui:AppScrollViewer>
        </Grid>
      </Grid>
    </Grid>
  </ui:AppCard>
</ui:AppUserControl>
