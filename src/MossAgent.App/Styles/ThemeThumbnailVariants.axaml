<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MossAgent.App.Controls">
  <Style Selector=".app-theme-preview, .app-theme-preview-scene" x:SetterTargetType="controls:AppUserControl">
    <Setter Property="Width" Value="80" />
    <Setter Property="Height" Value="60" />
    <Setter Property="UseLayoutRounding" Value="False" />
  </Style>
  <Style Selector=".app-theme-preview controls|AppBorder.preview-frame">
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector=".app-theme-preview controls|AppBorder.preview-selection-outline">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector=".app-theme-preview.selected controls|AppBorder.preview-selection-outline">
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeChoiceSelectionBrush}" />
  </Style>
  <Style Selector=".app-theme-preview Grid.preview-system-scene">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=".app-theme-preview.preview-system .preview-standard-scene" x:SetterTargetType="controls:AppUserControl">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=".app-theme-preview.preview-system Grid.preview-system-scene">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector=".app-theme-preview-scene controls|AppBorder.preview-backdrop">
    <Setter Property="Background" Value="#F4F4F4" />
    <Setter Property="BorderBrush" Value="#D7D7D7" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector=".app-theme-preview.preview-system .app-theme-preview-scene controls|AppBorder.preview-backdrop">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector=".app-theme-preview-scene controls|AppBorder.preview-screen, .app-theme-preview-scene controls|AppBorder.preview-screen-shadow">
    <Setter Property="Margin" Value="6" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector=".app-theme-preview-scene controls|AppBorder.preview-screen-shadow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BoxShadow" Value="{StaticResource SharedSurfaceShadow}" />
  </Style>
  <Style Selector=".app-theme-preview-scene controls|AppBorder.preview-screen">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#DFDFDF" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector=".app-theme-preview-scene controls|AppBorder.preview-sidebar">
    <Setter Property="Background" Value="#F7F7F7" />
  </Style>
  <Style Selector=".app-theme-preview-scene controls|AppIcon.preview-logo">
    <Setter Property="Size" Value="5" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,3,0,0" />
    <Setter Property="Stroke" Value="#B6B6B6" />
  </Style>
  <Style Selector=".app-theme-preview-scene controls|AppBorder.preview-message-line, .app-theme-preview-scene controls|AppBorder.preview-accent-line">
    <Setter Property="Height" Value="2" />
    <Setter Property="CornerRadius" Value="1" />
    <Setter Property="Background" Value="#E5E5E5" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector=".app-theme-preview-scene controls|AppBorder.preview-accent-line">
    <Setter Property="Background" Value="#339CFF" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector=".app-theme-preview-scene controls|AppBorder.preview-user-first">
    <Setter Property="Width" Value="30" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>
  <Style Selector=".app-theme-preview-scene controls|AppBorder.preview-assistant-first">
    <Setter Property="Width" Value="30" />
  </Style>
  <Style Selector=".app-theme-preview-scene controls|AppBorder.preview-assistant-second">
    <Setter Property="Width" Value="18" />
  </Style>
  <Style Selector=".app-theme-preview-scene controls|AppBorder.preview-assistant-third">
    <Setter Property="Width" Value="36" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>
  <Style Selector=".app-theme-preview-scene controls|AppBorder.preview-user-second">
    <Setter Property="Width" Value="39" />
  </Style>
  <Style Selector=".app-theme-preview-scene controls|AppBorder.preview-user-third">
    <Setter Property="Width" Value="23" />
  </Style>
  <Style Selector=".app-theme-preview-scene controls|AppBorder.preview-composer">
    <Setter Property="Height" Value="8" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderBrush" Value="#E7E7E7" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector=".app-theme-preview-scene controls|AppBorder.preview-send">
    <Setter Property="Width" Value="4" />
    <Setter Property="Height" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="#339CFF" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector=".app-theme-preview.preview-dark .app-theme-preview-scene controls|AppBorder.preview-backdrop, .app-theme-preview-scene.scene-dark controls|AppBorder.preview-backdrop">
    <Setter Property="Background" Value="#262626" />
    <Setter Property="BorderBrush" Value="#1E1E1E" />
  </Style>
  <Style Selector=".app-theme-preview.preview-dark .app-theme-preview-scene controls|AppBorder.preview-screen, .app-theme-preview-scene.scene-dark controls|AppBorder.preview-screen">
    <Setter Property="Background" Value="#0D0D0D" />
    <Setter Property="BorderBrush" Value="#303030" />
  </Style>
  <Style Selector=".app-theme-preview.preview-dark .app-theme-preview-scene controls|AppBorder.preview-sidebar, .app-theme-preview-scene.scene-dark controls|AppBorder.preview-sidebar">
    <Setter Property="Background" Value="#3D3D3D" />
  </Style>
  <Style Selector=".app-theme-preview.preview-dark .app-theme-preview-scene controls|AppBorder.preview-message-line, .app-theme-preview-scene.scene-dark controls|AppBorder.preview-message-line">
    <Setter Property="Background" Value="#565656" />
  </Style>
  <Style Selector=".app-theme-preview.preview-dark .app-theme-preview-scene controls|AppBorder.preview-composer, .app-theme-preview-scene.scene-dark controls|AppBorder.preview-composer">
    <Setter Property="BorderBrush" Value="#3B3B3B" />
  </Style>
</Styles>
