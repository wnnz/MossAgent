<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MossAgent.App.Views.WorkspaceSidebar"
             x:CompileBindings="False">
  <Border Background="{DynamicResource SidebarBackgroundBrush}"
          BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0"
          Padding="10,10">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
      <Grid ColumnDefinitions="*,Auto" Margin="6,2,4,12">
        <TextBlock Text="工作区" FontWeight="SemiBold" FontSize="13"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="＋" Classes="ghost" Width="26" Height="26"
                Padding="0" FontSize="14" ToolTip.Tip="添加项目">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <Border Background="{DynamicResource CardBackgroundBrush}"
                      BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                      CornerRadius="10" Padding="14" Width="300">
                <StackPanel Spacing="8">
                  <TextBlock Text="添加本地项目" FontWeight="SemiBold" FontSize="13" />
                  <TextBox Text="{Binding ProjectEditor.Name}" PlaceholderText="项目名称" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Text="{Binding ProjectEditor.Directory}" PlaceholderText="项目绝对路径" />
                    <Button Grid.Column="1" Content="浏览…" Classes="ghost"
                            Command="{Binding ProjectEditor.BrowseDirectoryCommand}" />
                  </Grid>
                  <TextBox Text="{Binding ProjectEditor.AuthorizedDirectories}"
                           PlaceholderText="其他授权目录，以分号分隔"
                           AcceptsReturn="True" MinHeight="48" />
                  <Button Content="添加项目" Classes="primary"
                          Command="{Binding ProjectEditor.AddCommand}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center" />
                  <TextBlock Text="{Binding ProjectEditor.Status}" Classes="muted" FontSize="11"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>

      <Button Grid.Row="1" Classes="ghost" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Left" Padding="9,7"
              Command="{Binding NewTaskCommand}">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <TextBlock Text="＋" FontSize="15" VerticalAlignment="Center" />
          <TextBlock Text="新建任务" FontSize="13" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <TextBlock Grid.Row="2" Text="项目" Classes="subtle" FontSize="11"
                 FontWeight="SemiBold" Margin="8,16,8,6" />

      <ListBox Grid.Row="3" ItemsSource="{Binding Projects}"
               SelectedItem="{Binding SelectedProject}"
               MaxHeight="180" Margin="0,0,0,4">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="20,*" Margin="1">
              <TextBlock Text="◇" Classes="muted" FontSize="12"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5"
                         Margin="5,0,0,0" TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Grid.Row="4" Text="任务" Classes="subtle" FontSize="11"
                 FontWeight="SemiBold" Margin="8,12,8,6" />

      <Grid Grid.Row="5">
        <ListBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" Margin="1">
                <TextBlock Text="{Binding Title}" FontSize="12.5"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="subtle"
                           FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Border Grid.Row="6" BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
        <Button Classes="ghost" Padding="8,7" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Command="{Binding $parent[Window].DataContext.OpenSettingsCommand}">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <TextBlock Text="⚙" FontSize="13" Classes="muted" />
            <TextBlock Text="设置" FontSize="12.5" />
          </StackPanel>
        </Button>
      </Border>
    </Grid>
  </Border>
</UserControl>
