<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MossAgent.App.Views"
             xmlns:domain="clr-namespace:MossAgent.Domain;assembly=MossAgent.Domain"
             x:Class="MossAgent.App.Views.WorkspaceComposerView"
             x:CompileBindings="False">
  <UserControl.Styles>
    <Style Selector="TextBox.composer-input">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="2,4" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector="TextBox.composer-input /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <Border Margin="28,0,28,18" MaxWidth="900" HorizontalAlignment="Stretch"
          Background="{DynamicResource CardSubtleBackgroundBrush}"
          BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
          CornerRadius="14" Padding="14,11" BoxShadow="0 6 24 0 #16000000">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
      <StackPanel Orientation="Horizontal" Spacing="7" Margin="2,0,0,5">
        <TextBlock Text="▱" Classes="subtle" FontSize="11" />
        <TextBlock Text="{Binding RepositoryStatus.DirectoryLabel}"
                   Classes="muted" FontSize="11" FontFamily="Consolas" />
        <TextBlock Text="·" Classes="subtle" />
        <TextBlock Text="⑂" Classes="subtle" FontSize="11" />
        <TextBlock Text="{Binding RepositoryStatus.BranchLabel}" Classes="muted"
                   FontSize="11" FontFamily="Consolas" />
      </StackPanel>

      <ItemsControl Grid.Row="1" ItemsSource="{Binding Attachments.Items}"
                    IsVisible="{Binding Attachments.HasItems}" Margin="0,1,0,5">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                    CornerRadius="7" Padding="7,3" Margin="0,0,5,4">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="{Binding DisplayPath}" FontSize="10.5"
                           MaxWidth="220" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SizeLabel}" Classes="subtle" FontSize="9.5" />
                <Button Content="×" Classes="ghost" Width="28" Height="28" Padding="0"
                        FontSize="13"
                        Command="{Binding RemoveCommand}" ToolTip.Tip="移除附件" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Grid.Row="2" Text="{Binding Attachments.Status}"
                 Foreground="#F97316" FontSize="10.5" TextWrapping="Wrap" />

      <TextBox Grid.Row="3" Classes="composer-input" Text="{Binding ComposerText}"
               PlaceholderText="让 MossAgent 构建、修复或解释代码…"
               AcceptsReturn="True" MinHeight="58" MaxHeight="180" FontSize="13" />

      <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,8,0,0">
        <Button Content="＋" Classes="ghost icon"
                Command="{Binding Attachments.AddFilesCommand}"
                CommandParameter="{Binding Catalog.SelectedProject}"
                ToolTip.Tip="附加项目内的文本文件" />

        <Button x:Name="ApprovalPolicyButton" Grid.Column="1" Classes="ghost"
                Padding="9,5" CornerRadius="6" ToolTip.Tip="选择工具审批策略">
          <Button.Flyout>
            <Flyout Placement="TopEdgeAlignedLeft">
              <Border Background="{DynamicResource CardBackgroundBrush}"
                      BorderBrush="{DynamicResource BorderDefaultBrush}"
                      BorderThickness="1" CornerRadius="10" Padding="6" Width="310">
                <StackPanel>
                  <TextBlock Text="工具权限" FontWeight="SemiBold" FontSize="12"
                             Margin="8,6,8,5" />
                  <Button Classes="ghost" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left" Padding="9,7"
                          Command="{Binding SetApprovalPolicyCommand}"
                          CommandParameter="{x:Static domain:ApprovalPolicy.ReadOnly}"
                          Click="HandleApprovalPolicySelected">
                    <StackPanel>
                      <TextBlock Text="只读模式" FontWeight="SemiBold" FontSize="12" />
                      <TextBlock Text="只允许读取文件和明确的只读操作" Classes="muted" FontSize="10.5" />
                    </StackPanel>
                  </Button>
                  <Button Classes="ghost" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left" Padding="9,7"
                          Command="{Binding SetApprovalPolicyCommand}"
                          CommandParameter="{x:Static domain:ApprovalPolicy.AskEveryTime}"
                          Click="HandleApprovalPolicySelected">
                    <StackPanel>
                      <TextBlock Text="每次询问" FontWeight="SemiBold" FontSize="12" />
                      <TextBlock Text="修改文件、运行命令或操作浏览器前询问" Classes="muted" FontSize="10.5" />
                    </StackPanel>
                  </Button>
                  <Button Classes="ghost" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left" Padding="9,7"
                          Command="{Binding SetApprovalPolicyCommand}"
                          CommandParameter="{x:Static domain:ApprovalPolicy.FullAccess}"
                          Click="HandleApprovalPolicySelected">
                    <StackPanel>
                      <TextBlock Text="完全访问" FontWeight="SemiBold" FontSize="12" />
                      <TextBlock Text="授权目录和当前浏览器会话内无需逐次询问" Classes="muted" FontSize="10.5" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
          <TextBlock Text="{Binding ApprovalPolicyLabel}" FontSize="11.5"
                     Foreground="#F97316" FontWeight="SemiBold" />
        </Button>

        <TextBlock Grid.Column="2" Text="Ctrl+Enter 发送" Classes="subtle"
                   FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"
                   Margin="0,0,10,0" />

        <Button Grid.Column="3" Classes="ghost" Padding="10,5" CornerRadius="6"
                Margin="0,0,7,0" VerticalAlignment="Center">
          <Button.Flyout>
            <Flyout Placement="TopEdgeAlignedRight">
              <views:ModelPickerFlyoutView DataContext="{Binding ModelPicker}" />
            </Flyout>
          </Button.Flyout>
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="{Binding ModelPicker.CurrentDisplayName}" FontSize="12"
                       Classes="muted" VerticalAlignment="Center" />
            <TextBlock Text="⌄" Classes="subtle" FontSize="10" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Grid.Column="4" Classes="primary" Command="{Binding PrimaryActionCommand}"
                Width="34" Height="34" CornerRadius="17" Padding="0"
                ToolTip.Tip="发送任务或停止执行">
          <Panel>
            <TextBlock Text="■" IsVisible="{Binding IsRunning}" FontSize="10"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Text="↑" IsVisible="{Binding !IsRunning}" FontSize="16"
                       FontWeight="Bold" HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Panel>
        </Button>
      </Grid>
    </Grid>
  </Border>
</UserControl>
