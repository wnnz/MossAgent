<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MossAgent.App.Controls">
  <Style Selector=".app-empty-state" x:SetterTargetType="ui:AppEmptyState">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="24" />
  </Style>
  <Style Selector="StackPanel.empty-state-content">
    <Setter Property="Spacing" Value="12" />
    <Setter Property="MaxWidth" Value="360" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ui|AppIcon.empty-state-icon">
    <Setter Property="Size" Value="24" />
    <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector=".app-empty-state.compact" x:SetterTargetType="ui:AppEmptyState">
    <Setter Property="Margin" Value="8" />
  </Style>
  <Style Selector=".app-empty-state.compact StackPanel.empty-state-content">
    <Setter Property="Spacing" Value="6" />
  </Style>
  <Style Selector=".app-empty-state.compact ui|AppIcon.empty-state-icon">
    <Setter Property="Size" Value="20" />
  </Style>
  <Style Selector=".app-empty-state ui|AppText.empty-state-title, .app-empty-state ui|AppText.empty-state-description">
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <Style Selector=".app-empty-state.settings-empty" x:SetterTargetType="ui:AppEmptyState">
    <Setter Property="Margin" Value="16" />
  </Style>
  <Style Selector=".app-empty-state.settings-empty StackPanel.empty-state-content">
    <Setter Property="Spacing" Value="8" />
    <Setter Property="MaxWidth" Value="Infinity" />
  </Style>
  <Style Selector=".app-empty-state.settings-empty ui|AppIcon.empty-state-icon">
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector=".app-empty-state.settings-empty ui|AppText.empty-state-title, .app-empty-state.settings-empty ui|AppText.empty-state-description">
    <Setter Property="TextAlignment" Value="Left" />
  </Style>
</Styles>
