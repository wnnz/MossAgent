<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MossAgent.App.Views.WorkspaceSidebar"
             x:CompileBindings="False">
  <Border Background="{DynamicResource SidebarBackgroundBrush}"
          BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0"
          Padding="12,10">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
      <!-- 1. 顶栏：工作区下拉切换与单色小图标 (放大舒适尺寸) -->
      <Grid Grid.Row="0" ColumnDefinitions="*,30,30" Margin="4,2,2,14">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="会话" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
          <TextBlock Text="▾" Classes="subtle" FontSize="10" VerticalAlignment="Center" />
        </StackPanel>
        <!-- 搜索与提醒按钮：放大至 28x28 / 14px -->
        <Button Grid.Column="1" Content="⚲" Classes="ghost" Padding="0" Width="28" Height="28"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                FontSize="14" ToolTip.Tip="搜索会话" />
        <Button Grid.Column="2" Content="⍾" Classes="ghost" Padding="0" Width="28" Height="28"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                FontSize="14" ToolTip.Tip="通知与状态" />
      </Grid>

      <!-- 2. 快捷导航项：图标槽位 28px、字号 15px，文字绝对 100% 垂直对齐！ -->
      <StackPanel Grid.Row="1" Spacing="3" Margin="0,0,0,16">
        <!-- 新对话 -->
        <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="8,7" CornerRadius="6"
                Command="{Binding NewTaskCommand}">
          <Grid ColumnDefinitions="28,*">
            <TextBlock Text="✎" FontSize="15" Classes="muted"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="新对话" FontSize="13.5" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="6,0,0,0" />
          </Grid>
        </Button>

        <!-- Pull Request -->
        <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="8,7" CornerRadius="6">
          <Grid ColumnDefinitions="28,*">
            <TextBlock Text="⑂" FontSize="15" Classes="muted"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Pull Request" FontSize="13.5" Classes="muted"
                       VerticalAlignment="Center" Margin="6,0,0,0" />
          </Grid>
        </Button>

        <!-- 定时任务 -->
        <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="8,7" CornerRadius="6">
          <Grid ColumnDefinitions="28,*">
            <TextBlock Text="⏱" FontSize="15" Classes="muted"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="定时任务" FontSize="13.5" Classes="muted"
                       VerticalAlignment="Center" Margin="6,0,0,0" />
          </Grid>
        </Button>

        <!-- 插件 -->
        <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="8,7" CornerRadius="6">
          <Grid ColumnDefinitions="28,*">
            <TextBlock Text="⬡" FontSize="15" Classes="muted"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="插件" FontSize="13.5" Classes="muted"
                       VerticalAlignment="Center" Margin="6,0,0,0" />
          </Grid>
        </Button>
      </StackPanel>

      <!-- 3. 项目分组标题与添加按钮 (像素级水平对齐) -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="6,0,4,8">
        <TextBlock Text="项目" Classes="muted" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="＋" Classes="ghost" Padding="0" Width="24" Height="24"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                FontSize="14" ToolTip.Tip="添加新项目仓库" VerticalAlignment="Center">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <Border Background="{DynamicResource CardBackgroundBrush}"
                      BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                      CornerRadius="8" Padding="12" Width="260">
                <StackPanel Spacing="6">
                  <TextBlock Text="添加项目到工作区" FontWeight="SemiBold" FontSize="12" />
                  <TextBox Text="{Binding NewProjectName}" PlaceholderText="项目名称" FontSize="12" Padding="6,4" />
                  <TextBox Text="{Binding NewProjectDirectory}" PlaceholderText="项目本地绝对路径" FontSize="12" Padding="6,4" />
                  <TextBox Text="{Binding AuthorizedDirectoriesText}" PlaceholderText="其他授权目录(分号分隔)" FontSize="11" AcceptsReturn="True" MinHeight="32" Padding="6,4" />
                  <Button Content="确认添加项目" Classes="primary" Command="{Binding AddProjectCommand}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12" Padding="0,5" />
                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>

      <!-- 4. 项目与会话任务树状列表 -->
      <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="3">
          <!-- 项目列表 -->
          <ItemsControl ItemsSource="{Binding Projects}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,1">
                  <!-- 项目标题行 -->
                  <Button Classes="ghost" HorizontalAlignment="Stretch" Padding="6,6" CornerRadius="6"
                          Command="{Binding $parent[UserControl].DataContext.SelectProjectCommand}"
                          CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="22,*">
                      <TextBlock Text="📁" FontSize="13" Classes="muted"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </Grid>
                  </Button>

                  <!-- 缩进展示该项目下的会话历史列表 (对标截图 1/3) -->
                  <ItemsControl ItemsSource="{Binding $parent[UserControl].DataContext.Tasks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Classes="ghost" HorizontalAlignment="Stretch"
                                Padding="8,6,6,6" Margin="22,1,0,1" CornerRadius="6"
                                Command="{Binding $parent[UserControl].DataContext.SelectTaskCommand}"
                                CommandParameter="{Binding}">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="{DynamicResource CardSubtleBackgroundBrush}"
                                    CornerRadius="3" Padding="4,1" Margin="4,0,0,0">
                              <TextBlock Text="Ctrl+1" Classes="subtle" FontSize="9" />
                            </Border>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- 5. 底部固定栏：工作区与系统设置入口 -->
      <Border Grid.Row="4" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
              Padding="4,10,4,2" Margin="0,6,0,0">
        <Grid ColumnDefinitions="*,Auto">
          <Button Classes="ghost" Padding="6,6"
                  Command="{Binding $parent[Window].DataContext.OpenSettingsCommand}"
                  HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="⚙" FontSize="15" Classes="muted" VerticalAlignment="Center" />
              <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Grid.Column="1" Content="?" Classes="ghost" Padding="0" Width="26" Height="26"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  FontSize="13" ToolTip.Tip="帮助与文档" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
