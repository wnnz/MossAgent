<ui:AppUserControl xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:MossAgent.App.Controls"
                   x:Class="MossAgent.App.Controls.AppImagePreview" x:Name="Root" x:CompileBindings="False">
  <ui:AppScrollViewer x:Name="Scroller" Classes="file-image-scroll">
    <ui:AppBorder x:Name="ImageFrame" Classes="file-image-frame">
      <ui:AppImage x:Name="ImageSurface" Source="{Binding Source, ElementName=Root}" Classes="file-preview-image" />
    </ui:AppBorder>
  </ui:AppScrollViewer>
</ui:AppUserControl>
