<ui:AppUserControl xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:MossAgent.App.Controls"
                   x:Class="MossAgent.App.Views.SkillPickerFlyoutView"
                   x:CompileBindings="False">
  <ui:AppCard Classes="flyout-surface card-inset-menu">
    <StackPanel Width="248" Spacing="2">
      <ui:AppText Classes="type-11" Classes.status-error="{Binding StatusIsError}"
                  Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                  MaxWidth="236" Margin="6,2" TextWrapping="Wrap" />
      <ui:AppText Classes="muted type-12" Text="{Binding EmptyHint}" Margin="8,10"
                  IsVisible="{Binding ShowEmptyHint}" TextWrapping="Wrap" />
      <ui:AppScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding HasSkills}">
        <ui:AppItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,4">
                <ui:AppText Classes="subtle type-11" Text="{Binding Header}" Margin="6,4"
                            TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Header}" />
                <ui:AppItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,1">
                        <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                          <ui:AppText Text="{Binding Name}" Classes="type-12"
                                      TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                          <ui:AppText Text="{Binding RelativePath}" Classes="subtle type-11"
                                      TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RelativePath}" />
                        </StackPanel>
                        <ui:AppToggleButton Grid.Column="1" VerticalAlignment="Center"
                                            IsChecked="{Binding IsEnabled}" Content="{Binding StateText}"
                                            AutomationProperties.Name="{Binding RelativePath}"
                                            Command="{Binding $parent[UserControl].DataContext.ToggleSkillCommand}"
                                            CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ui:AppItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ui:AppItemsControl>
      </ui:AppScrollViewer>
      <ui:AppButton Classes="ghost menu-option" HorizontalAlignment="Left"
                    Content="{Binding ResetLabel}" Command="{Binding ResetCommand}"
                    IsVisible="{Binding HasSkills}" Margin="2,0,0,2" />
    </StackPanel>
  </ui:AppCard>
</ui:AppUserControl>
