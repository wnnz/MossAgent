<ui:AppUserControl xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:MossAgent.App.Controls"
                   x:Class="MossAgent.App.Controls.AppToolActivityRow"
                   x:Name="Root" x:CompileBindings="False">
  <ui:AppUserControl.Resources>
    <DataTemplate x:Key="ToolActivityHeader">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7"
            DataContext="{Binding $parent[ui:AppToolActivityRow]}">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Panel Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding CanExpand}">
            <ui:AppIcon Classes="ui-icon icon-small tool-expander" Data="{DynamicResource UiIconChevronDown}"
                        IsVisible="{Binding IsExpanded}" />
            <ui:AppIcon Classes="ui-icon icon-small tool-expander" Data="{DynamicResource UiIconChevronRight}"
                        IsVisible="{Binding !IsExpanded}" />
          </Panel>
          <Panel Width="14" Height="14" VerticalAlignment="Center">
            <ui:AppIcon Classes="ui-icon icon-small" Data="{DynamicResource UiIconTerminalActivity}"
                        IsVisible="{Binding !IsSubagent}" />
            <ui:AppIcon Classes="ui-icon icon-small" Data="{DynamicResource UiIconAssistant}"
                        IsVisible="{Binding IsSubagent}" />
          </Panel>
        </StackPanel>
        <ui:AppText Grid.Column="1" Text="{Binding Summary}" Classes="muted type-13"
                    TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <ui:AppText Grid.Column="2" Text="{Binding Status}" Classes="subtle type-10"
                    VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
  </ui:AppUserControl.Resources>
  <Grid DataContext="{Binding #Root}">
    <ui:AppButton x:Name="ToolButton" Classes="ghost tool-row align-stretch"
                  HorizontalAlignment="Stretch" Command="{Binding Command}"
                  IsVisible="{Binding CanExpand}" AutomationProperties.Name="{Binding Summary}"
                  AutomationProperties.HelpText="{Binding Status}" ToolTip.Tip="{Binding Description}">
      <ui:AppContentControl Content="{Binding Summary}" ContentTemplate="{StaticResource ToolActivityHeader}" />
    </ui:AppButton>
    <ui:AppBorder x:Name="ToolStaticSurface" Classes="tool-activity-static"
                  IsVisible="{Binding !CanExpand}" ToolTip.Tip="{Binding Description}">
      <ui:AppContentControl Content="{Binding Summary}" ContentTemplate="{StaticResource ToolActivityHeader}" />
    </ui:AppBorder>
  </Grid>
</ui:AppUserControl>
