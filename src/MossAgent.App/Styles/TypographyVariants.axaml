<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MossAgent.App.Controls">
  <Style Selector=":is(controls|AppSelectableText)">
    <Setter Property="Theme" Value="{StaticResource {x:Type SelectableTextBlock}}" />
  </Style>
  <Style Selector="controls|AppText.code-font">
    <Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}" />
  </Style>
  <Style Selector="controls|AppSelectableText.code-font">
    <Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}" />
  </Style>
  <Style Selector="controls|AppSelectableText.content-font">
    <Setter Property="FontFamily" Value="{DynamicResource ContentFontFamily}" />
  </Style>
  <Style Selector="controls|MarkdownSelectableTextBlock.content-font">
    <Setter Property="FontFamily" Value="{DynamicResource ContentFontFamily}" />
  </Style>
  <Style Selector="controls|SyntaxHighlightedSelectableTextBlock.code-font">
    <Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}" />
  </Style>
  <Style Selector="controls|MarkdownSelectableTextBlock.code-font">
    <Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}" />
  </Style>
  <Style Selector="controls|MarkdownSelectableTextBlock">
    <Setter Property="CodeFontFamily" Value="{DynamicResource CodeFontFamily}" />
  </Style>
  <Style Selector="controls|AppText.settings-title">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="controls|AppText.status-warning">
    <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
  </Style>
  <Style Selector="controls|AppIcon.status-warning">
    <Setter Property="Stroke" Value="{DynamicResource StatusWarningBrush}" />
  </Style>
  <Style Selector="controls|AppText.status-error">
    <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
  </Style>
  <Style Selector="controls|AppIcon.status-error">
    <Setter Property="Stroke" Value="{DynamicResource StatusErrorBrush}" />
  </Style>
  <Style Selector="controls|AppText.status-success">
    <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}" />
  </Style>
  <Style Selector="controls|AppIcon.status-success">
    <Setter Property="Stroke" Value="{DynamicResource StatusSuccessBrush}" />
  </Style>
  <Style Selector="controls|AppText.approval-label">
    <Setter Property="Foreground" Value="{DynamicResource ApprovalTextBrush}" />
  </Style>
  <Style Selector="controls|AppIcon.subtle">
    <Setter Property="Stroke" Value="{DynamicResource TextSubtleBrush}" />
  </Style>
  <Style Selector="controls|AppText.settings-description">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="controls|AppText.settings-section-title">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="controls|AppText.settings-theme-heading">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
  </Style>
  <Style Selector="controls|AppText.sidebar-brand">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
  </Style>
  <Style Selector="controls|AppText.sidebar-action">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
  </Style>
  <Style Selector="controls|AppText.sidebar-row">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
  </Style>
  <Style Selector="controls|AppText.sidebar-section-heading">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource SidebarSectionTextBrush}" />
  </Style>
  <Style Selector="controls|AppText.type-9-5">
    <Setter Property="FontSize" Value="9.5" />
  </Style>
  <Style Selector="controls|AppText.type-10">
    <Setter Property="FontSize" Value="10" />
  </Style>
  <Style Selector="controls|AppText.type-10-5">
    <Setter Property="FontSize" Value="10.5" />
  </Style>
  <Style Selector="controls|AppText.type-11">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="controls|AppText.type-11-5">
    <Setter Property="FontSize" Value="11.5" />
  </Style>
  <Style Selector="controls|AppText.type-12">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="controls|AppText.type-12-5">
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="controls|AppText.type-13">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="controls|AppText.type-14">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="controls|AppText.type-15">
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="controls|AppText.type-16">
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style Selector="controls|AppText.type-17">
    <Setter Property="FontSize" Value="17" />
  </Style>
  <Style Selector="controls|AppText.type-20">
    <Setter Property="FontSize" Value="20" />
  </Style>
  <Style Selector="controls|AppText.line-18">
    <Setter Property="LineHeight" Value="18" />
  </Style>
  <Style Selector="controls|AppText.type-18">
    <Setter Property="FontSize" Value="18" />
  </Style>
  <Style Selector="controls|AppText.type-27-5">
    <Setter Property="FontSize" Value="27.5" />
  </Style>
  <Style Selector="controls|AppText.weight-normal">
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="controls|AppText.weight-semibold">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="controls|AppSelectableText.type-9-5">
    <Setter Property="FontSize" Value="9.5" />
  </Style>
  <Style Selector="controls|AppSelectableText.type-10">
    <Setter Property="FontSize" Value="10" />
  </Style>
  <Style Selector="controls|AppSelectableText.type-10-5">
    <Setter Property="FontSize" Value="10.5" />
  </Style>
  <Style Selector="controls|AppSelectableText.type-11">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="controls|AppSelectableText.type-11-5">
    <Setter Property="FontSize" Value="11.5" />
  </Style>
  <Style Selector="controls|AppSelectableText.type-12">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="controls|AppSelectableText.type-12-5">
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="controls|AppSelectableText.type-13">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="controls|AppSelectableText.type-14">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="controls|AppSelectableText.type-15">
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="controls|AppSelectableText.type-16">
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style Selector="controls|AppSelectableText.type-17">
    <Setter Property="FontSize" Value="17" />
  </Style>
  <Style Selector="controls|AppSelectableText.type-18">
    <Setter Property="FontSize" Value="18" />
  </Style>
  <Style Selector="controls|AppSelectableText.type-27-5">
    <Setter Property="FontSize" Value="27.5" />
  </Style>
  <Style Selector="controls|AppSelectableText.weight-normal">
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="controls|AppSelectableText.weight-semibold">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="controls|AppSelectableText.line-18">
    <Setter Property="LineHeight" Value="18" />
  </Style>
  <Style Selector="controls|AppSelectableText.line-24">
    <Setter Property="LineHeight" Value="24" />
  </Style>
  <Style Selector="controls|SyntaxHighlightedSelectableTextBlock.type-12">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="controls|SyntaxHighlightedSelectableTextBlock.line-18">
    <Setter Property="LineHeight" Value="18" />
  </Style>
  <Style Selector="controls|MarkdownSelectableTextBlock.type-12">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="controls|MarkdownSelectableTextBlock.type-12-5">
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="controls|MarkdownSelectableTextBlock.type-13">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="controls|MarkdownSelectableTextBlock.type-15">
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="controls|MarkdownSelectableTextBlock.type-16">
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style Selector="controls|MarkdownSelectableTextBlock.weight-semibold">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="controls|MarkdownSelectableTextBlock.line-19">
    <Setter Property="LineHeight" Value="19" />
  </Style>
  <Style Selector="controls|MarkdownSelectableTextBlock.line-24">
    <Setter Property="LineHeight" Value="24" />
  </Style>
</Styles>
