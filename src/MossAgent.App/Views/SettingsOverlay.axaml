<ui:AppUserControl xmlns="https://github.com/avaloniaui" xmlns:res="clr-namespace:MossAgent.App.Resources"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MossAgent.App.Controls"
             xmlns:views="clr-namespace:MossAgent.App.Views"
             xmlns:labels="clr-namespace:MossAgent.App.Resources"
             x:Class="MossAgent.App.Views.SettingsOverlay"
             x:Name="Root" Classes="settings-shell"
             x:CompileBindings="False">
  <ui:AppBorder Classes="settings-shell-surface">
  <Grid ColumnDefinitions="Auto,*">
    <ui:AppNavigationRail Grid.Column="0" IsSettingsSelected="True"
                          NewConversationCommand="{Binding CloseSettingsCommand}"
                          AutomationsCommand="{Binding OpenAutomationsCommand}"
                          IsAutomationsSelected="{Binding Pages.IsAutomationsOpen}"
                          InspectorCommand="{Binding SelectInspectorTabCommand}"
                          ToggleInspectorCommand="{Binding ToggleRightPanelCommand}"
                          SettingsCommand="{Binding CloseSettingsCommand}">
      <ui:AppNavigationRail.HelpContent>
        <views:KeyboardShortcutsFlyoutView />
      </ui:AppNavigationRail.HelpContent>
    </ui:AppNavigationRail>
    <ui:AppBorder Grid.Column="1" Classes="window-content-frame">
    <ui:AppBorder Classes="window-content-clip">
    <ui:AppNavigationPanes x:Name="SettingsNavigation">
    <ui:AppNavigationPanes.NavigationPane>
    <ui:AppBorder Classes="settings-sidebar-surface">
      <Grid RowDefinitions="Auto,Auto,*">
        <ui:AppText Classes="settings-sidebar-title" Text="{Binding #Root.SidebarTitle}" />

        <Grid Grid.Row="1" Classes="settings-search-row">
          <ui:AppInput Classes="settings-search"
                       AutomationProperties.Name="{res:L '搜索设置'}"
                       Text="{Binding SettingsSearchQuery, Mode=TwoWay}"
                       PlaceholderText="{res:L '搜索'}" />
          <ui:AppIcon Classes="ui-icon icon-small" Data="{StaticResource UiIconSearch}"
                      Margin="14,0,0,0" HorizontalAlignment="Left"
                      IsHitTestVisible="False" />
        </Grid>

        <ui:AppScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="1">
            <ui:AppText Text="{res:L '个人'}" Classes="subtle settings-navigation-heading first"
                        IsVisible="{Binding IsPersonalSettingsMatch}" />
            <ui:AppSettingsNavButton
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding IsAppearanceSettingsMatch}"
                          IsChecked="{Binding IsAppearanceSettingsSelected, Mode=OneWay}"
                          Command="{Binding SelectSettingsTabCommand}" CommandParameter="5"
                          Label="{res:L '外观'}" IconData="{StaticResource UiIconAppearance}" />
            <ui:AppSettingsNavButton
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding IsProviderSettingsMatch}"
                          IsChecked="{Binding IsProviderSettingsSelected, Mode=OneWay}"
                          Command="{Binding SelectSettingsTabCommand}" CommandParameter="0"
                          Label="{res:L 'AI 提供商'}" IconData="{StaticResource UiIconProvider}" />
            <ui:AppSettingsNavButton
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding IsProxySettingsMatch}"
                          IsChecked="{Binding IsProxySettingsSelected, Mode=OneWay}"
                          Command="{Binding SelectSettingsTabCommand}" CommandParameter="1"
                          Label="{res:L '网络代理'}" IconData="{StaticResource UiIconProxy}" />
            <ui:AppSettingsNavButton
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding IsComposerSettingsMatch}"
                          IsChecked="{Binding IsComposerSettingsSelected, Mode=OneWay}"
                          Command="{Binding SelectSettingsTabCommand}" CommandParameter="8"
                          Label="{x:Static labels:ComposerPreferenceText.Title}" IconData="{StaticResource UiIconSend}" />

            <ui:AppText Text="{res:L '集成'}" Classes="subtle settings-navigation-heading"
                        IsVisible="{Binding IsIntegrationSettingsMatch}" />
            <ui:AppSettingsNavButton HorizontalAlignment="Stretch"
                          IsVisible="{Binding IsSourceAccountSettingsMatch}"
                          IsChecked="{Binding IsSourceAccountSettingsSelected, Mode=OneWay}"
                          Command="{Binding SelectSettingsTabCommand}" CommandParameter="7"
                          Label="{x:Static labels:SourceAccountText.Title}" IconData="{StaticResource UiIconSources}" />
            <ui:AppSettingsNavButton
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding IsMcpSettingsMatch}"
                          IsChecked="{Binding IsMcpSettingsSelected, Mode=OneWay}"
                          Command="{Binding SelectSettingsTabCommand}" CommandParameter="3"
                          Label="{res:L '插件'}" IconData="{StaticResource UiIconPlug}" />
            <ui:AppSettingsNavButton
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding IsPluginPackageSettingsMatch}"
                          IsChecked="{Binding IsPluginPackageSettingsSelected, Mode=OneWay}"
                          Command="{Binding SelectSettingsTabCommand}" CommandParameter="9"
                          Label="{res:L '本地插件'}" IconData="{StaticResource UiIconArchive}" />
            <ui:AppSettingsNavButton
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding IsBrowserSettingsMatch}"
                          IsChecked="{Binding IsBrowserSettingsSelected, Mode=OneWay}"
                          Command="{Binding SelectSettingsTabCommand}" CommandParameter="2"
                          Label="{res:L '浏览器'}" IconData="{StaticResource UiIconBrowser}" />

            <ui:AppText Text="{res:L '代理'}" Classes="subtle settings-navigation-heading"
                        IsVisible="{Binding IsAgentSectionSettingsMatch}" />
            <ui:AppSettingsNavButton
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding IsAgentSettingsMatch}"
                          IsChecked="{Binding IsAgentSettingsSelected, Mode=OneWay}"
                          Command="{Binding SelectSettingsTabCommand}" CommandParameter="6"
                          Label="{res:L '自定义代理'}" IconData="{StaticResource UiIconAssistant}" />
            <ui:AppSettingsNavButton
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding IsSubagentSettingsMatch}"
                          IsChecked="{Binding IsSubagentSettingsSelected, Mode=OneWay}"
                          Command="{Binding SelectSettingsTabCommand}" CommandParameter="4"
                          Label="{res:L '子代理'}" IconData="{StaticResource UiIconAssistant}" />
            <ui:AppText Text="{res:L '没有匹配的设置'}" Classes="muted type-12"
                       Margin="8,12" IsVisible="{Binding !HasSettingsSearchResults}" />
          </StackPanel>
        </ui:AppScrollViewer>
      </Grid>
    </ui:AppBorder>
    </ui:AppNavigationPanes.NavigationPane>

    <ui:AppNavigationPanes.PrimaryPane>
    <ui:AppBorder Classes="page-surface settings-page-surface">
        <Grid>
          <Grid Classes="settings-content-column">
            <ui:AppBorder IsVisible="{Binding IsAppearanceSettingsSelected}">
              <views:AppearanceSettingsPane DataContext="{Binding}" />
            </ui:AppBorder>
            <ui:AppBorder IsVisible="{Binding IsComposerSettingsSelected}">
              <views:ComposerSettingsPane DataContext="{Binding Workspace.ComposerPreferences}" />
            </ui:AppBorder>
            <ui:AppBorder IsVisible="{Binding IsBrowserSettingsSelected}">
              <views:BrowserSettingsPane DataContext="{Binding Browser}" />
            </ui:AppBorder>
          </Grid>
          <ui:AppBorder IsVisible="{Binding IsSubagentSettingsSelected}">
            <views:SubagentSettingsPane DataContext="{Binding Subagents}" />
          </ui:AppBorder>
          <ui:AppBorder IsVisible="{Binding IsAgentSettingsSelected}">
            <views:AgentSettingsPane DataContext="{Binding Agents}" />
          </ui:AppBorder>
          <views:ProviderAndModelSettingsPane IsVisible="{Binding IsProviderSettingsSelected}"
                                              DataContext="{Binding}" />
          <ui:AppBorder IsVisible="{Binding IsProxySettingsSelected}">
            <views:ProxySettingsPane DataContext="{Binding Proxies}" />
          </ui:AppBorder>
          <ui:AppBorder IsVisible="{Binding IsMcpSettingsSelected}">
            <views:McpSettingsPane DataContext="{Binding Mcp}" />
          </ui:AppBorder>
          <ui:AppBorder IsVisible="{Binding IsPluginPackageSettingsSelected}">
            <views:PluginPackagesPane DataContext="{Binding Plugins}" />
          </ui:AppBorder>
          <ui:AppBorder IsVisible="{Binding IsSourceAccountSettingsSelected}">
            <views:SourceAccountSettingsPane DataContext="{Binding SourceAccounts}" />
          </ui:AppBorder>
        </Grid>
    </ui:AppBorder>
    </ui:AppNavigationPanes.PrimaryPane>
    </ui:AppNavigationPanes>
    </ui:AppBorder>
    </ui:AppBorder>
  </Grid>
  </ui:AppBorder>
</ui:AppUserControl>
