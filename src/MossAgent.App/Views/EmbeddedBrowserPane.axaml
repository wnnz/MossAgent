<ui:AppUserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MossAgent.App.Controls"
             xmlns:resources="clr-namespace:MossAgent.App.Resources"
             x:Class="MossAgent.App.Views.EmbeddedBrowserPane"
             x:CompileBindings="False">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="6">
    <ui:AppBrowserToolbar Address="{Binding Address}" NavigateCommand="{Binding NavigateCommand}"
                          BackCommand="{Binding BackCommand}" ForwardCommand="{Binding ForwardCommand}"
                          ReloadCommand="{Binding ReloadCommand}" DevToolsCommand="{Binding DevToolsCommand}" />
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
      <ui:AppText Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" Margin="2,6" />
      <ui:AppIconButton Grid.Column="1" Classes="icon-compact" Command="{Binding Actions.CancelCommand}"
                        IsVisible="{Binding Actions.IsBusy}" IconData="{StaticResource UiIconClose}"
                        Label="{x:Static resources:BrowserToolbarText.CancelActionLabel}" />
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,5">
      <ui:AppComboBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                      IsEnabled="{Binding Actions.CanExecute}"
                      Classes="compact-selector browser-tabs" DisplayMemberBinding="{Binding Title}" />
      <ui:AppIconButton Grid.Column="1" Classes="icon-compact" Command="{Binding NewTabCommand}" Margin="5,0,0,0"
                        Label="新建标签页" IconData="{StaticResource UiIconPlus}" />
      <ui:AppIconButton Grid.Column="2" Classes="icon-compact" Command="{Binding CloseTabCommand}" Margin="5,0,0,0"
                        Label="关闭当前标签页" IconData="{StaticResource UiIconClose}" />
    </Grid>
    <ui:AppBorder Grid.Row="3" Classes="embedded-browser-surface">
      <Grid>
        <ui:AppBrowserViewport Host="{Binding Host}" View="{Binding Content}" />
        <ui:AppEmptyState Title="{x:Static resources:InspectorText.NoBrowser}"
                          Description="{x:Static resources:InspectorText.NoBrowserHint}"
                          IconData="{StaticResource UiIconBrowser}" IsVisible="{Binding !HasBrowser}" />
      </Grid>
    </ui:AppBorder>
  </Grid>
</ui:AppUserControl>
