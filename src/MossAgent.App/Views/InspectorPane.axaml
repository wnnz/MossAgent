<ui:AppUserControl xmlns="https://github.com/avaloniaui" xmlns:res="clr-namespace:MossAgent.App.Resources"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MossAgent.App.Controls"
             xmlns:views="clr-namespace:MossAgent.App.Views"
             xmlns:text="clr-namespace:MossAgent.App.Resources"
             x:Class="MossAgent.App.Views.InspectorPane"
             x:CompileBindings="False">
  <Grid>
    <Grid IsVisible="{Binding Workspace.Catalog.SelectedTask, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ui:AppCard Classes="inspector-surface card-inset-inspector" IsVisible="{Binding IsContextCardVisible}"
              SizeChanged="HandleContextCardSizeChanged"
              Margin="0"
              VerticalAlignment="Top">
        <StackPanel Classes="inspector-overview-layout">
        <StackPanel Classes="inspector-overview-heading">
        <Grid ColumnDefinitions="*,Auto">
          <ui:AppText Text="{Binding Workspace.Catalog.SelectedProject.Name}"
                     Classes="muted type-13" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
          <ui:AppIconButton Grid.Column="1" Classes="icon-compact"
                            Label="{res:L '项目操作'}" IconData="{StaticResource UiIconMore}">
            <Button.Flyout>
              <ui:AppFlyout Placement="BottomEdgeAlignedRight" DismissOnButtonClick="True">
                <ui:AppCard Classes="flyout-surface card-inset-tight">
                  <StackPanel Width="190">
<ui:AppButton Content="{res:L '文件变更审查'}" Classes="ghost align-leading"
                            HorizontalAlignment="Stretch"
                            Command="{Binding SelectInspectorTabCommand}" CommandParameter="diff" />
<ui:AppButton Content="{res:L '终端'}" Classes="ghost align-leading"
                            HorizontalAlignment="Stretch"
                            Command="{Binding SelectInspectorTabCommand}" CommandParameter="terminal" />
<ui:AppButton Content="{res:L '浏览器'}" Classes="ghost align-leading"
                            HorizontalAlignment="Stretch"
                            Command="{Binding SelectInspectorTabCommand}" CommandParameter="browser" />
<ui:AppButton Content="{res:L '设置'}" Classes="ghost align-leading"
                            HorizontalAlignment="Stretch"
                            Command="{Binding OpenSettingsCommand}" />
                  </StackPanel>
                </ui:AppCard>
              </ui:AppFlyout>
            </Button.Flyout>
          </ui:AppIconButton>
        </Grid>

        <ui:AppBorder Padding="0,5">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <ui:AppIcon Classes="ui-icon" Data="{StaticResource UiIconBranch}" />
            <ui:AppText Classes="type-12" Grid.Column="1" Text="{Binding Workspace.RepositoryStatus.BranchLabel}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </Grid>
        </ui:AppBorder>
        </StackPanel>

        <Grid Classes="inspector-overview-sources" ColumnDefinitions="*,Auto">
          <ui:AppText Text="{res:L '来源'}" Classes="muted type-12"
                     VerticalAlignment="Center" />
          <ui:AppIconButton Grid.Column="1" Classes="icon-compact"
                  Command="{Binding Workspace.Attachments.AddFilesCommand}"
                  CommandParameter="{Binding Workspace.Catalog.SelectedProject}"
                  Label="{res:L '附加授权目录中的文本文件'}" IconData="{StaticResource UiIconPlus}" />
        </Grid>
        <StackPanel Classes="inspector-overview-source-list">
        <ui:AppBorder Padding="0,3" IsVisible="{Binding !Workspace.Attachments.HasItems}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <ui:AppIcon Classes="ui-icon" Data="{StaticResource UiIconFolder}" />
            <ui:AppText Grid.Column="1"
                       Text="{Binding Workspace.Catalog.SelectedProject.PrimaryDirectory}"
                       Classes="muted type-11-5" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Workspace.Catalog.SelectedProject.PrimaryDirectory}"
                       VerticalAlignment="Center" />
          </Grid>
        </ui:AppBorder>
        <ui:AppItemsControl ItemsSource="{Binding Workspace.Attachments.Items}"
                      IsVisible="{Binding Workspace.Attachments.HasItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ui:AppBorder Padding="0,4" Margin="0,0,0,2">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                  <ui:AppIcon Classes="ui-icon" Data="{StaticResource UiIconDocument}" />
                  <ui:AppText Grid.Column="1" Text="{Binding DisplayPath}" Classes="muted type-12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <ui:AppIconButton Grid.Column="2" Classes="icon-micro"
                                    Command="{Binding RemoveCommand}" Label="{res:L '移除来源'}"
                                    IconData="{StaticResource UiIconClose}" />
                </Grid>
              </ui:AppBorder>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ui:AppItemsControl>
<ui:AppActionButton Classes="ghost inspector-link align-leading"
                HorizontalAlignment="Left"
                Command="{Binding SelectInspectorTabCommand}" CommandParameter="sources"
                Label="{res:L '查看全部'}" IconData="{StaticResource UiIconSources}" />
        </StackPanel>
        </StackPanel>
      </ui:AppCard>
    </Grid>

  <ui:AppBorder IsVisible="{Binding IsRightPanelOpen}" Classes="inspector-side-surface">
    <Grid RowDefinitions="Auto,*">
      <ui:AppInspectorHeader Title="{Binding InspectorTitle}" ActiveTab="{Binding ActiveInspectorTab}"
                              IsVisible="{Binding !Workspace.FilePreview.IsOpen}"
                              SelectCommand="{Binding SelectInspectorTabCommand}" BackCommand="{Binding BackToInspectorHomeCommand}"
                              ExpansionCommand="{Binding $parent[ui:AppWorkspacePanes].ToggleInspectorExpandedCommand}"
                              IsExpanded="{Binding $parent[ui:AppWorkspacePanes].IsInspectorFullWidth}"
                              CloseCommand="{Binding ToggleRightPanelCommand}" CloseLabel="{Binding RightPanelToggleLabel}" />
      <ui:AppFilePreview Grid.RowSpan="2" DataContext="{Binding Workspace.FilePreview}" IsVisible="{Binding IsOpen}"
                         ExpansionCommand="{Binding $parent[ui:AppWorkspacePanes].ToggleInspectorExpandedCommand}"
                         IsExpanded="{Binding $parent[ui:AppWorkspacePanes].IsInspectorFullWidth}"
                         IsExpansionRequested="{Binding $parent[ui:AppWorkspacePanes].IsInspectorExpanded}"
                         ClosePaneCommand="{Binding $parent[views:InspectorPane].DataContext.ToggleRightPanelCommand}" />
      <ui:AppEmptyState Grid.Row="1" Title="{x:Static text:InspectorText.SelectTask}" Description="{x:Static text:InspectorText.SelectTaskHint}"
                        IconData="{StaticResource UiIconDocument}"
                        IsVisible="{Binding Workspace.Catalog.SelectedTask, Converter={x:Static ObjectConverters.IsNull}}" />
      <Grid Grid.Row="1" IsVisible="{Binding !Workspace.FilePreview.IsOpen}">
      <Grid IsVisible="{Binding Workspace.Catalog.SelectedTask, Converter={x:Static ObjectConverters.IsNotNull}}">

      <!-- 3. 审查 (Diff) 详情全高度视图 -->
      <Grid RowDefinitions="Auto,150,Auto,Auto,Auto,*" Classes="inspector-content" IsVisible="{Binding IsInspectorDiff}">
        <Grid ColumnDefinitions="*,Auto,Auto" Margin="2,0,2,8">
          <StackPanel VerticalAlignment="Center">
            <ui:AppText Classes="type-12 weight-semibold" Text="{x:Static text:InspectorText.DiffReviewTitle}" />
            <ui:AppText Text="{Binding Diff.Status}" Classes="subtle type-10" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <ui:AppToggleButton Grid.Column="1" Classes="diff-staged" Content="{x:Static text:InspectorText.DiffStaged}" IsChecked="{Binding Diff.IsStaged}"
                        VerticalAlignment="Center" Margin="0,0,6,0" />
          <ui:AppIconButton Grid.Column="2" Command="{Binding Diff.RefreshCommand}"
                            Label="{x:Static text:InspectorText.DiffRefresh}" VerticalAlignment="Center"
                            IconData="{StaticResource UiIconRefresh}" />
        </Grid>

        <ui:AppEmptyState Grid.Row="1" Title="{x:Static text:InspectorText.NoChanges}" Description="{Binding Diff.Status}"
                          IconData="{StaticResource UiIconDocument}" IsVisible="{Binding !Diff.HasFiles}" />
        <ui:AppBorder Grid.Row="1" Classes="inspector-list-surface" Padding="2" IsVisible="{Binding Diff.HasFiles}">
          <ui:AppListBox ItemsSource="{Binding Diff.Files}" SelectedItem="{Binding Diff.SelectedFile}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*" Margin="4,2">
                  <ui:AppBorder Classes="inspector-chip" Padding="4,1" Margin="0,0,8,0"
                          VerticalAlignment="Center">
                    <ui:AppText Classes="type-10 weight-semibold muted" Text="{Binding StatusLabel}" />
                  </ui:AppBorder>
                  <ui:AppText Classes="type-12 code-font" Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ui:AppListBox>
        </ui:AppBorder>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="2,8,2,4">
          <ui:AppText Text="{x:Static text:InspectorText.DiffCompare}" Classes="muted type-11 weight-semibold" />
          <ui:AppText Grid.Column="1" Text="{Binding Diff.SelectedFile.Path}" Classes="subtle type-10 code-font" TextTrimming="CharacterEllipsis" MaxWidth="200" />
          <ui:AppIconButton Grid.Column="2" Classes="icon-compact" Label="{x:Static text:InspectorText.PreviewOpen}"
                            IconData="{StaticResource UiIconDocument}" Command="{Binding Workspace.FilePreview.OpenCommand}"
                            CommandParameter="{Binding Diff.SelectedFile.Path}" />
        </Grid>

        <views:GitIndexActionsView Grid.Row="3" DataContext="{Binding Diff.IndexActions}" />
        <StackPanel Grid.Row="4" Spacing="4">
          <views:GitCommitActionsView DataContext="{Binding Diff.Commit}" />
          <views:GitPushActionsView DataContext="{Binding Diff.Push}" />
        </StackPanel>
        <ui:AppEmptyState Grid.Row="5" Title="{Binding Diff.ContentStatus}" IsVisible="{Binding !Diff.HasContent}"
                          IconData="{StaticResource UiIconDocument}" />
        <ui:AppBorder Grid.Row="5" Classes="inspector-output-surface" Padding="6" IsVisible="{Binding Diff.HasContent}">
          <ui:AppCodePreview Code="{Binding Diff.Content}" FilePath="{Binding Diff.SelectedFile.Path}" IsDiff="True" />
        </ui:AppBorder>
      </Grid>

      <!-- 4. 终端详情视图 -->
      <ui:AppTerminalPane DataContext="{Binding Terminal}" IsVisible="{Binding $parent[views:InspectorPane].DataContext.IsInspectorTerminal}" />

      <!-- 5. 浏览器详情视图 -->
      <Grid Margin="4" RowDefinitions="Auto,*" IsVisible="{Binding IsInspectorBrowser}">
        <views:BrowserTakeoverPane DataContext="{Binding BrowserTakeover}"
                                   IsVisible="{Binding BrowserTakeover.HasControlState, FallbackValue=False}" />
        <Grid Grid.Row="1">
          <ui:AppEmptyState Title="{x:Static text:InspectorText.NoBrowser}" Description="{x:Static text:InspectorText.NoBrowserHint}"
                            IconData="{StaticResource UiIconBrowser}" IsVisible="{Binding !EmbeddedBrowsers.CurrentPane.HasBrowser, FallbackValue=True}" />
          <views:EmbeddedBrowserPane DataContext="{Binding EmbeddedBrowsers.CurrentPane}"
                                     IsVisible="{Binding HasBrowser, FallbackValue=False}" />
        </Grid>
      </Grid>

      <!-- 6. 审计与产物详情视图 -->
      <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,120" Classes="inspector-content" IsVisible="{Binding IsInspectorAudit}">
        <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,8">
          <ui:AppText Text="{Binding Audit.Status}" Classes="muted type-12" VerticalAlignment="Center" />
          <ui:AppIconButton Grid.Column="1" Command="{Binding Audit.RefreshCommand}"
                            Label="{res:L '刷新审计记录'}" IconData="{StaticResource UiIconRefresh}" />
        </Grid>

        <ui:AppEmptyState Grid.Row="1" Title="{x:Static text:InspectorText.NoAudit}" Description="{Binding Audit.Status}"
                          IconData="{StaticResource UiIconBell}" IsVisible="{Binding !Audit.HasExecutions}" />
        <ui:AppBorder Grid.Row="1" Classes="inspector-list-surface" Padding="4" IsVisible="{Binding Audit.HasExecutions}">
          <ui:AppListBox Classes="audit-history-list thin-scrollbar" ItemsSource="{Binding Audit.ExecutionItems}" SelectedItem="{Binding Audit.SelectedItem}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <ui:AppAuditExecutionRow ToolName="{Binding ToolName}" OutcomeKind="{Binding OutcomeKind}"
                                        OutcomeLabel="{Binding OutcomeLabel}" Detail="{Binding Detail}" Metadata="{Binding Metadata}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ui:AppListBox>
        </ui:AppBorder>

        <StackPanel Grid.Row="2" Spacing="4" Margin="2,8,2,4" IsVisible="{Binding Audit.HasRuns}">
          <ui:AppText Text="{Binding Audit.RunsTitle}" Classes="muted type-12 weight-semibold" />
          <ui:AppBorder Classes="inspector-list-surface" Padding="4">
            <ui:AppListBox Classes="audit-history-list thin-scrollbar" MaxHeight="120"
                           ItemsSource="{Binding Audit.SubagentRuns}" SelectedItem="{Binding Audit.SelectedSubagentRun}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <ui:AppAuditSubagentRunRow ProfileName="{Binding ProfileName}" OutcomeKind="{Binding OutcomeKind}"
                                            OutcomeLabel="{Binding OutcomeLabel}" Metadata="{Binding Metadata}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ui:AppListBox>
          </ui:AppBorder>
          <ui:AppText Text="{Binding Audit.SelectedSubagentRun.Detail}" Classes="type-11 subtle line-18" TextWrapping="Wrap"
                      IsVisible="{Binding Audit.SelectedSubagentRun, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="4" Margin="2,8,2,4" IsVisible="{Binding Audit.HasBrowserSessions}">
          <ui:AppText Text="{Binding Audit.BrowserSessionsTitle}" Classes="muted type-12 weight-semibold" />
          <ui:AppBorder Classes="inspector-list-surface" Padding="4">
            <ui:AppListBox Classes="audit-history-list thin-scrollbar" MaxHeight="160"
                           ItemsSource="{Binding Audit.BrowserSessions}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <ui:AppAuditBrowserSessionRow Title="{Binding Title}" OutcomeKind="{Binding OutcomeKind}"
                                               OutcomeLabel="{Binding OutcomeLabel}" Metadata="{Binding Metadata}"
                                               Detail="{Binding Detail}" Actions="{Binding Actions}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ui:AppListBox>
          </ui:AppBorder>
        </StackPanel>

        <StackPanel Grid.Row="4" Spacing="4" Margin="2,8,2,4">
          <ui:AppText Text="{res:L '生成产物'}" Classes="muted type-12 weight-semibold" />
          <ui:AppText Text="{Binding Audit.ArtifactsStatus}" IsVisible="{Binding Audit.HasArtifacts}" Classes="type-11 subtle line-18" TextWrapping="Wrap" />
        </StackPanel>
        <ui:AppEmptyState Grid.Row="5" Classes="compact" Title="{x:Static text:InspectorText.NoArtifacts}" Description="{Binding Audit.ArtifactsStatus}"
                          IconData="{StaticResource UiIconDocument}" IsVisible="{Binding !Audit.HasArtifacts}" />
        <ui:AppBorder Grid.Row="5" Classes="inspector-list-surface" Padding="4" IsVisible="{Binding Audit.HasArtifacts}">
          <ui:AppListBox ItemsSource="{Binding Audit.Artifacts}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4,2">
                  <ui:AppButton Classes="ghost align-leading" Content="{Binding Name}"
                                Command="{Binding $parent[views:InspectorPane].DataContext.Workspace.FilePreview.OpenArtifactCommand}"
                                CommandParameter="{Binding}" />
                  <ui:AppText Text="{Binding Path}"
                             Classes="subtle type-10 code-font" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ui:AppListBox>
        </ui:AppBorder>
      </Grid>
      <StackPanel Spacing="12" Margin="16,12"
                  IsVisible="{Binding IsInspectorSources}">
        <Grid ColumnDefinitions="*,Auto">
          <ui:AppText Classes="type-14 weight-semibold" Text="{res:L '来源'}" VerticalAlignment="Center" />
          <ui:AppIconButton Grid.Column="1"
                  Command="{Binding Workspace.Attachments.AddFilesCommand}"
                  CommandParameter="{Binding Workspace.Catalog.SelectedProject}"
                  Label="{res:L '添加来源'}" IconData="{StaticResource UiIconPlus}" />
        </Grid>
        <ui:AppText Text="{res:L '项目目录'}" Classes="subtle type-11" />
        <ui:AppText Classes="type-12" Text="{Binding Workspace.Catalog.SelectedProject.PrimaryDirectory}" TextWrapping="Wrap" />
        <ui:AppItemsControl ItemsSource="{Binding Workspace.Attachments.Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,5">
                <ui:AppIcon Classes="ui-icon" Data="{StaticResource UiIconDocument}" />
                <ui:AppButton Classes="ghost align-leading" Grid.Column="1" Content="{Binding DisplayPath}"
                              Command="{Binding $parent[views:InspectorPane].DataContext.Workspace.FilePreview.OpenCommand}" CommandParameter="{Binding FullPath}" />
                <ui:AppIconButton Grid.Column="2" Command="{Binding RemoveCommand}"
                                  Label="{res:L '移除来源'}" IconData="{StaticResource UiIconClose}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ui:AppItemsControl>
      </StackPanel>
      </Grid>
      </Grid>
    </Grid>
  </ui:AppBorder>
  <views:GitCommitDialog DataContext="{Binding Diff.Commit}"
                         IsVisible="{Binding $parent[views:InspectorPane].DataContext.IsRightPanelOpen}" />
  <views:GitPushDialog DataContext="{Binding Diff.Push}"
                       IsVisible="{Binding $parent[views:InspectorPane].DataContext.IsRightPanelOpen}" />
  </Grid>
</ui:AppUserControl>
