<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MossAgent.App.Controls">
  <Style Selector="controls|AppButton Grid.action-content">
    <Setter Property="UseLayoutRounding" Value="False" />
  </Style>
  <Style Selector="controls|AppText.action-badge">
    <Setter Property="FontSize" Value="10" />
  </Style>
  <Style Selector="controls|AppButton.model-option">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="controls|AppButton.model-option controls|AppIconLabel">
    <Setter Property="Spacing" Value="8" />
  </Style>
  <Style Selector="controls|AppButton.model-option controls|AppIcon">
    <Setter Property="Size" Value="12" />
  </Style>
  <Style Selector="controls|AppButton.model-option controls|AppIcon.action-trailing-icon">
    <Setter Property="Stroke" Value="{DynamicResource StatusSuccessBrush}" />
  </Style>
  <Style Selector="controls|AppButton.model-picker-nav">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="controls|AppButton.model-picker-nav controls|AppIcon.action-trailing-icon">
    <Setter Property="Size" Value="12" />
    <Setter Property="Margin" Value="4,0,0,0" />
  </Style>
  <Style Selector="controls|AppButton.composer-model-picker">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="controls|AppButton.composer-model-picker controls|AppText.action-badge">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Margin" Value="5,0,0,0" />
  </Style>
  <Style Selector="controls|AppButton.composer-model-picker controls|AppIcon.action-trailing-icon">
    <Setter Property="Size" Value="12" />
    <Setter Property="Margin" Value="5,0,0,0" />
    <Setter Property="Stroke" Value="{DynamicResource TextSubtleBrush}" />
  </Style>
  <Style Selector="controls|AppButton.sidebar-brand-trigger">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
  </Style>
  <Style Selector="controls|AppButton.sidebar-brand-trigger controls|AppIcon.action-trailing-icon">
    <Setter Property="Size" Value="6" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="Stroke" Value="{DynamicResource TextSubtleBrush}" />
    <Setter Property="RenderTransform"><TranslateTransform Y="2.5" /></Setter>
  </Style>
  <Style Selector="controls|AppButton.sidebar-project-row">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
  </Style>
  <Style Selector="controls|AppButton.sidebar-project-more">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="32,0,8,0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource SidebarSectionTextBrush}" />
  </Style>
  <Style Selector="controls|AppButton.sidebar-project-more:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
  </Style>
  <Style Selector="controls|AppButton.sidebar-project-row controls|AppIconLabel">
    <Setter Property="Spacing" Value="8" />
  </Style>
  <Style Selector=".app-project-navigation-row controls|AppButton.sidebar-project-row controls|AppIconLabel">
    <Setter Property="Spacing" Value="13" />
  </Style>
  <Style Selector=".app-project-navigation-row Grid.project-navigation-row.expanded controls|AppButton.sidebar-project-row controls|AppIconLabel">
    <Setter Property="Spacing" Value="11" />
  </Style>
  <Style Selector="controls|AppButton.project-picker-row controls|AppIconLabel">
    <Setter Property="Spacing" Value="7" />
  </Style>
  <Style Selector="controls|AppButton.project-picker-row controls|AppIcon.action-trailing-icon">
    <Setter Property="Size" Value="12" />
    <Setter Property="Margin" Value="7,0,0,0" />
  </Style>
  <Style Selector="controls|AppButton.composer-context-button">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="controls|AppButton.composer-context-button controls|AppIconLabel">
    <Setter Property="Spacing" Value="5" />
  </Style>
  <Style Selector="controls|AppButton.composer-context-button controls|AppIcon">
    <Setter Property="Size" Value="12" />
  </Style>
  <Style Selector="controls|AppButton.composer-project-button" x:SetterTargetType="controls:AppActionButton">
    <Setter Property="LabelMaxWidth" Value="160" />
  </Style>
  <Style Selector="controls|AppButton.composer-agent-button" x:SetterTargetType="controls:AppActionButton">
    <Setter Property="LabelMaxWidth" Value="130" />
  </Style>
  <Style Selector="controls|AppButton.edit-menu-action">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="controls|AppButton.edit-menu-action controls|AppText.action-badge">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="controls|AppButton.edit-menu-action:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="controls|AppCard.edit-menu-surface">
    <Setter Property="Width" Value="206" />
  </Style>
  <Style Selector="controls|AppBorder.edit-menu-divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="6,3" />
  </Style>
  <Style Selector="controls|AppButton.danger:disabled">
    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
  </Style>
</Styles>
