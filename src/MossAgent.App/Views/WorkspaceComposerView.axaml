<ui:AppUserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MossAgent.App.Controls"
             xmlns:views="clr-namespace:MossAgent.App.Views"
             xmlns:resources="clr-namespace:MossAgent.App.Resources"
             x:Class="MossAgent.App.Views.WorkspaceComposerView"
             x:CompileBindings="False">
  <Grid x:Name="ComposerRoot" Classes="composer-root" MaxWidth="736" HorizontalAlignment="Stretch"
        RowDefinitions="Auto,Auto,Auto,Auto">
    <ui:AppComposerContextBar Grid.Row="0" Project="{Binding Catalog.SelectedProject}"
                              BranchLabel="{Binding RepositoryStatus.BranchLabel}"
                              AgentName="{Binding SelectedAgentLabel}" Agents="{Binding Agents}"
                              HasAgents="{Binding HasAgents}" OpenProjectCommand="{Binding OpenProjectPickerCommand}"
                              CanChooseAgent="{Binding AgentPicker.CanChoose}"
                              SelectAgentCommand="{Binding SelectAgentCommand}">
      <ui:AppComposerContextBar.ProjectPickerContent>
          <views:ProjectPickerFlyoutView />
      </ui:AppComposerContextBar.ProjectPickerContent>
      <ui:AppComposerContextBar.EnvironmentPickerContent>
        <views:WorkspaceTaskEnvironmentView DataContext="{Binding Catalog.Environment}" />
      </ui:AppComposerContextBar.EnvironmentPickerContent>
    </ui:AppComposerContextBar>

      <ui:AppCard Grid.Row="1" Classes="composer-surface card-inset-composer">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto">
      <ui:AppItemsControl Grid.Row="0" ItemsSource="{Binding Attachments.Items}"
                    IsVisible="{Binding Attachments.HasItems}" Margin="0,1,0,5">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:AppAttachmentChip DisplayPath="{Binding DisplayPath}" SizeLabel="{Binding SizeLabel}"
                                   Thumbnail="{Binding Thumbnail}"
                                   RemoveCommand="{Binding RemoveCommand}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ui:AppItemsControl>

      <ui:AppText Classes="type-10-5 status-warning" Grid.Row="1" Text="{Binding Attachments.Status}"
                 TextWrapping="Wrap" />

      <ui:AppComposerInput Grid.Row="2" Classes="composer-input" Text="{Binding ComposerText}"
                PlaceholderText="随心输入"
                 SubmitCommand="{Binding ComposerSubmitCommand}"
                 AlternateSubmitCommand="{Binding Steering.AlternateSubmitCommand}"
                 ToolTip.Tip="{x:Static resources:ComposerInputText.Hint}"
                 AcceptsReturn="True">
        <ui:AppComposerInput.IsSubmissionEnabled>
          <MultiBinding Converter="{x:Static BoolConverters.Or}">
            <Binding Path="!IsRunning" />
            <Binding Path="Queue.CanEnqueueMessage" />
            <Binding Path="Steering.CanSubmit" />
          </MultiBinding>
        </ui:AppComposerInput.IsSubmissionEnabled>
      </ui:AppComposerInput>

      <Grid x:Name="ComposerToolbar" Grid.Row="3" Classes="composer-toolbar"
            ColumnDefinitions="Auto,Auto,*,Auto,Auto" RowDefinitions="Auto,Auto"
            SizeChanged="HandleToolbarSizeChanged">
        <ui:AppIconButton Classes="composer-attach"
                Command="{Binding Attachments.AddFilesCommand}"
                CommandParameter="{Binding Catalog.SelectedProject}"
                Label="{Binding Attachments.AddFilesLabel}" ToolTip.Tip="{Binding Attachments.SelectionHint}"
                IconData="{StaticResource UiIconPlus}" />

        <ui:AppApprovalPolicyButton x:Name="ApprovalPolicyButton" Grid.Column="1"
                                    IsVisible="{Binding Catalog.SelectedProject, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Policy="{Binding ApprovalPolicy}"
                                    SelectPolicyCommand="{Binding SetApprovalPolicyCommand}" />

        <ui:AppActionButton x:Name="ModelPickerButton" Grid.Column="2" Classes="ghost composer-model-picker"
                Label="{Binding ModelPicker.ComposerDisplayName}"
                BadgeText="{Binding ModelPicker.ReasoningDisplayName}"
                TrailingIconData="{StaticResource UiIconChevronDown}"
                Command="{Binding ModelPicker.ShowQuickMenuCommand}"
                AutomationProperties.Name="{Binding ModelPicker.CurrentDisplayName}"
                ToolTip.Tip="{Binding ModelPicker.CurrentDisplayName}">
          <Button.Flyout>
            <ui:AppFlyout Placement="TopEdgeAlignedRight"
                          IsOpen="{Binding ModelPicker.IsPickerOpen, Mode=TwoWay}">
              <views:ModelPickerFlyoutView DataContext="{Binding ModelPicker}" />
            </ui:AppFlyout>
          </Button.Flyout>
        </ui:AppActionButton>

        <ui:AppButton x:Name="QueueButton" Grid.Column="3" Classes="ghost menu-option" Content="{Binding Queue.EnqueueLabel}"
                      Command="{Binding Queue.EnqueueCommand}">
          <ui:AppButton.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="HasActiveRun" /><Binding Path="Queue.IsAvailable" />
            </MultiBinding>
          </ui:AppButton.IsVisible>
        </ui:AppButton>
        <ui:AppIconButton x:Name="SendButton" Grid.Column="4" Classes="primary composer-send"
                          Command="{Binding PrimaryActionCommand}" Label="{Binding PrimaryActionLabel}"
                          IconData="{StaticResource UiIconSend}"
                          AlternateIconData="{StaticResource UiIconStop}"
                          IsAlternateIcon="{Binding IsRunning}"
                          IsFilledIcon="{Binding IsRunning}" />
      </Grid>
      </Grid>
    </ui:AppCard>

    <StackPanel Grid.Row="2" Margin="14,6,14,0" Spacing="4">
      <StackPanel.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.Or}">
          <Binding Path="HasSendPreparationError" />
          <Binding Path="AgentPicker.HasCatalogNotice" />
          <Binding Path="ModelPicker.HasReasoningError" />
          <Binding Path="Drafts.HasNotice" />
        </MultiBinding>
      </StackPanel.IsVisible>
    <ui:AppText Classes="type-11 status-warning"
                Text="{Binding SendPreparationError}" IsVisible="{Binding HasSendPreparationError}"
                TextWrapping="Wrap" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding AgentPicker.HasCatalogNotice}">
        <ui:AppText Classes="type-11 status-warning" Text="{Binding AgentPicker.CatalogNotice}" TextWrapping="Wrap" />
        <ui:AppButton Grid.Column="1" Classes="ghost menu-option" VerticalAlignment="Top"
                      Content="{Binding AgentPicker.RefreshLabel}" Command="{Binding AgentPicker.RefreshCommand}" />
      </Grid>
      <ui:AppText Classes="type-11 status-warning" Text="{Binding ModelPicker.ReasoningNotice}"
                  IsVisible="{Binding ModelPicker.HasReasoningError}" TextWrapping="Wrap" />
      <StackPanel Spacing="4" IsVisible="{Binding Drafts.HasNotice}">
        <ui:AppText Classes="type-11 status-warning" Text="{Binding Drafts.Notice}" TextWrapping="Wrap" />
        <WrapPanel Orientation="Horizontal">
          <ui:AppButton Classes="ghost menu-option" Content="{Binding Drafts.RetryLabel}" Command="{Binding Drafts.RetryCommand}" />
          <ui:AppButton Classes="ghost menu-option" Content="{Binding Drafts.KeepLocalLabel}"
                        Command="{Binding Drafts.KeepLocalCommand}" IsVisible="{Binding Drafts.HasConflicts}" />
        </WrapPanel>
      </StackPanel>
    </StackPanel>
      <StackPanel Grid.Row="3">
        <views:WorkspaceWorktreeRecoveryView Margin="0,6,0,0" DataContext="{Binding WorktreeRecovery}" />
        <views:WorkspaceWorktreeAuthorizationView DataContext="{Binding Catalog.WorktreeAuthorization}" />
        <views:WorkspaceFollowupQueueView Margin="0,6,0,0" DataContext="{Binding Queue}" IsVisible="{Binding IsVisible}" />
        <views:WorkspaceSteeringView Margin="0,6,0,0" DataContext="{Binding Steering}" IsVisible="{Binding IsVisible}" />
      </StackPanel>

  </Grid>
</ui:AppUserControl>
