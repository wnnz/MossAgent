<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MossAgent.App.Views"
             xmlns:vm="clr-namespace:MossAgent.App.ViewModels"
             xmlns:domain="clr-namespace:MossAgent.Domain;assembly=MossAgent.Domain"
             x:Class="MossAgent.App.Views.WorkspaceChatView"
             x:CompileBindings="False">
  <UserControl.Styles>
    <Style Selector="TextBox.composer-input">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="2,4" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector="TextBox.composer-input:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.composer-input:focus-within /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.composer-input:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding PrimaryActionCommand}" />
  </UserControl.KeyBindings>

  <Border Background="{DynamicResource CardBackgroundBrush}">
    <Grid RowDefinitions="44,*,Auto">
      <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="0,0,0,1" Padding="16,0">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <TextBlock Text="›_" FontFamily="Consolas" Classes="muted"
                       FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Catalog.SelectedTask.Title, FallbackValue='新任务'}"
                       FontWeight="SemiBold" FontSize="13"
                       TextTrimming="CharacterEllipsis" MaxWidth="520"
                       VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                      VerticalAlignment="Center">
            <TextBlock Text="{Binding Activity}" Classes="subtle" FontSize="10"
                       MaxWidth="300" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Content="↻" Classes="ghost" Width="28" Height="28" Padding="0"
                    Command="{Binding RefreshCommand}" ToolTip.Tip="刷新工作区配置" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" IsVisible="{Binding IsEmptySession}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
          <Border Width="44" Height="44" CornerRadius="12"
                  Background="{DynamicResource CardSubtleBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
            <TextBlock Text="M" FontSize="15" FontWeight="SemiBold" Classes="muted"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding EmptySessionTitle}"
                     FontSize="19" FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Text="描述目标，MossAgent 会读取代码、运行工具并展示每一步结果。"
                     Classes="muted" FontSize="12" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>

      <ScrollViewer Grid.Row="1" IsVisible="{Binding HasMessages}"
                    HorizontalScrollBarVisibility="Disabled" Padding="28,18">
        <ItemsControl ItemsSource="{Binding Messages}" MaxWidth="860"
                      HorizontalAlignment="Stretch">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="4,2,4,12">
                <Grid ColumnDefinitions="86,*">
                  <TextBlock Text="{Binding Role}" FontSize="11" FontWeight="SemiBold"
                             Classes="muted" Margin="0,3,14,0" />
                  <ItemsControl Grid.Column="1" ItemsSource="{Binding Blocks}"
                                IsVisible="{Binding IsRegularMessage}">
                    <ItemsControl.Styles>
                      <Style Selector="ContentPresenter">
                        <Setter Property="Margin" Value="0,0,0,8" />
                      </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.DataTemplates>
                      <DataTemplate DataType="vm:ChatTextBlockViewModel">
                        <Grid>
                          <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                               FontSize="13" LineHeight="21"
                                               IsVisible="{Binding IsBody}" />
                          <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                               FontSize="16" FontWeight="SemiBold"
                                               Margin="0,3,0,2"
                                               IsVisible="{Binding IsHeading}" />
                          <Grid ColumnDefinitions="22,*" IsVisible="{Binding IsListItem}">
                            <TextBlock Text="{Binding Prefix}" Classes="muted"
                                       FontSize="12" Margin="2,2,0,0" />
                            <SelectableTextBlock Grid.Column="1" Text="{Binding Text}"
                                                 TextWrapping="Wrap" FontSize="13"
                                                 LineHeight="21" />
                          </Grid>
                          <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                                  BorderThickness="2,0,0,0" Padding="10,1"
                                  IsVisible="{Binding IsQuote}">
                            <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                 Classes="muted" FontSize="13" />
                          </Border>
                        </Grid>
                      </DataTemplate>
                      <DataTemplate DataType="vm:ChatCodeBlockViewModel">
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="1" CornerRadius="8">
                          <Grid RowDefinitions="Auto,*">
                            <Border Background="{DynamicResource CardSubtleBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="0,0,0,1" Padding="10,5">
                              <TextBlock Text="{Binding Language}" Classes="subtle"
                                         FontSize="10" FontFamily="Consolas" />
                            </Border>
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                          MaxHeight="360" Padding="10,8">
                              <SelectableTextBlock Text="{Binding Code}" FontFamily="Consolas"
                                                   FontSize="12" LineHeight="18" />
                            </ScrollViewer>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.DataTemplates>
                  </ItemsControl>

                  <Border Grid.Column="1" IsVisible="{Binding IsTool}"
                          Background="{DynamicResource CardSubtleBackgroundBrush}"
                          BorderBrush="{DynamicResource BorderSubtleBrush}"
                          BorderThickness="1" CornerRadius="8">
                    <Grid RowDefinitions="Auto,Auto">
                      <Button Classes="ghost" Padding="10,7"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Command="{Binding ToggleToolCommand}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                          <TextBlock Text="{Binding ExpandGlyph}" Classes="subtle"
                                     VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Tool.ToolName}" FontFamily="Consolas"
                                       FontSize="11.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Tool.Summary}" Classes="muted"
                                       FontSize="11" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding ToolStatus}"
                                     Classes="subtle" FontSize="10"
                                     VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                      <Border Grid.Row="1" IsVisible="{Binding IsToolExpanded}"
                              BorderBrush="{DynamicResource BorderSubtleBrush}"
                              BorderThickness="0,1,0,0" Padding="10,8">
                        <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Auto">
                          <SelectableTextBlock Text="{Binding Tool.Details}"
                                               FontFamily="Consolas" FontSize="11.5"
                                               TextWrapping="Wrap" />
                        </ScrollViewer>
                      </Border>
                    </Grid>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Border Grid.Row="2" Margin="28,0,28,18" MaxWidth="900"
              HorizontalAlignment="Stretch"
              Background="{DynamicResource CardSubtleBackgroundBrush}"
              BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
              CornerRadius="14" Padding="14,11" BoxShadow="0 6 24 0 #16000000">
        <Grid RowDefinitions="Auto,Auto,Auto">
          <StackPanel Orientation="Horizontal" Spacing="7" Margin="2,0,0,5">
            <TextBlock Text="▱" Classes="subtle" FontSize="11" />
            <TextBlock Text="{Binding RepositoryStatus.DirectoryLabel}"
                       Classes="muted" FontSize="11" FontFamily="Consolas" />
            <TextBlock Text="·" Classes="subtle" />
            <TextBlock Text="⑂" Classes="subtle" FontSize="11" />
            <TextBlock Text="{Binding RepositoryStatus.BranchLabel}" Classes="muted"
                       FontSize="11" FontFamily="Consolas" />
          </StackPanel>

          <TextBox Grid.Row="1" Classes="composer-input" Text="{Binding ComposerText}"
                   PlaceholderText="让 MossAgent 构建、修复或解释代码…"
                   AcceptsReturn="True" MinHeight="58" MaxHeight="180" FontSize="13" />

          <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,8,0,0">
            <Button x:Name="ApprovalPolicyButton" Classes="ghost" Padding="9,5"
                    CornerRadius="6" ToolTip.Tip="选择工具审批策略">
              <Button.Flyout>
                <Flyout Placement="TopEdgeAlignedLeft">
                  <Border Background="{DynamicResource CardBackgroundBrush}"
                          BorderBrush="{DynamicResource BorderDefaultBrush}"
                          BorderThickness="1" CornerRadius="10" Padding="6" Width="310">
                    <StackPanel>
                      <TextBlock Text="工具权限" FontWeight="SemiBold" FontSize="12"
                                 Margin="8,6,8,5" />
                      <Button Classes="ghost" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left" Padding="9,7"
                              Command="{Binding SetApprovalPolicyCommand}"
                              CommandParameter="{x:Static domain:ApprovalPolicy.ReadOnly}"
                              Click="HandleApprovalPolicySelected">
                        <StackPanel>
                          <TextBlock Text="只读模式" FontWeight="SemiBold" FontSize="12" />
                          <TextBlock Text="只允许读取文件和执行明确的只读操作" Classes="muted" FontSize="10.5" />
                        </StackPanel>
                      </Button>
                      <Button Classes="ghost" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left" Padding="9,7"
                              Command="{Binding SetApprovalPolicyCommand}"
                              CommandParameter="{x:Static domain:ApprovalPolicy.AskEveryTime}"
                              Click="HandleApprovalPolicySelected">
                        <StackPanel>
                          <TextBlock Text="每次询问" FontWeight="SemiBold" FontSize="12" />
                          <TextBlock Text="修改文件、运行命令或操作浏览器前询问" Classes="muted" FontSize="10.5" />
                        </StackPanel>
                      </Button>
                      <Button Classes="ghost" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left" Padding="9,7"
                              Command="{Binding SetApprovalPolicyCommand}"
                              CommandParameter="{x:Static domain:ApprovalPolicy.FullAccess}"
                              Click="HandleApprovalPolicySelected">
                        <StackPanel>
                          <TextBlock Text="完全访问" FontWeight="SemiBold" FontSize="12" />
                          <TextBlock Text="授权目录和当前浏览器会话内无需逐次询问" Classes="muted" FontSize="10.5" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Border>
                </Flyout>
              </Button.Flyout>
              <TextBlock Text="{Binding ApprovalPolicyLabel}" FontSize="11.5"
                         Foreground="#F97316" FontWeight="SemiBold" />
            </Button>

            <TextBlock Grid.Column="1" Text="Ctrl+Enter 发送" Classes="subtle"
                       FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Margin="0,0,10,0" />

            <Button Grid.Column="2" Classes="ghost" Padding="10,5" CornerRadius="6"
                    Margin="0,0,7,0" VerticalAlignment="Center">
              <Button.Flyout>
                <Flyout Placement="TopEdgeAlignedRight">
                  <views:ModelPickerFlyoutView DataContext="{Binding ModelPicker}" />
                </Flyout>
              </Button.Flyout>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="{Binding ModelPicker.CurrentDisplayName}" FontSize="12"
                           Classes="muted" VerticalAlignment="Center" />
                <TextBlock Text="⌄" Classes="subtle" FontSize="10" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Grid.Column="3" Classes="primary" Command="{Binding PrimaryActionCommand}"
                    Width="34" Height="34" CornerRadius="17" Padding="0"
                    ToolTip.Tip="发送任务或停止执行">
              <Panel>
                <TextBlock Text="■" IsVisible="{Binding IsRunning}" FontSize="10"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Text="↑" IsVisible="{Binding !IsRunning}" FontSize="16"
                           FontWeight="Bold" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Panel>
            </Button>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
