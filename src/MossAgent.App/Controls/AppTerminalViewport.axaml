<ui:AppUserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:MossAgent.App.Controls"
                   x:Class="MossAgent.App.Controls.AppTerminalViewport">
  <Grid ClipToBounds="True">
    <ui:AppScrollViewer x:Name="TerminalScroller" Classes="thin-scrollbar terminal-grid-scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <ui:AppTerminalScreen x:Name="TerminalGrid" />
    </ui:AppScrollViewer>
    <Grid IsHitTestVisible="False">
      <ui:AppText x:Name="TerminalPreedit" Classes="terminal-preedit" IsVisible="False" />
    </Grid>
  </Grid>
</ui:AppUserControl>
