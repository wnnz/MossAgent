<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MossAgent.App.Controls">
  <Style Selector=".app-expander" x:SetterTargetType="controls:AppExpander">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:AppExpander">
        <StackPanel>
          <controls:AppToggleButton Name="PART_toggle" Classes="disclosure-trigger"
                                    AutomationProperties.Name="{TemplateBinding Header}"
                                    IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" />
              <controls:AppIcon Classes="disclosure-chevron" />
            </StackPanel>
          </controls:AppToggleButton>
          <controls:AppBorder Name="PART_ExpandableContent" IsVisible="{TemplateBinding IsExpanded}" Margin="0,12,0,0">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </controls:AppBorder>
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector=".app-toggle-button.disclosure-trigger" x:SetterTargetType="controls:AppToggleButton">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:AppToggleButton">
        <controls:AppBorder Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </controls:AppBorder>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector=".app-toggle-button.disclosure-trigger:pointerover" x:SetterTargetType="controls:AppToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector=".app-toggle-button.disclosure-trigger:disabled" x:SetterTargetType="controls:AppToggleButton">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector=".app-expander /template/ controls|AppIcon.disclosure-chevron">
    <Setter Property="Data" Value="{StaticResource UiIconChevronRight}" />
    <Setter Property="Size" Value="10" />
    <Setter Property="Stroke" Value="{DynamicResource TextSubtleBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>
  <Style Selector=".app-expander:expanded /template/ controls|AppIcon.disclosure-chevron">
    <Setter Property="Data" Value="{StaticResource UiIconChevronDown}" />
  </Style>
  <Style Selector=".app-expander.appearance-advanced" x:SetterTargetType="controls:AppExpander">
    <Setter Property="Margin" Value="0,44,0,0" />
  </Style>
</Styles>
