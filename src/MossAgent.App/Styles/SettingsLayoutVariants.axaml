<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MossAgent.App.Controls">
  <StyleInclude Source="avares://MossAgent.App/Styles/ProviderSettingsRowVariants.axaml" />
  <StyleInclude Source="avares://MossAgent.App/Styles/SettingsItemRowVariants.axaml" />
  <StyleInclude Source="avares://MossAgent.App/Styles/SettingsPageHeaderVariants.axaml" />
  <StyleInclude Source="avares://MossAgent.App/Styles/SettingsRowVariants.axaml" />
  <Style Selector=".app-toggle-button.settings-nav" x:SetterTargetType="controls:AppToggleButton">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector=".settings-shell" x:SetterTargetType="controls:AppUserControl">
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <Style Selector="controls|AppText.settings-sidebar-title">
    <Setter Property="Margin" Value="8,10,8,14" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LineHeight" Value="28" />
  </Style>
  <Style Selector="Grid.settings-search-row">
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>
  <Style Selector="controls|AppText.settings-navigation-heading">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Margin" Value="8,16,8,7" />
  </Style>
  <Style Selector="controls|AppText.settings-navigation-heading.first">
    <Setter Property="Margin" Value="8,4,8,7" />
  </Style>
  <Style Selector=".app-toggle-button.settings-nav controls|AppIconLabel">
    <Setter Property="Spacing" Value="10" />
  </Style>
  <Style Selector=".app-toggle-button.settings-nav controls|AppText">
    <Setter Property="LineHeight" Value="18" />
  </Style>
  <Style Selector=".app-toggle-button.settings-nav controls|AppIcon">
    <Setter Property="Size" Value="14" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>
  <Style Selector="controls|AppText.settings-theme-heading">
    <Setter Property="Margin" Value="0,41,0,16" />
  </Style>
  <Style Selector=".app-input.settings-search" x:SetterTargetType="controls:AppInput">
    <Setter Property="Background" Value="{DynamicResource SettingsNavigationSelectionBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="34,7,12,7" />
    <Setter Property="Height" Value="36" />
  </Style>
  <Style Selector=".app-input.settings-search /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource SettingsNavigationSelectionBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="18" />
  </Style>
  <Style Selector="StackPanel.titlebar-menu-group">
    <Setter Property="Margin" Value="10,0,0,0" />
  </Style>
  <Style Selector="StackPanel.titlebar-menu-group.settings-mode.settings-navigation-wide.settings-navigation-visible">
    <Setter Property="Margin" Value="5,0,0,0" />
  </Style>
  <Style Selector="Grid.settings-content-column">
    <Setter Property="MaxWidth" Value="728" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="28,74,38,34" />
  </Style>
  <Style Selector="controls|AppCard.settings-catalog-card">
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector=".app-list-box.settings-catalog-list" x:SetterTargetType="controls:AppListBox">
    <Setter Property="MaxHeight" Value="560" />
  </Style>
</Styles>
