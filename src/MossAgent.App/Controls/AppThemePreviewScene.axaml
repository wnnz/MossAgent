<ui:AppUserControl xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:MossAgent.App.Controls"
                   x:Class="MossAgent.App.Controls.AppThemePreviewScene"
                   Classes="app-theme-preview-scene" IsHitTestVisible="False">
  <ui:AppBorder Classes="preview-backdrop">
    <Grid>
    <ui:AppBorder Classes="preview-screen-shadow" IsHitTestVisible="False" />
    <ui:AppBorder Classes="preview-screen" ClipToBounds="True">
      <Grid ColumnDefinitions="12,*">
        <ui:AppBorder Classes="preview-sidebar">
          <ui:AppIcon Classes="preview-logo" Data="{StaticResource UiIconAssistant}" />
        </ui:AppBorder>
        <Grid Grid.Column="1" Margin="4,4,4,3" RowDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <ui:AppBorder Classes="preview-accent-line preview-user-first" />
            <ui:AppBorder Classes="preview-message-line preview-assistant-first" />
            <ui:AppBorder Classes="preview-message-line preview-assistant-second" />
            <ui:AppBorder Classes="preview-message-line preview-assistant-third" />
            <ui:AppBorder Classes="preview-accent-line preview-user-second" />
            <ui:AppBorder Classes="preview-accent-line preview-user-third" />
          </StackPanel>
          <ui:AppBorder Grid.Row="1" Classes="preview-composer">
            <ui:AppBorder Classes="preview-send" />
          </ui:AppBorder>
        </Grid>
      </Grid>
    </ui:AppBorder>
    </Grid>
  </ui:AppBorder>
</ui:AppUserControl>
