<ui:AppUserControl xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:MossAgent.App.Controls"
                   x:Class="MossAgent.App.Views.WorkspaceWorktreeRecoveryView" x:CompileBindings="False">
  <ui:AppCard Classes="card-inset-composer" IsVisible="{Binding IsVisible}">
    <StackPanel Spacing="6">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <ui:AppText Classes="type-11" Text="{Binding Title}" VerticalAlignment="Center" />
        <ui:AppButton Grid.Column="1" Classes="ghost menu-option" Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}" />
      </Grid>
      <ui:AppItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Spacing="3" Margin="0,0,0,6">
              <ui:AppText Classes="type-11 status-warning" Text="{Binding Summary}" TextWrapping="Wrap" />
              <ui:AppText Classes="type-10-5 text-muted" Text="{Binding Target}" TextWrapping="Wrap" />
              <ui:AppText Classes="type-10-5 text-muted" Text="{Binding Detail}" />
              <WrapPanel Orientation="Horizontal">
                <ui:AppButton x:Name="AcknowledgeWorktreeIntentButton" Classes="ghost menu-option"
                              Content="{Binding AcknowledgeLabel}" Command="{Binding AcknowledgeCommand}" />
              </WrapPanel>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ui:AppItemsControl>
      <ui:AppText Classes="type-10-5 text-muted" Text="{Binding Hint}" TextWrapping="Wrap" />
      <ui:AppText Classes="type-11 status-warning" Text="{Binding Notice}" TextWrapping="Wrap" IsVisible="{Binding HasNotice}" />
    </StackPanel>
  </ui:AppCard>
</ui:AppUserControl>
