           Text="Surface shadows must use SharedSurfaceShadow or None; only the shared window frame may use SharedWindowFrameShadow: @(_IndependentSurfaceShadow)" />
  </Target>
  <Target Name="ValidateSharedComponentResources" BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_ComponentResourceMarkup Include="$(MSBuildProjectDirectory)/**/*.axaml"
                                Exclude="$(MSBuildProjectDirectory)/App.axaml;$(MSBuildProjectDirectory)/Styles/**/*.axaml;$(MSBuildProjectDirectory)/bin/**/*.axaml;$(MSBuildProjectDirectory)/obj/**/*.axaml" />
    </ItemGroup>
    <XmlPeek XmlInputPath="%(_ComponentResourceMarkup.FullPath)"
             Query="//*[contains('|SolidColorBrush|BoxShadows|StreamGeometry|FontFamily|ResourceInclude|StyleInclude|', concat('|', local-name(), '|')) or @*[local-name()='Resources' or substring-after(local-name(), '.')='Resources']]">
      <Output TaskParameter="Result" ItemName="_LocalVisualResource" />
    </XmlPeek>
    <Error Condition="'@(_LocalVisualResource)' != ''"
           Text="Visual resources belong in shared App.axaml or Styles/; business markup cannot shadow or import component appearance tokens: @(_LocalVisualResource)" />
  </Target>
  <Target Name="ValidateSharedTerminalPane" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_TerminalPaneMarkup Include="$(MSBuildProjectDirectory)/**/*.axaml"
                           Exclude="$(MSBuildProjectDirectory)/App.axaml;$(MSBuildProjectDirectory)/Styles/**/*.axaml;$(MSBuildProjectDirectory)/bin/**/*.axaml;$(MSBuildProjectDirectory)/obj/**/*.axaml" />
    </ItemGroup>
    <XmlPeek XmlInputPath="%(_TerminalPaneMarkup.FullPath)"
             Query="//*[((local-name()='AppTerminalPane' or local-name()='AppTerminalViewport' or local-name()='AppTerminalScreen') and (@*[contains('|Content|DataTemplates|Padding|Width|Height|MinWidth|MaxWidth|MinHeight|MaxHeight|HorizontalContentAlignment|VerticalContentAlignment|', concat('|', local-name(), '|'))] or *[not(contains(local-name(), '.')) or contains('|Content|DataTemplates|Padding|Width|Height|MinWidth|MaxWidth|MinHeight|MaxHeight|HorizontalContentAlignment|VerticalContentAlignment|', concat('|', substring-after(local-name(), '.'), '|'))])) or (local-name()='AppTerminalScreen' and (@CellHeight or *[substring-after(local-name(), '.')='CellHeight']))]">
      <Output TaskParameter="Result" ItemName="_TerminalPaneReplacement" />
    </XmlPeek>
    <Error Condition="'@(_TerminalPaneReplacement)' != ''"
           Text="Terminal pane composition and geometry belong to the shared component: @(_TerminalPaneReplacement)" />
  </Target>
</Project>
