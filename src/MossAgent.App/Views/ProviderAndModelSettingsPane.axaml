<ui:AppUserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MossAgent.App.Controls"
             x:Class="MossAgent.App.Views.ProviderAndModelSettingsPane"
             x:CompileBindings="False">
  <Grid x:Name="ProviderSettingsRoot">
    <Grid Classes="settings-content-column"
          RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
      <StackPanel Spacing="5">
        <ui:AppText Text="AI 提供商" Classes="settings-title" />
        <ui:AppText Text="管理连接、模型列表与模型参数。" Classes="settings-description" />
        <ui:AppText Text="{Binding Models.Status}" Classes="muted type-12"
                   Classes.status-error="{Binding Models.HasStatusError}"
                   TextWrapping="Wrap" IsVisible="{Binding Models.HasStatus}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ui:AppActionButton Label="刷新" IconData="{StaticResource UiIconRefresh}" Classes="ghost" Command="{Binding Providers.RefreshCommand}" />
        <ui:AppActionButton Label="添加提供商" IconData="{StaticResource UiIconPlus}" Classes="primary" Command="{Binding Providers.OpenCreateFormCommand}" />
      </StackPanel>
    </Grid>

    <ui:AppScrollViewer Grid.Row="1" Classes="settings-page-scroll">
      <StackPanel Spacing="12">
      <ui:AppCard x:Name="CatalogNotice" Classes="card card-inset-emphasis" IsVisible="{Binding Models.Catalog.HasNotice}">
        <ui:AppText Text="{Binding Models.Catalog.Notice}" Classes="muted type-12"
                    Classes.status-error="{Binding Models.Catalog.HasLoadError}" TextWrapping="Wrap" />
      </ui:AppCard>
      <ui:AppCard x:Name="EmptyCatalog" Classes="card card-inset-emphasis" IsVisible="{Binding Models.Catalog.IsEmpty}">
        <StackPanel Spacing="6">
          <ui:AppText Classes="type-14 weight-semibold" Text="还没有 AI 提供商" />
          <ui:AppText Text="添加提供商后，可以获取模型列表或手动配置模型。"
                     Classes="muted type-12" />
          <ui:AppButton Content="添加提供商" Classes="ghost" HorizontalAlignment="Left"
                  Command="{Binding Providers.OpenCreateFormCommand}" />
        </StackPanel>
      </ui:AppCard>
      <ui:AppItemsControl x:Name="ProviderRows" ItemsSource="{Binding Models.ProviderGroups}"
                          IsEnabled="{Binding Models.Catalog.CanMutate}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:AppCard Classes="card card-inset-popover" Margin="0,0,0,10">
              <Grid RowDefinitions="Auto,Auto">
                <ui:AppProviderSettingsHeader Provider="{Binding Provider}"
                      ModelCount="{Binding ModelCount}" IsExpanded="{Binding IsExpanded}"
                      ToggleCommand="{Binding $parent[UserControl].DataContext.Models.ToggleProviderCommand}"
                      ToggleCommandParameter="{Binding}"
                      EditCommand="{Binding $parent[UserControl].DataContext.Providers.EditProviderCommand}" />

                <ui:AppBorder Grid.Row="1" IsVisible="{Binding IsExpanded}" Margin="36,8,0,0" Padding="0,8,0,0"
                        Classes="divider-top">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ui:AppText Text="模型" Classes="muted type-12 weight-semibold" />
                      </StackPanel>
                      <ui:AppButton Grid.Column="1" Content="获取模型" Classes="ghost provider-settings-action" Margin="0,0,8,0"
                              Command="{Binding $parent[UserControl].DataContext.Models.FetchModelsForProviderCommand}"
                              CommandParameter="{Binding}" />
                      <ui:AppActionButton Grid.Column="2" Label="添加模型" IconData="{StaticResource UiIconPlus}" Classes="ghost provider-settings-action"
                              Command="{Binding $parent[UserControl].DataContext.Models.AddModelForProviderCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                    <ui:AppText Text="尚未配置模型。可获取模型列表，或手动添加模型。" Classes="subtle type-11" Margin="10,6" IsVisible="{Binding HasNoModels}" />
                    <ui:AppItemsControl ItemsSource="{Binding Models}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <ui:AppModelSettingsRow Model="{Binding}"
                              EditCommand="{Binding $parent[UserControl].DataContext.Models.EditProviderModelCommand}"
                              DeleteCommand="{Binding $parent[UserControl].DataContext.Models.DeleteProviderModelCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ui:AppItemsControl>
                  </StackPanel>
                </ui:AppBorder>
              </Grid>
            </ui:AppCard>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ui:AppItemsControl>
      </StackPanel>
    </ui:AppScrollViewer>
    </Grid>

    <ui:AppSettingsDialog Classes="wide" IsOpen="{Binding Providers.IsFormOpen}"
                          Title="{Binding Providers.EditorTitle}" CloseLabel="关闭提供商配置"
                          CloseCommand="{Binding Providers.CloseFormCommand}">
            <StackPanel Spacing="9">
            <ui:AppText Text="提供商名称" Classes="muted type-12" />
             <ui:AppInput Text="{Binding Providers.Name}" PlaceholderText="例如 OpenAI / DeepSeek"
                          AutomationProperties.Name="提供商名称" />
            <ui:AppText Text="协议类型" Classes="muted type-12" />
             <ui:AppComboBox ItemsSource="{Binding Providers.ProtocolOptions}"
                       SelectedItem="{Binding Providers.SelectedProtocolOption}"
                       HorizontalAlignment="Stretch" DisplayMemberBinding="{Binding DisplayName}"
                       AutomationProperties.Name="协议类型" />
            <ui:AppText Text="Base URL" Classes="muted type-12" />
             <ui:AppInput Text="{Binding Providers.BaseUrl}" AutomationProperties.Name="Base URL" />
            <ui:AppText Text="API Key" Classes="muted type-12" />
             <ui:AppInput Text="{Binding Providers.ApiKey}" PasswordChar="●" PlaceholderText="{Binding Providers.ApiKeyPlaceholder}"
                          AutomationProperties.Name="API Key" />
            <ui:AppText Text="网络代理" Classes="muted type-12" />
             <ui:AppComboBox ItemsSource="{Binding Providers.Proxies}" SelectedItem="{Binding Providers.SelectedProxy}"
                       DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch"
                       AutomationProperties.Name="网络代理" />
            <WrapPanel Margin="0,4">
              <ui:AppCheckBox Content="设为默认" IsChecked="{Binding Providers.IsDefault}" Margin="0,0,16,0" />
              <ui:AppCheckBox Content="启用" IsChecked="{Binding Providers.IsEnabled}" />
            </WrapPanel>
            </StackPanel>
          <ui:AppSettingsDialog.Footer>
          <StackPanel Spacing="4">
            <ui:AppText Text="{Binding Providers.EditorNotice}" IsVisible="{Binding Providers.HasEditorNotice}"
                        Classes="muted type-12" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
<ui:AppButton Classes="primary" Content="保存提供商" Command="{Binding Providers.SaveCommand}" HorizontalAlignment="Stretch" />
              <ui:AppButton Grid.Column="1" Classes="danger" Content="{Binding Providers.DeleteButtonText}"
                            Command="{Binding Providers.DeleteCommand}" IsVisible="{Binding Providers.HasSelectedProvider}" />
              <ui:AppButton Grid.Column="2" Content="取消" Command="{Binding Providers.CloseFormCommand}" />
            </Grid>
            <ui:AppText Text="{Binding Providers.Status}" Classes="subtle type-11"
                        Classes.status-error="{Binding Providers.HasValidationError}"
                        TextWrapping="Wrap" />
          </StackPanel>
          </ui:AppSettingsDialog.Footer>
    </ui:AppSettingsDialog>

    <ui:AppSettingsDialog Classes="wide" IsOpen="{Binding Models.IsFormOpen}"
                          Title="配置模型" CloseLabel="关闭模型配置"
                          CloseCommand="{Binding Models.CloseFormCommand}">
            <StackPanel Spacing="9">
            <ui:AppText Text="模型 ID" Classes="muted type-12" />
             <ui:AppInput Text="{Binding Models.ModelId}" PlaceholderText="例如 gpt-5"
                          AutomationProperties.Name="模型 ID" />
            <ui:AppText Text="显示名称" Classes="muted type-12" />
             <ui:AppInput Text="{Binding Models.DisplayName}" AutomationProperties.Name="显示名称" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <StackPanel>
                <ui:AppText Text="上下文长度" Classes="muted type-12" />
                 <ui:AppNumericUpDown Value="{Binding Models.ContextLength}" Minimum="1024" Maximum="4000000"
                                      AutomationProperties.Name="上下文长度" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <ui:AppText Text="最大输出 Token" Classes="muted type-12" />
                 <ui:AppNumericUpDown Value="{Binding Models.MaximumOutputTokens}" Minimum="256" Maximum="1000000"
                                      AutomationProperties.Name="最大输出 Token" />
              </StackPanel>
            </Grid>
            <StackPanel>
              <ui:AppText Text="思考强度" Classes="muted type-12" />
               <ui:AppEditableChoice Choices="{Binding Models.ReasoningEfforts}" SelectedChoice="{Binding Models.ReasoningEffort}"
                               HorizontalAlignment="Stretch" AutomationProperties.Name="思考强度" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <StackPanel>
                <ui:AppText Text="Temperature（可留空）" Classes="muted type-12" />
                 <ui:AppNumericUpDown Value="{Binding Models.Temperature}" Minimum="0" Maximum="2" Increment="0.1" FormatString="0.0"
                                      AutomationProperties.Name="Temperature" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <ui:AppText Text="Top-P（可留空）" Classes="muted type-12" />
                 <ui:AppNumericUpDown Value="{Binding Models.TopP}" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00"
                                      AutomationProperties.Name="Top-P" />
              </StackPanel>
            </Grid>
            <WrapPanel Margin="0,4">
              <ui:AppCheckBox Content="默认模型" IsChecked="{Binding Models.IsDefault}" Margin="0,0,16,0" />
              <ui:AppCheckBox Content="启用" IsChecked="{Binding Models.IsEnabled}" />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,4">
              <ui:AppCheckBox Content="支持图像" IsChecked="{Binding Models.SupportsImages}" Margin="0,0,16,0" />
              <ui:AppCheckBox Content="支持文件" IsChecked="{Binding Models.SupportsFiles}" />
            </WrapPanel>
            <ui:AppText Text="高级参数 JSON（可选）" Classes="muted type-12" />
             <ui:AppInput Text="{Binding Models.AdvancedJson}" AcceptsReturn="True" TextWrapping="Wrap"
                      Classes="code-font field-multiline"
                      AutomationProperties.Name="高级参数 JSON" />
            </StackPanel>
          <ui:AppSettingsDialog.Footer>
          <StackPanel Spacing="4">
            <ui:AppText Text="{Binding Models.EditorNotice}" IsVisible="{Binding Models.HasEditorNotice}"
                        Classes="muted type-12" Classes.status-warning="{Binding Models.HasReasoningError}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
<ui:AppButton Classes="primary" Content="保存模型" Command="{Binding Models.SaveModelCommand}" HorizontalAlignment="Stretch" />
              <ui:AppButton Grid.Column="1" Content="取消" Command="{Binding Models.CloseFormCommand}" />
            </Grid>
            <ui:AppText Text="{Binding Models.EditorStatus}" Classes="muted type-12 status-error"
                        IsVisible="{Binding Models.HasEditorStatus}" TextWrapping="Wrap" />
          </StackPanel>
          </ui:AppSettingsDialog.Footer>
    </ui:AppSettingsDialog>
  </Grid>
</ui:AppUserControl>
