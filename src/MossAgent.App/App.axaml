<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MossAgent.App.Controls"
             x:Class="MossAgent.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://MossAgent.App/Styles/ComponentVariants.axaml" />
        <ResourceInclude Source="avares://MossAgent.App/Styles/DangerButtonResources.axaml" />
        <ResourceInclude Source="avares://MossAgent.App/Styles/ButtonStateResources.axaml" />
        <ResourceInclude Source="avares://MossAgent.App/Styles/WindowCaptionResources.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <BoxShadows x:Key="SharedSurfaceShadow">0 0 14 0 #0A000000</BoxShadows>
      <BoxShadows x:Key="SharedWindowFrameShadow">0 0 28 0 #0C000000, 0 0 0 1 #04000000</BoxShadows>
      <ResourceDictionary.ThemeDictionaries>
        <!-- ChatGPT 风格深色主题 (Dark) -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#181818" />
          <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#1A2228" />
          <SolidColorBrush x:Key="TitlebarDividerBrush" Color="#2F2F2F" />
          <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1A2229" />
          <SolidColorBrush x:Key="WorkspaceSidebarBackgroundBrush" Color="#1A2229" />
          <SolidColorBrush x:Key="SettingsSelectionBrush" Color="#2C333A" />
          <SolidColorBrush x:Key="SettingsNavigationSelectionBrush" Color="#2C333A" />
          <SolidColorBrush x:Key="CardBackgroundBrush" Color="#212121" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#424242" />
          <SolidColorBrush x:Key="CardSubtleBackgroundBrush" Color="#2F2F2F" />
          <SolidColorBrush x:Key="InputBackgroundBrush" Color="#303030" />
          <SolidColorBrush x:Key="BorderDefaultBrush" Color="#424242" />
          <SolidColorBrush x:Key="BorderSubtleBrush" Color="#2F2F2F" />
          <SolidColorBrush x:Key="SidebarBorderBrush" Color="#2F2F2F" />
          <SolidColorBrush x:Key="SidebarScrollThumbBrush" Color="#40474D" />
          <SolidColorBrush x:Key="SidebarScrollThumbHoverBrush" Color="#6D757C" />
          <SolidColorBrush x:Key="BorderFocusBrush" Color="#8E8E8E" />
          <SolidColorBrush x:Key="CodeKeywordBrush" Color="#C586C0" />
          <SolidColorBrush x:Key="CodeStringBrush" Color="#CE9178" />
          <SolidColorBrush x:Key="CodeNumberBrush" Color="#B5CEA8" />
          <SolidColorBrush x:Key="CodeCommentBrush" Color="#6A9955" />
          <SolidColorBrush x:Key="CodeTypeBrush" Color="#4EC9B0" />

          <!-- 文字 -->
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECECEC" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#B4B4B4" />
          <SolidColorBrush x:Key="TextSubtleBrush" Color="#A0A0A0" />
          <SolidColorBrush x:Key="TitlebarMenuForegroundBrush" Color="#A9AFB4" />
          <SolidColorBrush x:Key="SidebarTextBrush" Color="#E6E6E6" />
          <SolidColorBrush x:Key="SidebarSectionTextBrush" Color="#A0A0A0" />
          <SolidColorBrush x:Key="StatusWarningBrush" Color="#F97316" />
          <SolidColorBrush x:Key="StatusErrorBrush" Color="#F87171" />
          <SolidColorBrush x:Key="StatusSuccessBrush" Color="#4ADE80" />
          <SolidColorBrush x:Key="ApprovalTextBrush" Color="#FBBF24" />
          <SolidColorBrush x:Key="ApprovalBadgeBrush" Color="#452B0C" />

          <!-- 按钮 -->
          <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#2F2F2F" />
          <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#ECECEC" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#424242" />
          <SolidColorBrush x:Key="ButtonHoverBrush" Color="#3A3A3A" />
          <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#F4F4F6" />
          <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#0A0A0C" />
          <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#D9212121" />
          <SolidColorBrush x:Key="ReasoningSliderActiveBrush" Color="#399BFB" />
          <SolidColorBrush x:Key="ReasoningSliderTrackBrush" Color="#55575B" />
          <SolidColorBrush x:Key="ThemeChoiceSelectionBrush" Color="#EEEEEE" />

          <!-- 覆盖系统高亮为中性质感，杜绝任何蓝色蓝框 -->
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#8E8E8E" />
          <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#F4F4F6" />
        </ResourceDictionary>
        <!-- ChatGPT 风格浅色主题 (Light) -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#EEF4F9" />
          <SolidColorBrush x:Key="TitlebarDividerBrush" Color="#E6EBF0" />
          <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#EEF4F9" />
          <SolidColorBrush x:Key="WorkspaceSidebarBackgroundBrush" Color="#F9FBFD" />
          <SolidColorBrush x:Key="SettingsSelectionBrush" Color="#ECEFF1" />
          <SolidColorBrush x:Key="SettingsNavigationSelectionBrush" Color="#ECEFF1" />
          <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#EDEDED" />
          <SolidColorBrush x:Key="CardSubtleBackgroundBrush" Color="#F4F4F4" />
          <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="BorderDefaultBrush" Color="#E5E5E5" />
          <SolidColorBrush x:Key="BorderSubtleBrush" Color="#F1F1F1" />
          <SolidColorBrush x:Key="SidebarBorderBrush" Color="#DDE3E7" />
          <SolidColorBrush x:Key="SidebarScrollThumbBrush" Color="#E7E9EB" />
          <SolidColorBrush x:Key="SidebarScrollThumbHoverBrush" Color="#CED2D6" />
          <SolidColorBrush x:Key="BorderFocusBrush" Color="#8E8E8E" />
          <SolidColorBrush x:Key="CodeKeywordBrush" Color="#AF00DB" />
          <SolidColorBrush x:Key="CodeStringBrush" Color="#A31515" />
          <SolidColorBrush x:Key="CodeNumberBrush" Color="#098658" />
          <SolidColorBrush x:Key="CodeCommentBrush" Color="#008000" />
          <SolidColorBrush x:Key="CodeTypeBrush" Color="#267F99" />

          <!-- 文字 -->
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1C1F" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#5D5D5D" />
          <SolidColorBrush x:Key="TextSubtleBrush" Color="#6B6B6B" />
          <SolidColorBrush x:Key="TitlebarMenuForegroundBrush" Color="#85898D" />
          <SolidColorBrush x:Key="SidebarTextBrush" Color="#3B3E40" />
          <SolidColorBrush x:Key="SidebarSectionTextBrush" Color="#6B7075" />
          <SolidColorBrush x:Key="StatusWarningBrush" Color="#9A3412" />
          <SolidColorBrush x:Key="StatusErrorBrush" Color="#B42318" />
          <SolidColorBrush x:Key="StatusSuccessBrush" Color="#15803D" />
          <SolidColorBrush x:Key="ApprovalTextBrush" Color="#92400E" />
          <SolidColorBrush x:Key="ApprovalBadgeBrush" Color="#FFF1D7" />

          <!-- 按钮：扁平现代无廉价边框质感 -->
          <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#27272A" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#E5E5E5" />
          <SolidColorBrush x:Key="ButtonHoverBrush" Color="#F1F1F1" />
          <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#1A1C1F" />
          <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#99000000" />
          <SolidColorBrush x:Key="ReasoningSliderActiveBrush" Color="#399BFB" />
          <SolidColorBrush x:Key="ReasoningSliderTrackBrush" Color="#E4E5E8" />
          <SolidColorBrush x:Key="ThemeChoiceSelectionBrush" Color="#202020" />

          <!-- 覆盖系统高亮为中性质感，杜绝任何蓝色蓝框 -->
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#8E8E8E" />
          <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#0D0D0D" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <FontFamily x:Key="CodeFontFamily">Consolas, Cascadia Code, Courier New</FontFamily>
      <FontFamily x:Key="UiFontFamily">Segoe UI</FontFamily>
      <FontFamily x:Key="ContentFontFamily">Segoe UI</FontFamily>
