<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MossAgent.App.Controls">
  <Styles.Resources>
    <ui:ModalAvailableExtentConverter x:Key="ProjectEditorAvailableExtent" />
  </Styles.Resources>
  <Style Selector="UserControl.project-editor">
    <Setter Property="Width" Value="420" />
    <Setter Property="MaxWidth" Value="{Binding $parent[Window].ClientSize.Width, Converter={StaticResource ProjectEditorAvailableExtent}, FallbackValue=420}" />
    <Setter Property="MaxHeight" Value="{Binding $parent[Window].ClientSize.Height, Converter={StaticResource ProjectEditorAvailableExtent}, FallbackValue=520}" />
  </Style>
  <Style Selector=".app-scroll-viewer.project-directory-scroll" x:SetterTargetType="ui:AppScrollViewer">
    <Setter Property="MaxHeight" Value="280" />
  </Style>
  <Style Selector="ui|AppBorder.directory-row.project-directory-row">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="UseLayoutRounding" Value="False" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ui|AppBorder.directory-row.project-directory-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource CardSubtleBackgroundBrush}" />
  </Style>
  <Style Selector="ui|AppBorder.directory-primary-badge.project-directory-badge">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource CardSubtleBackgroundBrush}" />
  </Style>
</Styles>
