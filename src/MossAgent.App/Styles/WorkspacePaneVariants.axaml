<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MossAgent.App.Controls">
  <Style Selector=".app-workspace-panes" x:SetterTargetType="controls:AppWorkspacePanes">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="MinimumPrimaryWidth" Value="360" />
    <Setter Property="MinimumInspectorWidth" Value="280" />
    <Setter Property="DefaultInspectorFraction" Value="0.47" />
    <Setter Property="FloatingInspectorWidth" Value="300" />
    <Setter Property="FloatingInspectorMargin" Value="0,58,8,0" />
  </Style>
  <Style Selector=".app-pane-splitter" x:SetterTargetType="controls:AppPaneSplitter">
    <Setter Property="Width" Value="4" />
    <Setter Property="MinWidth" Value="4" />
    <Setter Property="MaxWidth" Value="4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="SizeWestEast" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="KeyboardIncrement" Value="10" />
    <Setter Property="DragIncrement" Value="1" />
  </Style>
  <Style Selector=".app-pane-splitter:pointerover, .app-pane-splitter:focus-visible" x:SetterTargetType="controls:AppPaneSplitter">
    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
  </Style>
</Styles>
