<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MossAgent.App.Controls">
  <Style Selector="controls|AppButton.empty-project-action">
    <Setter Property="Padding" Value="10,5" />
  </Style>
  <Style Selector="controls|AppButton.empty-project-link">
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="controls|AppButton.ghost.empty-project-link:pointerover">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="controls|AppText.empty-project-name">
    <Setter Property="FontSize" Value="27.5" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
    <Setter Property="TextDecorations">
      <Setter.Value>
        <TextDecorationCollection>
          <TextDecoration Location="Underline" />
        </TextDecorationCollection>
      </Setter.Value>
    </Setter>
  </Style>
  <Style Selector="controls|AppButton.project-picker-row">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="controls|AppButton.project-picker-row.selected">
    <Setter Property="Background" Value="{DynamicResource SettingsSelectionBrush}" />
  </Style>
  <Style Selector=".app-input.project-picker-search" x:SetterTargetType="controls:AppInput">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="27,5,8,5" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <Style Selector=".app-input.project-picker-search:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector=".app-input.project-picker-search:focus-within /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
</Styles>
