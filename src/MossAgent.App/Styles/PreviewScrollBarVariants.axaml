<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MossAgent.App.Controls">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PreviewScrollGlyphBrush" Color="#B7B7B7" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PreviewScrollGlyphBrush" Color="#8E8E8E" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <StreamGeometry x:Key="PreviewScrollLeftGlyph">M 6 0 L 0 4 L 6 8 Z</StreamGeometry>
      <StreamGeometry x:Key="PreviewScrollRightGlyph">M 0 0 L 6 4 L 0 8 Z</StreamGeometry>
      <ControlTheme x:Key="SharedPreviewScrollLineButtonTheme" TargetType="RepeatButton">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PreviewScrollGlyphBrush}" />
        <Setter Property="Template">
          <ControlTemplate>
            <ui:AppBorder Background="{TemplateBinding Background}" CornerRadius="4">
              <ui:AppIcon Size="8" Data="{TemplateBinding Tag}" Fill="{TemplateBinding Foreground}"
                          Stroke="{x:Null}" IsHitTestVisible="False"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ui:AppBorder>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="^:pressed">
          <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Foreground" Value="{DynamicResource PreviewScrollGlyphBrush}" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector=".app-diff-preview .app-scroll-viewer" x:SetterTargetType="ui:AppScrollViewer">
    <Setter Property="AllowAutoHide" Value="False" />
  </Style>
  <Style Selector=".app-diff-preview .app-scroll-viewer /template/ ScrollBar#PART_HorizontalScrollBar">
    <Setter Property="Height" Value="16" />
    <Setter Property="MinHeight" Value="16" />
    <Setter Property="MaxHeight" Value="16" />
  </Style>
  <Style Selector=".app-diff-preview .app-scroll-viewer /template/ ScrollBar#PART_HorizontalScrollBar[Maximum=0]">
    <Setter Property="IsEnabled" Value="False" />
  </Style>
  <Style Selector=".app-diff-preview .app-scroll-viewer /template/ ScrollBar#PART_HorizontalScrollBar /template/ RepeatButton#PART_LineUpButton, .app-diff-preview .app-scroll-viewer /template/ ScrollBar#PART_HorizontalScrollBar /template/ RepeatButton#PART_LineDownButton">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Theme" Value="{StaticResource SharedPreviewScrollLineButtonTheme}" />
  </Style>
  <Style Selector=".app-diff-preview .app-scroll-viewer /template/ ScrollBar#PART_HorizontalScrollBar /template/ RepeatButton#PART_LineUpButton">
    <Setter Property="Tag" Value="{StaticResource PreviewScrollLeftGlyph}" />
  </Style>
  <Style Selector=".app-diff-preview .app-scroll-viewer /template/ ScrollBar#PART_HorizontalScrollBar /template/ RepeatButton#PART_LineDownButton">
    <Setter Property="Tag" Value="{StaticResource PreviewScrollRightGlyph}" />
  </Style>
  <Style Selector=".app-diff-preview .app-scroll-viewer /template/ ScrollBar#PART_HorizontalScrollBar /template/ Thumb">
    <Setter Property="Height" Value="16" />
    <Setter Property="Background" Value="{DynamicResource PreviewScrollGlyphBrush}" />
  </Style>
  <Style Selector=".app-diff-preview .app-scroll-viewer /template/ ScrollBar#PART_HorizontalScrollBar[Maximum=0] /template/ Thumb">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=".app-diff-preview .app-scroll-viewer /template/ ScrollBar#PART_HorizontalScrollBar /template/ Thumb:pointerover, .app-diff-preview .app-scroll-viewer /template/ ScrollBar#PART_HorizontalScrollBar /template/ Thumb:pressed">
    <Setter Property="Background" Value="{DynamicResource TextMutedBrush}" />
  </Style>
</Styles>
