<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MossAgent.App.Controls">
  <Style Selector="controls|AppButton.window-control">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Foreground" Value="{DynamicResource WindowCaptionForegroundBrush}" />
  </Style>
  <Style Selector="controls|AppButton.window-control:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource WindowCaptionForegroundBrush}" />
  </Style>
  <Style Selector="controls|AppButton.closeButton.window-control:pointerover">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="controls|AppButton.window-control:disabled">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="controls|AppButton.window-control controls|AppIcon.ui-icon">
    <Setter Property="Size" Value="8" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>
  <Style Selector="controls|AppButton.closeButton.window-control controls|AppIcon.ui-icon">
    <Setter Property="Size" Value="10" />
  </Style>
  <Style Selector="controls|AppButton.window-minimize controls|AppIcon.ui-icon">
    <Setter Property="RenderTransform" Value="translate(0px,-0.5px)" />
  </Style>
  <Style Selector="controls|AppButton.window-maximize:not(:alternate) controls|AppIcon.ui-icon">
    <Setter Property="Size" Value="9" />
    <Setter Property="StrokeLineCap" Value="Flat" />
    <Setter Property="RenderTransform" Value="translate(0.5px,-0.5px)" />
  </Style>
</Styles>
