<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MossAgent.App.Views.ModelPickerFlyoutView"
             x:CompileBindings="False"
             Width="340" MaxHeight="460">
  <Border Background="{DynamicResource CardBackgroundBrush}"
          BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
          CornerRadius="10" Padding="12" BoxShadow="0 8 30 0 #44000000">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
      <!-- 1. 标题栏 -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,2,8">
        <TextBlock Text="选择模型" FontWeight="SemiBold" FontSize="14"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <Button Grid.Column="1" Content="↻" Classes="ghost" Padding="4,2"
                Command="{Binding RefreshCommand}" ToolTip.Tip="刷新模型列表" />
      </Grid>

      <!-- 2. 搜索框 -->
      <TextBox Grid.Row="1" Text="{Binding SearchQuery}"
               PlaceholderText="🔍  搜索模型..." Margin="0,0,0,10"
               Background="{DynamicResource InputBackgroundBrush}"
               BorderBrush="{DynamicResource BorderSubtleBrush}" CornerRadius="8"
               FontSize="13" Padding="8,6" />

      <!-- 3. 按供应商分组的模型列表 -->
      <Grid Grid.Row="2" MinHeight="90" Margin="0,0,0,10">
        <StackPanel IsVisible="{Binding HasNoModels}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
          <TextBlock Text="没有可用模型" HorizontalAlignment="Center"
                     FontSize="12" FontWeight="SemiBold" />
          <TextBlock Text="请先在设置中添加并启用供应商与模型。"
                     Classes="muted" FontSize="11" TextWrapping="Wrap"
                     HorizontalAlignment="Center" />
        </StackPanel>
        <ScrollViewer MaxHeight="280" IsVisible="{Binding HasModels}">
          <ItemsControl ItemsSource="{Binding FilteredGroups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,8">
                <!-- 供应商分组标题 -->
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,4,4,4">
                  <TextBlock Text="⬡" FontSize="12" Classes="muted" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ProviderName}" FontWeight="SemiBold"
                             FontSize="12" Classes="muted" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 模型列表项 -->
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Classes="ghost" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left" Padding="16,6,8,6"
                              Margin="0,1" CornerRadius="6"
                              Command="{Binding $parent[UserControl].DataContext.SelectItemCommand}"
                              CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <TextBlock Text="◈" FontSize="11" Classes="muted" Margin="0,0,8,0" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="13"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Text="✓" Foreground="#4ADE80"
                                     IsVisible="{Binding IsSelected}" FontSize="12" Margin="4,0,0,0" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- 4. 底部工具条：联网开关与思考强度快捷选择 -->
      <Border Grid.Row="3" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <TextBlock Text="思考强度" Classes="muted" FontSize="11"
                     VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding ReasoningOptions}"
                    SelectedItem="{Binding SelectedReasoning}"
                    HorizontalAlignment="Stretch" FontSize="11" Padding="7,3" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
