<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MossAgent.App.Controls">
  <Style Selector="controls|AppText.conversation-turn-timestamp">
    <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,28,0,18" />
  </Style>
  <Style Selector="controls|AppBorder.conversation-turn-heading">
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Margin" Value="4,0,4,16" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="controls|AppButton.conversation-turn-summary">
    <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="controls|AppButton.conversation-turn-summary controls|AppIcon.action-trailing-icon">
    <Setter Property="Size" Value="12" />
    <Setter Property="Stroke" Value="{DynamicResource TextSubtleBrush}" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="RenderTransform" Value="None" />
  </Style>
  <Style Selector="controls|AppButton.conversation-turn-summary.is-expanded controls|AppIcon.action-trailing-icon">
    <Setter Property="RenderTransform"><RotateTransform Angle="90" /></Setter>
  </Style>
  <Style Selector="controls|AppText.conversation-turn-summary-text">
    <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
