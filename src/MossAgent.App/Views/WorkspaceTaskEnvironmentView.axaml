<ui:AppUserControl xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:MossAgent.App.Controls"
                   x:Class="MossAgent.App.Views.WorkspaceTaskEnvironmentView"
                   x:CompileBindings="False" IsVisible="{Binding HasProject}">
  <ui:AppActionButton x:Name="EnvironmentButton" Classes="composer-context-button composer-environment-button"
                      Label="{Binding Label}" IsEnabled="{Binding CanChoose}" ToolTip.Tip="{Binding Hint}"
                      AutomationProperties.Name="{Binding Label}" TrailingIconData="{StaticResource UiIconChevronDown}">
    <Button.Flyout>
      <ui:AppFlyout Placement="TopEdgeAlignedLeft"
                    IsOpen="{Binding IsPickerOpen, Mode=TwoWay}">
        <ui:AppCard Classes="flyout-surface card-inset-menu composer-environment-menu">
          <StackPanel Spacing="4">
            <ui:AppActionButton Classes="ghost menu-option align-leading" Label="{Binding ProjectDirectoryLabel}"
                                IconData="{StaticResource UiIconFolder}" Command="{Binding UseProjectDirectoryCommand}" />
            <ui:AppText Classes="type-11 muted" Text="{Binding BaseReferenceLabel}" />
            <ui:AppInput x:Name="BaseReferenceInput" Text="{Binding BaseReference, Mode=TwoWay}"
                             PlaceholderText="{Binding BaseReferencePlaceholder}" MaxLength="512"
                             AutomationProperties.Name="{Binding BaseReferenceLabel}" IsEnabled="{Binding CanChoose}" />
            <ui:AppText Classes="type-11 muted" Text="{Binding References.Label}" IsVisible="{Binding References.IsAvailable}" />
            <ui:AppInput x:Name="ReferenceSearchInput" Text="{Binding References.SearchText, Mode=TwoWay}"
                             PlaceholderText="{Binding References.SearchPlaceholder}" MaxLength="512"
                             AutomationProperties.Name="{Binding References.Label}" IsVisible="{Binding References.IsAvailable}" />
            <ui:AppListBox x:Name="ReferenceList" Classes="thin-scrollbar" MaxHeight="200"
                           ItemsSource="{Binding References.Items}"
                           SelectedItem="{Binding References.SelectedItem, Mode=TwoWay}"
                           IsVisible="{Binding References.IsAvailable}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="1">
                    <ui:AppText Classes="type-13" Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                    <ui:AppText Classes="type-11 muted" Text="{Binding Preview}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ui:AppListBox>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding References.HasStatus}">
              <ui:AppActionButton Classes="ghost" Label="{Binding References.PreviousLabel}"
                                  Command="{Binding References.PreviousPageCommand}"
                                  IsVisible="{Binding References.CanPrevious}" />
              <ui:AppText Classes="type-11 muted" Text="{Binding References.StatusText}" VerticalAlignment="Center" />
              <ui:AppActionButton Classes="ghost" Label="{Binding References.NextLabel}"
                                  Command="{Binding References.NextPageCommand}"
                                  IsVisible="{Binding References.HasMore}" />
            </StackPanel>
            <ui:AppActionButton Classes="ghost menu-option align-leading" Label="{Binding WorktreeLabel}"
                                IconData="{StaticResource UiIconBranch}" Command="{Binding UseWorktreeCommand}" />
            <ui:AppText Classes="type-11 muted" Text="{Binding Hint}" TextWrapping="Wrap" />
          </StackPanel>
        </ui:AppCard>
      </ui:AppFlyout>
    </Button.Flyout>
  </ui:AppActionButton>
</ui:AppUserControl>
