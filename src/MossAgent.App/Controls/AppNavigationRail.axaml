<ui:AppUserControl xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:MossAgent.App.Controls"
                   x:Class="MossAgent.App.Controls.AppNavigationRail"
                   x:Name="Root" x:CompileBindings="False">
  <ui:AppBorder Classes="navigation-rail-surface navigation-rail-body">
    <Grid RowDefinitions="Auto,*,Auto">
      <StackPanel Classes="navigation-rail-actions">
        <ui:AppIconButton x:Name="HomeButton" DataContext="{Binding #Root}"
                          Classes="navigation-rail-button navigation-rail-home"
                          Command="{Binding NewConversationCommand}"
                          IconData="{DynamicResource UiIconHome}" AlternateIconData="{DynamicResource UiIconHomeFilled}" />
        <ui:AppIconButton x:Name="AutomationButton" DataContext="{Binding #Root}"
                          Classes="navigation-rail-button" Label="{Binding AutomationsLabel}"
                          Command="{Binding AutomationsCommand}"
                          IconData="{DynamicResource UiIconClock}" />
        <ui:AppIconButton x:Name="AuditButton" DataContext="{Binding #Root}"
                          Classes="navigation-rail-button" Label="{Binding AuditLabel}"
                          Command="{Binding InspectorCommand}" CommandParameter="audit"
                          IconData="{DynamicResource UiIconBell}" />
        <ui:AppIconButton x:Name="MoreButton" DataContext="{Binding #Root}"
                          Classes="navigation-rail-button" Label="{Binding MoreLabel}"
                          IconData="{DynamicResource UiIconMore}">
          <Button.Flyout>
            <ui:AppFlyout Placement="RightEdgeAlignedTop" DismissOnButtonClick="True">
              <ui:AppCard Classes="flyout-surface card-inset-compact navigation-rail-menu" DataContext="{Binding #Root}">
                <StackPanel>
                  <ui:AppButton x:Name="InspectorMenuButton" Content="{Binding InspectorLabel}"
                                Classes="ghost menu-option align-leading" Command="{Binding ToggleInspectorCommand}" />
                  <ui:AppButton x:Name="SettingsMenuButton" Content="{Binding SettingsLabel}"
                                Classes="ghost menu-option align-leading" Command="{Binding SettingsCommand}" />
                </StackPanel>
              </ui:AppCard>
            </ui:AppFlyout>
          </Button.Flyout>
        </ui:AppIconButton>
      </StackPanel>
      <StackPanel Grid.Row="2" Classes="navigation-rail-actions">
        <ui:AppIconButton x:Name="HelpButton" DataContext="{Binding #Root}"
                          Classes="navigation-rail-button" Label="{Binding HelpLabel}"
                          IconData="{DynamicResource UiIconHelp}">
          <Button.Flyout>
            <ui:AppFlyout Placement="RightEdgeAlignedBottom">
              <ui:AppContentControl Content="{Binding #Root.HelpContent}" DataContext="{Binding #Root.DataContext}" />
            </ui:AppFlyout>
          </Button.Flyout>
        </ui:AppIconButton>
        <ui:AppIconButton x:Name="SettingsButton" DataContext="{Binding #Root}"
                          Classes="navigation-rail-button navigation-rail-settings" Label="{Binding SettingsLabel}"
                          Command="{Binding SettingsCommand}" IconData="{DynamicResource UiIconSettings}" />
      </StackPanel>
    </Grid>
  </ui:AppBorder>
</ui:AppUserControl>
