<ui:AppUserControl xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:MossAgent.App.Controls"
                   x:Class="MossAgent.App.Controls.AppConversationTab"
                   x:Name="Root" x:CompileBindings="False">
  <ui:AppBorder Classes="conversation-tab-host" Classes.selected="{Binding #Root.IsSelected}">
    <Grid DataContext="{Binding #Root}">
      <ui:AppActionButton x:Name="SelectButton" Classes="conversation-tab" Classes.selected="{Binding IsSelected}"
                          IconData="{StaticResource UiIconConversation}" Label="{Binding Title}"
                          Command="{Binding SelectCommand}" CommandParameter="{Binding CommandParameter}" />
      <ui:AppIconButton x:Name="OptionsButton" Classes="conversation-tab-options"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Label="{Binding OptionsLabel}" IconData="{StaticResource UiIconMore}">
        <Button.Flyout>
          <ui:AppFlyout Placement="BottomEdgeAlignedRight">
            <ui:AppCard Classes="flyout-surface card-inset-tight conversation-tab-menu">
              <ui:AppButton x:Name="CloseButton" Classes="ghost menu-option align-leading" HorizontalAlignment="Stretch"
                            Content="{Binding CloseLabel}" Command="{Binding CloseCommand}" CommandParameter="{Binding CommandParameter}" />
            </ui:AppCard>
          </ui:AppFlyout>
        </Button.Flyout>
      </ui:AppIconButton>
    </Grid>
  </ui:AppBorder>
</ui:AppUserControl>
