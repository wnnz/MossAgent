<ui:AppUserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MossAgent.App.Controls"
             x:Class="MossAgent.App.Views.ModelSettingsPane"
             x:CompileBindings="False">
  <Grid ColumnDefinitions="420,*" Margin="12">
    <ui:AppCard Classes="card" Margin="0,0,12,0">
      <ui:AppScrollViewer>
        <StackPanel Spacing="9">
          <Grid ColumnDefinitions="*,Auto">
            <ui:AppText Classes="type-18 weight-semibold" Text="模型配置" />
            <ui:AppButton Grid.Column="1" Content="新建" Command="{Binding NewModelCommand}" />
          </Grid>
          <ui:AppText Text="供应商" />
          <ui:AppComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                    DisplayMemberBinding="{Binding Name}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ui:AppButton Content="获取模型" Classes="primary" Command="{Binding FetchModelsCommand}" />
            <ui:AppButton Grid.Column="1" Content="刷新供应商" Command="{Binding RefreshProvidersCommand}" />
          </Grid>
          <ui:AppText Text="模型 ID" />
          <ui:AppInput Text="{Binding ModelId}" IsReadOnly="{Binding IsEditing}" PlaceholderText="例如 gpt-5" />
          <ui:AppText Text="显示名称" /><ui:AppInput Text="{Binding DisplayName}" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <StackPanel>
              <ui:AppText Text="上下文长度" />
              <ui:AppNumericUpDown Value="{Binding ContextLength}" Minimum="1024" Maximum="4000000" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <ui:AppText Text="最大输出" />
              <ui:AppNumericUpDown Value="{Binding MaximumOutputTokens}" Minimum="256" Maximum="1000000" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <StackPanel>
              <ui:AppText Text="Temperature（可空）" />
              <ui:AppNumericUpDown Value="{Binding Temperature}" Minimum="0" Maximum="2" Increment="0.1" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <ui:AppText Text="Top-P（可空）" />
              <ui:AppNumericUpDown Value="{Binding TopP}" Minimum="0" Maximum="1" Increment="0.1" />
            </StackPanel>
          </Grid>
          <ui:AppText Text="思考强度" />
          <ui:AppEditableChoice Choices="{Binding ReasoningEfforts}" SelectedChoice="{Binding ReasoningEffort}" />
          <WrapPanel>
            <ui:AppCheckBox Content="支持图像" IsChecked="{Binding SupportsImages}" Margin="0,0,12,0" />
            <ui:AppCheckBox Content="支持文件" IsChecked="{Binding SupportsFiles}" Margin="0,0,12,0" />
            <ui:AppCheckBox Content="默认模型" IsChecked="{Binding IsDefault}" Margin="0,0,12,0" />
            <ui:AppCheckBox Content="启用" IsChecked="{Binding IsEnabled}" />
          </WrapPanel>
          <ui:AppText Text="高级 JSON" />
          <ui:AppInput Text="{Binding AdvancedJson}" AcceptsReturn="True" Classes="code-font field-multiline" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ui:AppButton Content="保存模型" Classes="primary" Command="{Binding SaveModelCommand}" />
            <ui:AppButton Grid.Column="1" Content="删除所选" Command="{Binding DeleteModelCommand}" />
          </Grid>
          <ui:AppText Text="{Binding Status}" TextWrapping="Wrap" Classes="muted" />
        </StackPanel>
      </ui:AppScrollViewer>
    </ui:AppCard>

    <ui:AppCard Grid.Column="1" Classes="card">
      <Grid RowDefinitions="Auto,*">
        <ui:AppText Classes="type-18 weight-semibold" Text="模型列表" />
        <ui:AppListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding Models}"
                 SelectedItem="{Binding SelectedModel}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <ui:AppBorder Classes="divider-bottom" Padding="8,12">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <ui:AppText Classes="weight-semibold" Text="{Binding DisplayName}" />
                    <ui:AppText Text="{Binding ModelId}" Classes="muted" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <ui:AppText Text="{Binding ReasoningEffort}" HorizontalAlignment="Right" />
                    <ui:AppText Text="{Binding ContextLength}" Classes="muted" HorizontalAlignment="Right" />
                    <ui:AppText Text="{Binding IsDefault, StringFormat=默认：{0}}" Classes="muted" />
                  </StackPanel>
                </Grid>
              </ui:AppBorder>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ui:AppListBox>
      </Grid>
    </ui:AppCard>
  </Grid>
</ui:AppUserControl>
