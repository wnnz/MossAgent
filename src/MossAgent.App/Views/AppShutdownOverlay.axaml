<ui:AppUserControl xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:MossAgent.App.Controls"
                   x:Class="MossAgent.App.Views.AppShutdownOverlay" x:CompileBindings="False">
  <ui:AppSettingsDialog IsOpen="{Binding IsVisible}" Title="{Binding Title}" IsCloseButtonVisible="False">
    <ui:AppSettingsDialog.Footer>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" IsVisible="{Binding HasError}">
        <ui:AppButton Classes="primary" Content="{Binding RetryExitLabel}" Command="{Binding RetryExitCommand}"
                      IsDefault="{Binding HasError}" />
        <ui:AppButton Content="{Binding ForceExitLabel}" Command="{Binding ForceExitCommand}" />
      </StackPanel>
    </ui:AppSettingsDialog.Footer>
    <StackPanel Spacing="8">
      <ui:AppText Classes="settings-description" Text="{Binding Message}" TextWrapping="Wrap" />
      <StackPanel Spacing="8" IsVisible="{Binding HasError}">
        <ui:AppText Classes="settings-description" Text="{Binding Drafts.Notice}"
                    IsVisible="{Binding Drafts.HasNotice}" TextWrapping="Wrap" />
        <ui:AppButton Content="{Binding Drafts.RetryLabel}" Command="{Binding Drafts.RetryCommand}"
                      IsVisible="{Binding Drafts.HasNotice}" />
        <ui:AppButton Content="{Binding Drafts.KeepLocalLabel}" Command="{Binding Drafts.KeepLocalCommand}"
                      IsVisible="{Binding Drafts.HasConflicts}" />
        <ui:AppButton Content="{Binding Drafts.RemoveUnavailableAttachmentsLabel}"
                      Command="{Binding Drafts.RemoveUnavailableAttachmentsCommand}"
                      IsVisible="{Binding Drafts.HasUnavailableAttachments}" />
      </StackPanel>
    </StackPanel>
  </ui:AppSettingsDialog>
</ui:AppUserControl>
