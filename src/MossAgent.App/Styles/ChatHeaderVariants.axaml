<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MossAgent.App.Controls">
  <Style Selector=".app-conversation-header" x:SetterTargetType="controls:AppConversationHeader">
    <Setter Property="Height" Value="52" />
  </Style>
  <Style Selector="StackPanel.conversation-header-actions">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="2" />
    <Setter Property="Margin" Value="8,0,4,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Grid.conversation-header-context">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Margin" Value="2,0,0,0" />
  </Style>
  <Style Selector="Grid.conversation-header-status">
    <Setter Property="Height" Value="20" />
    <Setter Property="ColumnSpacing" Value="4" />
  </Style>
  <Style Selector="controls|AppButton.conversation-header-settings">
    <Setter Property="Height" Value="20" />
    <Setter Property="MaxWidth" Value="120" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Padding" Value="6,0" />
  </Style>
  <Style Selector=".conversation-header-menu" x:SetterTargetType="controls:AppContentControl">
    <Setter Property="Width" Value="190" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector=".conversation-header-heading" x:SetterTargetType="controls:AppContentControl">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="controls|AppButton.chat-header-action controls|AppIcon.ui-icon">
    <Setter Property="Size" Value="10" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>
  <Style Selector="controls|AppButton.chat-more-action controls|AppIcon.ui-icon">
    <Setter Property="RenderTransform" Value="translate(1px,0px)" />
  </Style>
  <Style Selector="controls|AppButton.chat-context-action controls|AppIcon.ui-icon">
    <Setter Property="Size" Value="12" />
    <Setter Property="RenderTransform" Value="translate(-1px,0px)" />
  </Style>
  <Style Selector="controls|AppButton.chat-context-action.active:not(:disabled)">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="controls|AppBorder.context-indicator">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="RenderTransform" Value="translate(-1px,0px)" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="controls|AppBorder.chat-header-separator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="1,0,2,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
  </Style>
  <Style Selector="controls|AppButton.chat-inspector-toggle.active">
    <Setter Property="Background" Value="{DynamicResource CardSubtleBackgroundBrush}" />
  </Style>
</Styles>
