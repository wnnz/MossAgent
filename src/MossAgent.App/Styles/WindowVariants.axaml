<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MossAgent.App.Controls">
  <StyleInclude Source="avares://MossAgent.App/Styles/NavigationPaneVariants.axaml" />
  <Style Selector=".app-window" x:SetterTargetType="controls:AppWindow">
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
  </Style>
  <Style Selector=".window-page-switcher" x:SetterTargetType="controls:AppPageSwitcher">
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <Style Selector="controls|AppBorder.window-content-frame, controls|AppBorder.window-content-clip">
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="controls|AppBorder.window-content-frame">
    <Setter Property="Background" Value="{DynamicResource WorkspaceSidebarBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Margin" Value="0,0,4,4" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="BoxShadow" Value="{StaticResource SharedWindowFrameShadow}" />
  </Style>
  <Style Selector="controls|AppBorder.window-content-clip">
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="controls|AppButton.navigation-history:not(.titlebar-panel) controls|AppIcon.ui-icon">
    <Setter Property="Size" Value="9" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="RenderTransform" Value="translate(-0.5px,0.5px)" />
  </Style>
  <Style Selector="controls|AppButton.titlebar-panel controls|AppIcon.ui-icon">
    <Setter Property="Size" Value="10" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>
  <Style Selector="controls|AppBorder.resize-north-south">
    <Setter Property="Height" Value="6" />
    <Setter Property="Cursor" Value="SizeNorthSouth" />
  </Style>
  <Style Selector="controls|AppBorder.resize-west-east">
    <Setter Property="Width" Value="6" />
    <Setter Property="Cursor" Value="SizeWestEast" />
  </Style>
  <Style Selector="controls|AppBorder.resize-corner">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
  </Style>
  <Style Selector="controls|AppBorder.resize-north-west">
    <Setter Property="Cursor" Value="TopLeftCorner" />
  </Style>
  <Style Selector="controls|AppBorder.resize-north-east">
    <Setter Property="Cursor" Value="TopRightCorner" />
  </Style>
  <Style Selector="controls|AppBorder.resize-south-west">
    <Setter Property="Cursor" Value="BottomLeftCorner" />
  </Style>
  <Style Selector="controls|AppBorder.resize-south-east">
    <Setter Property="Cursor" Value="BottomRightCorner" />
  </Style>
</Styles>
