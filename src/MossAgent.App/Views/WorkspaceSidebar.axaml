<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MossAgent.App.Views.WorkspaceSidebar"
             x:CompileBindings="False">
  <UserControl.Styles>
    <Style Selector="Border.directory-row Button.set-primary">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.directory-row:pointerover Button.set-primary">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
  </UserControl.Styles>
  <Border Background="{DynamicResource SidebarBackgroundBrush}"
          BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0"
          Padding="10,10">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
      <Grid ColumnDefinitions="*,Auto" Margin="6,2,4,12">
        <TextBlock Text="工作区" FontWeight="SemiBold" FontSize="13"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="＋" Classes="ghost" Width="26" Height="26"
                Padding="0" FontSize="14" ToolTip.Tip="添加项目">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft"
                    IsOpen="{Binding ProjectEditor.IsOpen, Mode=TwoWay}">
              <Border Background="{DynamicResource CardBackgroundBrush}"
                      BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                      CornerRadius="12" Padding="14" Width="420">
                <StackPanel Spacing="8">
                  <TextBlock Text="创建项目" FontWeight="SemiBold" FontSize="18" Margin="2,0,0,4" />
                  <TextBox Text="{Binding ProjectEditor.Name}" PlaceholderText="项目名称" />
                  <TextBlock Text="源文件夹" Classes="muted" FontSize="11.5" Margin="2,4,0,0" />
                  <ItemsControl ItemsSource="{Binding ProjectEditor.Directories}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="directory-row"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1,0,1,1" Padding="10,8">
                          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Text="▱" Classes="muted" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                       ToolTip.Tip="{Binding Path}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="2" IsVisible="{Binding IsPrimary}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="1" CornerRadius="7" Padding="8,3">
                              <TextBlock Text="主要" Classes="muted" FontSize="10.5" />
                            </Border>
                            <Button Grid.Column="2" Classes="ghost set-primary"
                                    IsVisible="{Binding IsSecondary}" Content="设为主要"
                                    Padding="8,3" FontSize="10.5"
                                    Command="{Binding SetPrimaryCommand}" />
                            <Button Grid.Column="3" Classes="ghost" Content="×" Width="26"
                                    Padding="0" Command="{Binding RemoveCommand}"
                                    ToolTip.Tip="移除目录" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="＋ 添加文件夹" Classes="ghost"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Command="{Binding ProjectEditor.AddDirectoryCommand}" />
                  <Button Content="添加项目" Classes="primary"
                          Command="{Binding ProjectEditor.AddCommand}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center" />
                  <TextBlock Text="{Binding ProjectEditor.Status}" Classes="muted" FontSize="11"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>

      <Button Grid.Row="1" Classes="ghost" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Left" Padding="9,7"
              Command="{Binding NewTaskCommand}">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <TextBlock Text="＋" FontSize="15" VerticalAlignment="Center" />
          <TextBlock Text="新建任务" FontSize="13" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,2">
        <TextBox Text="{Binding TaskSearch.Query}" PlaceholderText="搜索当前项目的任务"
                 FontSize="11.5" Padding="8,5" />
        <Button Grid.Column="1" Content="×" Classes="ghost" Width="26" Padding="0"
                IsVisible="{Binding TaskSearch.HasQuery}"
                Command="{Binding TaskSearch.ClearCommand}" ToolTip.Tip="清除搜索" />
      </Grid>

      <TextBlock Grid.Row="3" Text="项目" Classes="subtle" FontSize="11"
                 FontWeight="SemiBold" Margin="8,16,8,6" />

      <ListBox Grid.Row="4" ItemsSource="{Binding Projects}"
               SelectedItem="{Binding SelectedProject}"
               MaxHeight="180" Margin="0,0,0,4">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="20,*" Margin="1">
              <TextBlock Text="◇" Classes="muted" FontSize="12"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5"
                         Margin="5,0,0,0" TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto" Margin="8,12,4,6">
        <TextBlock Text="任务" Classes="subtle" FontSize="11"
                   FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="✎" Classes="ghost" Width="24" Height="24"
                Padding="0" Command="{Binding TaskManagement.BeginRenameCommand}"
                IsVisible="{Binding SelectedTask, Converter={x:Static ObjectConverters.IsNotNull}}"
                ToolTip.Tip="重命名所选任务" />
        <Button Grid.Column="2" Content="↓" Classes="ghost" Width="24" Height="24"
                Padding="0" Command="{Binding TaskManagement.ArchiveCommand}"
                IsVisible="{Binding SelectedTask, Converter={x:Static ObjectConverters.IsNotNull}}"
                ToolTip.Tip="归档所选任务" />
      </Grid>

      <Grid Grid.Row="6" RowDefinitions="Auto,*,Auto">
        <Border IsVisible="{Binding TaskManagement.IsEditing}"
                Background="{DynamicResource CardSubtleBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                CornerRadius="7" Padding="7" Margin="0,0,0,6">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
            <TextBox Text="{Binding TaskManagement.EditingTitle}" FontSize="11.5"
                     PlaceholderText="任务名称" />
            <Button Grid.Column="1" Content="保存" Classes="primary" Padding="7,3"
                    Command="{Binding TaskManagement.SaveRenameCommand}" />
            <Button Grid.Column="2" Content="取消" Classes="ghost" Padding="7,3"
                    Command="{Binding TaskManagement.CancelRenameCommand}" />
          </Grid>
        </Border>

        <ListBox Grid.Row="1" ItemsSource="{Binding Tasks}"
                 SelectedItem="{Binding SelectedTask}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" Margin="1">
                <TextBlock Text="{Binding Title}" FontSize="12.5"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="subtle"
                           FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="0,5,0,0" Spacing="4"
                    IsVisible="{Binding TaskManagement.HasArchivedTasks}">
          <Button Content="{Binding TaskManagement.ArchiveToggleLabel}" Classes="ghost"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Padding="7,4" FontSize="10.5"
                  Command="{Binding TaskManagement.ToggleArchiveCommand}" />
          <StackPanel IsVisible="{Binding TaskManagement.IsArchiveVisible}" Spacing="4">
            <ListBox ItemsSource="{Binding TaskManagement.ArchivedTasks}"
                     SelectedItem="{Binding TaskManagement.SelectedArchivedTask}"
                     MaxHeight="130">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Title}" FontSize="11.5"
                             TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="恢复所选任务" Classes="ghost" Padding="7,4"
                    HorizontalAlignment="Stretch"
                    Command="{Binding TaskManagement.RestoreCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding TaskManagement.Status}" Classes="subtle"
                     FontSize="10" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="7" BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
        <Button Classes="ghost" Padding="8,7" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Command="{Binding $parent[Window].DataContext.OpenSettingsCommand}">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <TextBlock Text="⚙" FontSize="13" Classes="muted" />
            <TextBlock Text="设置" FontSize="12.5" />
          </StackPanel>
        </Button>
      </Border>
    </Grid>
  </Border>
</UserControl>
