<ui:AppUserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MossAgent.App.Controls"
             x:Class="MossAgent.App.Controls.AppThemeExtendedFontsCard"
             x:CompileBindings="False">
  <StackPanel>
    <ui:AppBorder Classes="divider-bottom" Padding="0,7">
      <Grid ColumnDefinitions="*,190" ColumnSpacing="16">
        <ui:AppText Text="内容字体" Classes="type-13" />
        <ui:AppComboBox Grid.Column="1" ItemsSource="{Binding ContentFontOptions}"
                        SelectedItem="{Binding SelectedContentFontOption}"
                        DisplayMemberBinding="{Binding Label}"
                        AutomationProperties.Name="主题内容字体"
                        HorizontalAlignment="Right" />
      </Grid>
    </ui:AppBorder>
    <ui:AppBorder Padding="0,7">
      <Grid ColumnDefinitions="*,190" ColumnSpacing="16">
        <ui:AppText Text="代码字体" Classes="type-13" />
        <ui:AppComboBox Grid.Column="1" ItemsSource="{Binding CodeFontOptions}"
                        SelectedItem="{Binding SelectedCodeFontOption}"
                        DisplayMemberBinding="{Binding Label}"
                        AutomationProperties.Name="主题代码字体"
                        HorizontalAlignment="Right" />
      </Grid>
    </ui:AppBorder>
  </StackPanel>
</ui:AppUserControl>
