<Styles xmlns="https://github.com/avaloniaui"
        xmlns:controls="clr-namespace:MossAgent.App.Controls">
  <StyleInclude Source="avares://MossAgent.App/Styles/FileChangeVariants.axaml" />
  <Style Selector="UserControl.app-response-content controls|MarkdownSelectableTextBlock">
    <Setter Property="CodeFontSize" Value="12" />
    <Setter Property="CodeBackground" Value="{DynamicResource CardSubtleBackgroundBrush}" />
    <Setter Property="CodeBackgroundPadding" Value="0,2" />
    <Setter Property="CodeCornerRadius" Value="3" />
  </Style>
  <Style Selector="Grid.response-text-block.body">
    <Setter Property="Margin" Value="0,8,0,2" />
  </Style>
  <Style Selector="controls|MarkdownSelectableTextBlock.response-body">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="23" />
  </Style>
  <Style Selector="controls|MarkdownSelectableTextBlock.response-heading">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Margin" Value="0,3,0,2" />
  </Style>
  <Style Selector="controls|AppText.response-list-prefix">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="23" />
    <Setter Property="Margin" Value="6,0,0,0" />
  </Style>
  <Style Selector="controls|AppBorder.response-quote">
    <Setter Property="Padding" Value="10,1" />
  </Style>
  <Style Selector="controls|MarkdownSelectableTextBlock.response-quote-text">
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="UserControl.app-response-content.compact controls|MarkdownSelectableTextBlock.response-body">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="LineHeight" Value="19" />
  </Style>
  <Style Selector="UserControl.app-response-content.compact controls|MarkdownSelectableTextBlock">
    <Setter Property="CodeFontSize" Value="10.5" />
  </Style>
  <Style Selector="UserControl.app-response-content.compact controls|AppText.response-list-prefix">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="LineHeight" Value="19" />
  </Style>
  <Style Selector="UserControl.app-response-content.compact controls|MarkdownSelectableTextBlock.response-heading">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="UserControl.app-response-content.compact controls|MarkdownSelectableTextBlock.response-quote-text">
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="controls|AppBorder.response-code-heading">
    <Setter Property="Padding" Value="10,5" />
  </Style>
  <Style Selector="ScrollViewer.response-code-scroll">
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="MaxHeight" Value="360" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="controls|AppBorder.response-table-heading">
    <Setter Property="Width" Value="180" />
    <Setter Property="Padding" Value="8,7" />
  </Style>
  <Style Selector="controls|AppBorder.response-table-cell">
    <Setter Property="Width" Value="180" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
</Styles>
