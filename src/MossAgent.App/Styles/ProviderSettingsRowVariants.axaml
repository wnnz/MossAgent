<Styles xmlns="https://github.com/avaloniaui"
        xmlns:controls="clr-namespace:MossAgent.App.Controls">
  <Style Selector="Grid.provider-settings-header-layout">
    <Setter Property="MinHeight" Value="44" />
  </Style>
  <Style Selector="controls|AppProviderSettingsHeader StackPanel">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="controls|AppModelSettingsRow StackPanel">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="controls|AppText.provider-settings-label">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="controls|AppButton.provider-settings-action, controls|AppButton.settings-item-action">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <Style Selector="controls|AppButton.provider-settings-action:disabled, controls|AppButton.settings-item-action:disabled">
    <Setter Property="Opacity" Value="0.5" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="controls|AppBorder.model-settings-row-surface">
    <Setter Property="Padding" Value="8,9" />
  </Style>
</Styles>
