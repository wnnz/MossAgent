<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MossAgent.App.Controls">
  <Style Selector=".app-attachment-chip" x:SetterTargetType="controls:AppAttachmentChip">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="MaxWidth" Value="300" />
    <Setter Property="Margin" Value="0,0,6,4" />
  </Style>
  <Style Selector="controls|AppBorder.attachment-chip-surface">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="BoxShadow" Value="{StaticResource SharedSurfaceShadow}" />
  </Style>
  <Style Selector="controls|AppIcon.attachment-file-icon">
    <Setter Property="Size" Value="14" />
  </Style>
  <Style Selector=".attachment-thumbnail" x:SetterTargetType="controls:AppAttachmentThumbnail">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="controls|AppText.attachment-path">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="MaxWidth" Value="220" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="controls|AppText.attachment-size">
    <Setter Property="FontSize" Value="9.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="controls|AppButton.attachment-open">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="-8,-5,-8,-5" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="controls|AppButton.icon.attachment-remove">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="controls|AppButton.attachment-remove controls|AppIcon">
    <Setter Property="Size" Value="10" />
  </Style>
</Styles>
