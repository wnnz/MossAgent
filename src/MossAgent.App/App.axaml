  </Application.Resources>
  <Application.Styles>
    <StyleInclude Source="avares://MossAgent.App/Styles/WindowVariants.axaml" />
    <FluentTheme />
    <StyleInclude Source="avares://MossAgent.App/Styles/ScrollBarVariants.axaml" />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
    </Style>

    <Style Selector="FlyoutPresenter.app-flyout">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <!-- 文本样式 -->
    <Style Selector="controls|AppText">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="controls|AppText.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="controls|AppText.subtle">
      <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
    </Style>
    <Style Selector="controls|AppIconLabel">
      <Setter Property="Spacing" Value="5" />
    </Style>
    <Style Selector="controls|AppIconLabel.owned-icon-label">
      <Setter Property="Spacing" Value="9" />
    </Style>

    <!-- 基础按钮：精致极简，无老旧立体浮雕 -->
    <Style Selector="controls|AppButton">
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="controls|AppButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="controls|AppButton:pressed">
      <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!-- 主按钮：深色纯白高光、浅色纯黑高光，绝无多余阴影或灰色模糊 -->
    <Style Selector="controls|AppButton.primary">
      <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,6" />
    </Style>
    <Style Selector="controls|AppButton.primary:pointerover">
      <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="controls|AppButton.primary:disabled">
      <Setter Property="Background" Value="{DynamicResource DisabledButtonBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DisabledButtonForegroundBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- 幽灵按钮 -->
    <Style Selector="controls|AppButton.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="controls|AppButton.ghost:pointerover">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="controls|AppButton.ghost:disabled">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="controls|AppButton.ghost.navigation-history">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="controls|AppButton.ghost.navigation-history:pointerover">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="controls|AppButton.ghost.navigation-history:disabled">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="controls|AppButton.closeButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="controls|AppButton.closeButton:pointerover">
      <Setter Property="Background" Value="#E81123" />
      <Setter Property="BorderBrush" Value="#E81123" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="controls|AppButton.icon">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="controls|AppButton.icon.navigation-history">
      <Setter Property="Height" Value="30" />
    </Style>
    <Style Selector="controls|AppButton.icon.icon-compact">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
    </Style>
    <Style Selector="controls|AppButton.icon.icon-micro">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="controls|AppButton.icon.icon-copy">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="controls|AppIcon">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="StrokeThickness" Value="1.2" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="controls|AppIcon.icon-micro">
      <Setter Property="Size" Value="10" />
    </Style>
    <Style Selector="controls|AppIcon.icon-small">
      <Setter Property="Size" Value="12" />
    </Style>
    <Style Selector="controls|AppButton.expand-icon controls|AppIcon.ui-icon">
      <Setter Property="Size" Value="12" />
    </Style>
    <Style Selector="controls|AppIcon.icon-large">
      <Setter Property="Size" Value="16" />
    </Style>
    <Style Selector="controls|AppIcon.icon-hero">
      <Setter Property="Size" Value="24" />
    </Style>
    <Style Selector="controls|AppIcon.icon-brand">
      <Setter Property="Size" Value="46" />
      <Setter Property="StrokeThickness" Value="2" />
    </Style>
    <Style Selector="controls|AppCard">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="BoxShadow" Value="{StaticResource SharedSurfaceShadow}" />
    </Style>
    <Style Selector="controls|AppButton.closeButton:pointerover controls|AppIcon.ui-icon">
      <Setter Property="Stroke" Value="#FFFFFF" />
    </Style>
    <!-- 危险操作按钮 -->
    <Style Selector="controls|AppButton.danger">
      <Setter Property="Background" Value="{DynamicResource DangerButtonBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DangerButtonForegroundBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
    </Style>

    <!-- 容器卡片 -->
    <!-- 核心：彻底消除任何蓝色蓝框与原生蓝边高光！ -->
    <Style Selector=".app-input" x:SetterTargetType="controls:AppInput">
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="SelectionBrush" Value="#4B5563" />
    </Style>
    <Style Selector=".app-input:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
    </Style>
    <Style Selector=".app-input:focus-within /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
    </Style>
    <Style Selector=".app-input:pointerover:not(:focus-within) /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
    </Style>

    <!-- 列表项微交互 -->
    <Style Selector=".app-list-box" x:SetterTargetType="controls:AppListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardSubtleBackgroundBrush}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
    </Style>

    <Style Selector=".app-check-box" x:SetterTargetType="controls:AppCheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector=".app-toggle-button" x:SetterTargetType="controls:AppToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector=".app-toggle-button.settings-nav" x:SetterTargetType="controls:AppToggleButton">
      <Setter Property="Theme" Value="{StaticResource SettingsNavTheme}" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector=".app-toggle-button.settings-nav:pointerover" x:SetterTargetType="controls:AppToggleButton">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
    </Style>
    <Style Selector=".app-toggle-button.settings-nav:checked" x:SetterTargetType="controls:AppToggleButton">
      <Setter Property="Background" Value="{DynamicResource SettingsNavigationSelectionBrush}" />
    </Style>
    <Style Selector=".app-numeric-up-down" x:SetterTargetType="controls:AppNumericUpDown">
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="controls|AppSelectableText">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- 标签页样式 -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="controls|AppButton.composer-context-button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="controls|AppButton.composer-context-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <StyleInclude Source="avares://MossAgent.App/Styles/ComboBoxVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/EditableChoiceVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/NumericFieldVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/CheckBoxVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/SurfaceVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/ActionButtonVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/ConversationTabVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/ChatHeaderVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/ThemePaletteVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/ProjectPickerVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/CardInsetVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/ComposerResponsiveVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/SettingsLayoutVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/TypographyVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/ResponseContentVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/ThemePreviewVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/ThemeModePickerVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/DisclosureVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/PreviewScrollBarVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/SettingsDialogVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/ApprovalVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/AutomationVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/ConversationTurnVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/WindowCaptionVariants.axaml" />
    <StyleInclude Source="avares://MossAgent.App/Styles/EmptySessionResponsiveVariants.axaml" />
  </Application.Styles>
</Application>
