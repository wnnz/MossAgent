<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MossAgent.App.Controls">
  <Styles.Resources>
    <StreamGeometry x:Key="SidebarHeaderBell">M 3.5 17.5 L 5.5 15.5 L 5.5 9.5 C 5.5 5.9 8.4 3 12 3 C 15.6 3 18.5 5.9 18.5 9.5 L 18.5 15.5 L 20.5 17.5 Z M 8.5 17.5 C 8.5 19 10.1 20 12 20 C 13.9 20 15.5 19 15.5 17.5</StreamGeometry>
    <StreamGeometry x:Key="SidebarHeaderSearch">M 10 17 C 6.13 17 3 13.87 3 10 C 3 6.13 6.13 3 10 3 C 13.87 3 17 6.13 17 10 C 17 13.87 13.87 17 10 17 Z M 14.95 14.95 L 21 21</StreamGeometry>
    <StreamGeometry x:Key="ProjectNavigationClosedFolder">M 3 5 C 3 3.9 3.9 3 5 3 L 9 3 L 11 5 L 19 5 C 20.1 5 21 5.9 21 7 L 21 19 C 21 20.1 20.1 21 19 21 L 5 21 C 3.9 21 3 20.1 3 19 Z M 3 8 L 21 8</StreamGeometry>
    <StreamGeometry x:Key="ProjectNavigationOpenFolder">M 3 20 L 21 20 L 23 10 L 5 10 Z M 3 20 L 3 5 Q 3 3 5 3 L 10 3 L 12 5 L 18 5 Q 20 5 20 7 L 20 10</StreamGeometry>
    <ControlTheme x:Key="SidebarActivityIconTheme" TargetType="controls:AppIcon">
      <Setter Property="RenderTransform"><RotateTransform /></Setter>
      <Style Selector="^">
        <Style.Animations>
          <Animation Duration="0:0:1.2" IterationCount="Infinite">
            <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
            <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
          </Animation>
        </Style.Animations>
      </Style>
    </ControlTheme>
  </Styles.Resources>
  <Style Selector="controls|AppButton.sidebar-header-icon &gt; controls|AppIcon.ui-icon">
    <Setter Property="Size" Value="11" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="RenderTransform"><TranslateTransform X="0.5" Y="2.5" /></Setter>
  </Style>
  <Style Selector="controls|AppButton.sidebar-audit-trigger" x:SetterTargetType="controls:AppIconButton">
    <Setter Property="IconData" Value="{DynamicResource SidebarHeaderBell}" />
  </Style>
  <Style Selector="controls|AppButton.sidebar-search-trigger" x:SetterTargetType="controls:AppIconButton">
    <Setter Property="IconData" Value="{DynamicResource SidebarHeaderSearch}" />
  </Style>
  <Style Selector="controls|AppButton.sidebar-search-trigger &gt; controls|AppIcon.ui-icon">
    <Setter Property="StrokeThickness" Value="1.2" />
  </Style>
  <Style Selector=".app-project-navigation-row.dragging" x:SetterTargetType="controls:AppProjectNavigationRow">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="controls|AppBorder.project-drop-indicator">
    <Setter Property="Height" Value="2" />
    <Setter Property="CornerRadius" Value="1" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Background" Value="{DynamicResource TextBrush}" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector=".app-project-navigation-row.drop-before controls|AppBorder.project-drop-indicator">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector=".app-project-navigation-row.drop-after controls|AppBorder.project-drop-indicator">
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="controls|AppCard.sidebar-sort-menu">
    <Setter Property="Width" Value="192" />
  </Style>
  <Style Selector="controls|AppText.sidebar-sort-heading">
    <Setter Property="Margin" Value="8,4" />
  </Style>
  <Style Selector="controls|AppText.sidebar-sort-error">
    <Setter Property="Margin" Value="8,4,10,4" />
  </Style>
  <Style Selector=".app-scroll-viewer.sidebar-navigation-scroll" x:SetterTargetType="controls:AppScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Margin" Value="0,0,-9,0" />
    <Setter Property="Padding" Value="0,0,9,0" />
  </Style>
  <Style Selector=".app-scroll-viewer.sidebar-navigation-scroll /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb, .app-scroll-viewer.thin-scrollbar /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb, .app-list-box.thin-scrollbar /template/ ScrollViewer /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource SidebarScrollThumbBrush}" />
  </Style>
  <Style Selector=".app-scroll-viewer.sidebar-navigation-scroll /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb:pointerover, .app-scroll-viewer.sidebar-navigation-scroll /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb:pressed, .app-scroll-viewer.thin-scrollbar /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb:pointerover, .app-scroll-viewer.thin-scrollbar /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb:pressed, .app-list-box.thin-scrollbar /template/ ScrollViewer /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb:pointerover, .app-list-box.thin-scrollbar /template/ ScrollViewer /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb:pressed">
    <Setter Property="Background" Value="{DynamicResource SidebarScrollThumbHoverBrush}" />
  </Style>
  <Style Selector="StackPanel.sidebar-actions-header">
    <Setter Property="Margin" Value="0,0,0,21" />
  </Style>
  <Style Selector="StackPanel.sidebar-actions-header.has-pinned-tasks">
    <Setter Property="Margin" Value="0,0,0,17" />
  </Style>
  <Style Selector="StackPanel.sidebar-pinned-section">
    <Setter Property="Margin" Value="0,0,0,17" />
  </Style>
  <Style Selector="controls|AppText.sidebar-pinned-heading">
    <Setter Property="Margin" Value="8,0,0,10" />
  </Style>
  <Style Selector="controls|AppBorder.projects-section-header">
    <Setter Property="Margin" Value="8,0,10,5" />
  </Style>
  <Style Selector="controls|AppText.sidebar-recent-heading">
    <Setter Property="Margin" Value="8,22,0,10" />
  </Style>
  <Style Selector=".sidebar-task-list" x:SetterTargetType="controls:AppItemsControl">
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate><StackPanel Spacing="1" /></ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector=".sidebar-project-list" x:SetterTargetType="controls:AppItemsControl">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate><StackPanel Spacing="0" /></ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="StackPanel.sidebar-project-group">
    <Setter Property="Spacing" Value="0" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="StackPanel.sidebar-project-group.expanded">
    <Setter Property="Margin" Value="0,0,0,9" />
  </Style>
  <Style Selector=".app-project-navigation-row" x:SetterTargetType="controls:AppProjectNavigationRow">
    <Setter Property="Margin" Value="0,0,10,0" />
  </Style>
  <Style Selector="Grid.project-navigation-row">
    <Setter Property="UseLayoutRounding" Value="False" />
  </Style>
  <Style Selector=".app-project-navigation-row controls|AppButton.sidebar-project-row" x:SetterTargetType="controls:AppActionButton">
    <Setter Property="IconData" Value="{DynamicResource ProjectNavigationClosedFolder}" />
  </Style>
  <Style Selector=".app-project-navigation-row Grid.project-navigation-row.expanded controls|AppButton.sidebar-project-row" x:SetterTargetType="controls:AppActionButton">
    <Setter Property="IconData" Value="{DynamicResource ProjectNavigationOpenFolder}" />
  </Style>
  <Style Selector=".app-project-navigation-row controls|AppIcon.ui-icon">
    <Setter Property="Size" Value="12" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>
  <Style Selector=".app-project-navigation-row controls|AppButton.sidebar-project-row controls|AppIcon.ui-icon">
    <Setter Property="Size" Value="11" />
    <Setter Property="RenderTransform"><TranslateTransform X="2.5" Y="-1.5" /></Setter>
  </Style>
  <Style Selector=".app-project-navigation-row Grid.project-navigation-row.expanded controls|AppButton.sidebar-project-row controls|AppIcon.ui-icon">
    <Setter Property="Size" Value="13" />
    <Setter Property="RenderTransform"><TranslateTransform X="1.5" Y="-1.5" /></Setter>
  </Style>
  <Style Selector="controls|AppButton.sidebar-action-button controls|AppIcon.ui-icon">
    <Setter Property="Size" Value="11" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="RenderTransform"><TranslateTransform X="0.5" Y="-1" /></Setter>
  </Style>
  <Style Selector="controls|AppButton.sidebar-action-button">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="controls|AppButton.sidebar-action-button controls|AppText">
    <Setter Property="LineHeight" Value="18" />
  </Style>
  <Style Selector="Grid.task-navigation-row.selected controls|AppButton.ghost:pointerover">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="controls|AppButton.sidebar-task-row">
    <Setter Property="Padding" Value="32,6,8,6" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <Style Selector="controls|AppButton.sidebar-recent-task-row">
    <Setter Property="Padding" Value="8,6,8,6" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <Style Selector="Grid.task-navigation-row controls|AppText.sidebar-row">
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="FadeOverflow" Value="True" />
    <Setter Property="RenderTransform"><TranslateTransform Y="-1" /></Setter>
  </Style>
  <Style Selector="Grid.task-navigation-row controls|AppText.sidebar-row:overflowing">
    <Setter Property="OpacityMask">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="White" />
        <GradientStop Offset="0.92" Color="White" />
        <GradientStop Offset="1" Color="Transparent" />
      </LinearGradientBrush>
    </Setter>
  </Style>
  <Style Selector="Grid.task-navigation-row:pointerover controls|AppButton.sidebar-task-row, Grid.task-navigation-row:focus-within controls|AppButton.sidebar-task-row, Grid.task-navigation-row.actions-visible controls|AppButton.sidebar-task-row, Grid.task-navigation-row.running controls|AppButton.sidebar-task-row">
    <Setter Property="Padding" Value="32,6,36,6" />
  </Style>
  <Style Selector="Grid.task-navigation-row:pointerover controls|AppButton.sidebar-recent-task-row, Grid.task-navigation-row:focus-within controls|AppButton.sidebar-recent-task-row, Grid.task-navigation-row.actions-visible controls|AppButton.sidebar-recent-task-row, Grid.task-navigation-row.running controls|AppButton.sidebar-recent-task-row">
    <Setter Property="Padding" Value="8,6,36,6" />
  </Style>
  <Style Selector="controls|AppIcon.sidebar-task-activity">
    <Setter Property="Size" Value="12" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="Stroke" Value="{DynamicResource TextSubtleBrush}" />
    <Setter Property="Data" Value="M 12 3 A 9 9 0 1 1 3 12" />
    <Setter Property="Theme" Value="{StaticResource SidebarActivityIconTheme}" />
  </Style>
  <Style Selector="Grid.task-navigation-row:pointerover controls|AppIcon.sidebar-task-activity, Grid.task-navigation-row:focus-within controls|AppIcon.sidebar-task-activity, Grid.task-navigation-row.actions-visible controls|AppIcon.sidebar-task-activity">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Grid.task-navigation-row controls|AppButton.task-options">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="Grid.task-navigation-row:pointerover controls|AppButton.task-options, Grid.task-navigation-row:focus-within controls|AppButton.task-options, Grid.task-navigation-row.actions-visible controls|AppButton.task-options">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>
  <Style Selector="Grid.project-navigation-row controls|AppButton.project-toggle">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="Grid.project-navigation-row:pointerover controls|AppButton.project-toggle, Grid.project-navigation-row:focus-within controls|AppButton.project-toggle">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>
  <Style Selector="controls|AppBorder.projects-section-header controls|AppButton.project-header-action">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="controls|AppBorder.projects-section-header:pointerover controls|AppButton.project-header-action, controls|AppBorder.projects-section-header:focus-within controls|AppButton.project-header-action">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>
  <Style Selector="controls|AppButton.task-options:flyout-open, controls|AppButton.project-header-action:flyout-open">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>
</Styles>
