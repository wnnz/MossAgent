<ui:AppUserControl xmlns="https://github.com/avaloniaui" xmlns:res="clr-namespace:MossAgent.App.Resources"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MossAgent.App.Controls"
             xmlns:views="clr-namespace:MossAgent.App.Views"
             xmlns:vm="clr-namespace:MossAgent.App.ViewModels"
             x:Class="MossAgent.App.Views.WorkspaceChatView"
             x:CompileBindings="False">
  <ui:AppUserControl.Resources>
    <ui:EmptySessionViewportMarginConverter x:Key="EmptySessionViewportMarginConverter" />
    <ui:ComposerViewportHeightConverter x:Key="ComposerViewportHeightConverter" />
  </ui:AppUserControl.Resources>
  <ui:AppBorder Classes="chat-surface">
    <Grid RowDefinitions="52,*,Auto">
      <ui:AppConversationHeader ConversationTarget="{Binding Catalog.SelectedTask}"
                                 IsContextVisible="{Binding $parent[Window].DataContext.IsContextCardVisible}"
                                 IsInspectorOpen="{Binding $parent[Window].DataContext.IsRightPanelOpen}"
                                 InspectorLabel="{Binding $parent[Window].DataContext.RightPanelToggleLabel}"
                                 ToggleContextCommand="{Binding $parent[Window].DataContext.ToggleContextCardCommand}"
                                 ToggleInspectorCommand="{Binding $parent[Window].DataContext.ToggleRightPanelCommand}"
                                 ExpandInspectorCommand="{Binding $parent[ui:AppWorkspacePanes].ShowInspectorExpandedCommand}"
                                 StartupStatus="{Binding Startup.Status}" HasStartupStatus="{Binding Startup.HasStatus}"
                                 HasStartupWarning="{Binding Startup.HasWarning}"
                                 StartupActionLabel="{Binding Startup.OpenSettingsLabel}"
                                 StartupActionCommand="{Binding $parent[Window].DataContext.OpenMcpSettingsCommand}"
                                 Activity="{Binding Activity}" IsRunning="{Binding IsRunning}">
        <ui:AppConversationHeader.HeadingContent>
          <views:WorkspaceConversationTabsView />
        </ui:AppConversationHeader.HeadingContent>
        <ui:AppConversationHeader.MenuContent>
          <StackPanel>
            <ui:AppButton Content="{res:L '新对话'}" Classes="ghost align-leading" HorizontalAlignment="Stretch"
                          Command="{Binding Catalog.NewTaskCommand}" />
            <ui:AppButton Content="{res:L '重命名任务'}" Classes="ghost align-leading" HorizontalAlignment="Stretch"
                          IsVisible="{Binding Catalog.SelectedTask, Converter={x:Static ObjectConverters.IsNotNull}}"
                          Command="{Binding Catalog.TaskManagement.BeginRenameCommand}" />
            <ui:AppButton Content="{res:L '归档任务'}" Classes="ghost align-leading" HorizontalAlignment="Stretch"
                          IsVisible="{Binding Catalog.SelectedTask, Converter={x:Static ObjectConverters.IsNotNull}}"
                          Command="{Binding Catalog.TaskManagement.ArchiveCommand}" />
            <ui:AppButton Content="{Binding Catalog.TaskManagement.PinToggleLabel}" Classes="ghost align-leading"
                          HorizontalAlignment="Stretch" Command="{Binding Catalog.TaskManagement.TogglePinCommand}" />
            <ui:AppButton Content="{Binding Tabs.CloseTabLabel}" Classes="ghost align-leading" HorizontalAlignment="Stretch"
                          Command="{Binding Tabs.CloseTabCommand}" CommandParameter="{Binding Tabs.SelectedTab}" />
          </StackPanel>
        </ui:AppConversationHeader.MenuContent>
      </ui:AppConversationHeader>

      <Grid Grid.Row="1" IsVisible="{Binding IsEmptySession}">
        <Grid.Margin>
          <MultiBinding Converter="{StaticResource EmptySessionViewportMarginConverter}">
            <Binding Path="Catalog.SelectedTask" />
            <Binding Path="$parent[Window].DataContext.ChatMessageViewportMargin" />
          </MultiBinding>
        </Grid.Margin>
        <ui:AppEmptySessionLayout>
          <ui:AppIcon Classes="ui-icon icon-brand empty-agent-offset" Data="{StaticResource UiIconEmptyAgent}"
                Opacity="0.48"
                HorizontalAlignment="Center" />
          <ui:AppText Classes="type-27-5 weight-normal" Text="{Binding EmptySessionTitle}"
                     HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                     IsVisible="{Binding IsProjectlessChat}" />
          <ui:AppProjectPrompt Prefix="{Binding EmptySessionPrefix}" Suffix="{Binding EmptySessionSuffix}"
                               ProjectName="{Binding Catalog.SelectedProject.Name}"
                               SelectProjectCommand="{Binding OpenProjectPickerCommand}"
                               SwitchLabel="{Binding ProjectPickerSwitchLabel}"
                               IsVisible="{Binding !IsProjectlessChat}">
              <ui:AppProjectPrompt.ProjectFlyout>
                <ui:AppFlyout Placement="TopEdgeAlignedLeft" HorizontalOffset="-60"
                              DismissOnButtonClick="True">
                  <views:ProjectPickerFlyoutView />
                </ui:AppFlyout>
              </ui:AppProjectPrompt.ProjectFlyout>
          </ui:AppProjectPrompt>
          <ui:AppActionButton Classes="ghost empty-project-action" HorizontalAlignment="Center"
                  IsVisible="{Binding IsProjectlessChat}"
                  Command="{Binding Catalog.ProjectEditor.OpenCommand}"
                  ToolTip.Tip="{res:L '添加一个工作项目'}" Label="{res:L '添加项目'}"
                  IconData="{StaticResource UiIconPlus}" />
        </ui:AppEmptySessionLayout>
      </Grid>

      <ui:AppScrollViewer x:Name="MessageScrollViewer" Grid.Row="1" IsVisible="{Binding HasMessages}"
                    HorizontalScrollBarVisibility="Disabled"
                    Margin="{Binding $parent[Window].DataContext.ChatMessageViewportMargin}"
                    Padding="28,24">
        <StackPanel MaxWidth="740" HorizontalAlignment="Stretch">
        <ui:AppConversationTimeline Messages="{Binding Messages}" IsRunning="{Binding IsRunning}" />
        <ui:AppFileChangeSummary Summary="{Binding FileChanges}" IsVisible="{Binding FileChanges.HasChanges}" />
        <ui:AppTaskFailureNotice Hint="{Binding TaskFailureHint}"
                                 IsVisible="{Binding IsSelectedTaskFailed}" />
        </StackPanel>
      </ui:AppScrollViewer>

      <views:WorkspaceBottomPanel Grid.Row="1" VerticalAlignment="Bottom"
                                  DataContext="{Binding $parent[Window].DataContext}"
                                  IsVisible="{Binding $parent[Window].DataContext.IsBottomPanelOpen}" />
      <ui:AppScrollViewer Grid.Row="2" x:Name="ComposerScrollViewer" HorizontalScrollBarVisibility="Disabled">
        <ui:AppScrollViewer.MaxHeight>
          <MultiBinding Converter="{StaticResource ComposerViewportHeightConverter}">
            <Binding Path="Bounds" RelativeSource="{RelativeSource AncestorType=views:WorkspaceChatView}" />
            <Binding Path="$parent[Window].DataContext.ChatMessageViewportMargin" />
          </MultiBinding>
        </ui:AppScrollViewer.MaxHeight>
        <views:WorkspaceComposerView />
      </ui:AppScrollViewer>
    </Grid>
  </ui:AppBorder>
</ui:AppUserControl>
