<ui:AppUserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="using:MossAgent.App.Controls" xmlns:vm="using:MossAgent.App.ViewModels"
                   xmlns:text="using:MossAgent.App.Resources" x:Class="MossAgent.App.Views.GitPushDialog"
                   x:DataType="vm:GitPushViewModel">
  <ui:AppSettingsDialog IsOpen="{Binding IsOpen}" Title="{x:Static text:GitPushLabels.Title}"
                        CloseLabel="{x:Static text:GitCommitLabels.Cancel}" CloseCommand="{Binding CloseCommand}"
                        IsCloseButtonVisible="{Binding !IsBusy}">
    <StackPanel Spacing="8">
      <ui:AppText Text="{x:Static text:GitPushLabels.Warning}" Classes="muted type-12" TextWrapping="Wrap" />
      <ui:AppText Text="{Binding AvailableRemotes}" Classes="subtle type-11" TextWrapping="Wrap" />
      <ui:AppText Text="{x:Static text:GitPushLabels.Remote}" Classes="type-12" />
      <ui:AppInput x:Name="PushRemoteInput" Text="{Binding Remote}" MaxLength="256" IsEnabled="{Binding IsEditorEnabled}"
                   PlaceholderText="{x:Static text:GitPushLabels.RemoteHint}" AutomationProperties.Name="{x:Static text:GitPushLabels.Remote}" />
      <ui:AppText Text="{x:Static text:GitPushLabels.Branch}" Classes="type-12" />
      <ui:AppInput x:Name="PushBranchInput" Text="{Binding TargetBranch}" MaxLength="1024" IsEnabled="{Binding IsEditorEnabled}"
                   PlaceholderText="{x:Static text:GitPushLabels.BranchHint}" AutomationProperties.Name="{x:Static text:GitPushLabels.Branch}" />
      <ui:AppText Text="{Binding PreviewSummary}" Classes="muted type-12" TextWrapping="Wrap" IsVisible="{Binding HasPreview}" />
      <ui:AppText x:Name="PushCredentialText" Text="{Binding CredentialSummary}" Classes="muted type-12"
                  Classes.status-warning="{Binding HasCredentialWarning}" TextWrapping="Wrap" IsVisible="{Binding HasCredential}" />
    </StackPanel>
    <ui:AppSettingsDialog.Footer>
      <StackPanel Spacing="8">
        <WrapPanel>
          <ui:AppButton x:Name="ConfirmPushButton" Classes="primary" Content="{x:Static text:GitPushLabels.Confirm}" Command="{Binding PushCommand}" />
          <ui:AppButton x:Name="RefreshPushButton" Content="{x:Static text:GitCommitLabels.Refresh}" Command="{Binding RefreshPreviewCommand}" />
          <ui:AppButton Content="{x:Static text:GitCommitLabels.Cancel}" Command="{Binding CloseCommand}" IsVisible="{Binding !IsBusy}" />
          <ui:AppButton x:Name="StopPushButton" Content="{x:Static text:GitCommitLabels.Stop}" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
        </WrapPanel>
        <ui:AppText Text="{Binding Status}" Classes="subtle type-11" TextWrapping="Wrap" IsVisible="{Binding HasStatus}" />
      </StackPanel>
    </ui:AppSettingsDialog.Footer>
  </ui:AppSettingsDialog>
</ui:AppUserControl>
