<ui:AppUserControl xmlns="https://github.com/avaloniaui" xmlns:res="clr-namespace:MossAgent.App.Resources"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MossAgent.App.Controls"
             xmlns:labels="clr-namespace:MossAgent.App.Resources"
             x:Class="MossAgent.App.Views.McpSettingsPane"
             x:CompileBindings="False">
  <ui:AppUserControl.Resources>
    <ui:McpServerSummaryConverter x:Key="McpServerSummaryConverter" />
  </ui:AppUserControl.Resources>
  <Grid>
    <Grid Classes="settings-content-column" RowDefinitions="Auto,*">
        <ui:AppSettingsPageHeader Classes="separated" Title="{res:L '插件'}" Description="{res:L '通过 MCP 连接外部工具和服务。'}"
                                  Status="{Binding Status}" IsStatusError="{Binding HasStatusError}">
          <ui:AppSettingsPageHeader.Actions>
            <StackPanel Classes="settings-header-actions">
              <ui:AppButton Content="{x:Static labels:McpSettingsLabels.Reconnect}" Classes="ghost"
                            Command="{Binding ReloadCommand}" IsVisible="{Binding !ReloadCommand.IsRunning}" />
              <ui:AppButton Content="{x:Static labels:McpSettingsLabels.CancelReconnect}" Classes="ghost"
                            Command="{Binding CancelReloadCommand}" IsVisible="{Binding ReloadCommand.IsRunning}" />
              <ui:AppActionButton Label="{res:L '添加 MCP 服务'}" IconData="{StaticResource UiIconPlus}" Classes="primary" Command="{Binding OpenCreateFormCommand}" />
            </StackPanel>
          </ui:AppSettingsPageHeader.Actions>
        </ui:AppSettingsPageHeader>
    <ui:AppCard Grid.Row="1" Classes="card card-inset-list settings-catalog-card">
      <Grid RowDefinitions="Auto,*">
        <ui:AppEmptyState Classes="settings-empty" IsVisible="{Binding HasNoItems}"
                          IconData="{StaticResource UiIconPlug}" Title="{res:L '还没有 MCP 服务'}"
                          Description="{res:L '添加服务后，它提供的工具会在允许的任务中可用。'}" />
        <ui:AppListBox Grid.Row="1" Classes="settings-catalog-list" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                       IsEnabled="{Binding CanEdit}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <ui:AppSettingsItemRow Title="{Binding Name}"
                    Subtitle="{Binding ., Converter={StaticResource McpServerSummaryConverter}}"
                    ActionTarget="{Binding}" IsPrimaryAlternate="{Binding IsEnabled}"
                    PrimaryLabel="{x:Static labels:SettingsItemLabels.Enable}"
                    AlternatePrimaryLabel="{x:Static labels:SettingsItemLabels.Disable}"
                    PrimaryCommand="{Binding $parent[UserControl].DataContext.ToggleEnabledCommand}"
                    SecondaryLabel="{x:Static labels:SettingsItemLabels.Edit}"
                    SecondaryCommand="{Binding $parent[UserControl].DataContext.OpenEditFormCommand}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ui:AppListBox>
      </Grid>
    </ui:AppCard>
    </Grid>

    <ui:AppSettingsDialog Classes="wide" IsOpen="{Binding IsFormOpen}"
                          Title="{Binding EditorTitle}" CloseCommand="{Binding CloseFormCommand}">
            <StackPanel Spacing="9">
            <ui:AppText Text="{x:Static labels:McpSettingsLabels.ServerName}" Classes="muted type-12" />
            <ui:AppInput Text="{Binding Name}" PlaceholderText="{res:L '例如 filesystem'}"
                         AutomationProperties.Name="{x:Static labels:McpSettingsLabels.ServerName}" />
            <ui:AppText Text="{x:Static labels:McpSettingsLabels.Transport}" Classes="muted type-12" />
            <ui:AppComboBox ItemsSource="{Binding TransportOptions}" SelectedItem="{Binding SelectedTransportOption}"
                            AutomationProperties.Name="{x:Static labels:McpSettingsLabels.Transport}"
                            DisplayMemberBinding="{Binding DisplayName}" HorizontalAlignment="Stretch" />
            <StackPanel Spacing="9" IsVisible="{Binding IsStdioTransport}">
              <ui:AppText Text="{x:Static labels:McpSettingsLabels.Command}" Classes="muted type-12" />
              <ui:AppInput Text="{Binding Command}" PlaceholderText="{res:L '例如 npx'}"
                           AutomationProperties.Name="{x:Static labels:McpSettingsLabels.Command}" />
              <ui:AppText Text="{x:Static labels:McpSettingsLabels.Arguments}" Classes="muted type-12" />
              <ui:AppInput Text="{Binding ArgumentsJson}" AcceptsReturn="True" Classes="code-font json-editor"
                           AutomationProperties.Name="{x:Static labels:McpSettingsLabels.Arguments}" />
              <ui:AppText Text="{x:Static labels:McpSettingsLabels.WorkingDirectory}" Classes="muted type-12" />
              <ui:AppInput Text="{Binding WorkingDirectory}"
                           AutomationProperties.Name="{x:Static labels:McpSettingsLabels.WorkingDirectory}" />
              <ui:AppText Text="{x:Static labels:McpSettingsLabels.Environment}" Classes="muted type-12" />
              <ui:AppInput Text="{Binding EnvironmentJson}" AcceptsReturn="True" Classes="code-font json-editor"
                           AutomationProperties.Name="{x:Static labels:McpSettingsLabels.Environment}" />
            </StackPanel>
            <StackPanel Spacing="9" IsVisible="{Binding IsHttpTransport}">
              <ui:AppText Text="{x:Static labels:McpSettingsLabels.Url}" Classes="muted type-12" />
              <ui:AppInput Text="{Binding Url}" PlaceholderText="http://localhost:8000/sse"
                           AutomationProperties.Name="{x:Static labels:McpSettingsLabels.Url}" />
              <ui:AppText Text="{x:Static labels:McpSettingsLabels.Headers}" Classes="muted type-12" />
              <ui:AppInput Text="{Binding HeadersJson}" AcceptsReturn="True" Classes="code-font json-editor"
                           AutomationProperties.Name="{x:Static labels:McpSettingsLabels.Headers}" />
              <ui:AppText Text="{x:Static labels:McpSettingsLabels.Proxy}" Classes="muted type-12" />
              <ui:AppComboBox ItemsSource="{Binding ProxyOptions}" SelectedItem="{Binding SelectedProxy}"
                              AutomationProperties.Name="{x:Static labels:McpSettingsLabels.Proxy}"
                              DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <ui:AppCheckBox Content="{res:L '启用此 MCP Server'}" IsChecked="{Binding IsEnabled}" Margin="0,4" />
            </StackPanel>
          <ui:AppSettingsDialog.Footer>
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <ui:AppButton Classes="primary" Content="{res:L '保存并连接'}" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" />
              <ui:AppButton Grid.Column="1" Classes="danger" Content="{Binding DeleteButtonText}"
                            Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" />
              <ui:AppButton Grid.Column="2" Content="{res:L '取消'}" Command="{Binding CloseFormCommand}" />
            </Grid>
            <ui:AppText Text="{Binding Status}" Classes="subtle type-11" Classes.status-error="{Binding HasStatusError}"
                        TextWrapping="Wrap" IsVisible="{Binding HasStatus}" />
          </StackPanel>
          </ui:AppSettingsDialog.Footer>
    </ui:AppSettingsDialog>
  </Grid>
</ui:AppUserControl>
