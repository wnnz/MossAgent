<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="DisabledButtonBackgroundBrush" Color="#D9D9D9" />
      <SolidColorBrush x:Key="DisabledButtonForegroundBrush" Color="#7A7A7A" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="DisabledButtonBackgroundBrush" Color="#3A3A3A" />
      <SolidColorBrush x:Key="DisabledButtonForegroundBrush" Color="#8B8B8B" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
