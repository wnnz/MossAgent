<ui:AppUserControl xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:MossAgent.App.Controls"
                   xmlns:resources="clr-namespace:MossAgent.App.Resources"
                   x:Class="MossAgent.App.Controls.AppThemeModePicker"
                   Classes="app-theme-mode-picker" x:CompileBindings="False">
  <ui:AppCard Classes="card theme-mode-surface">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <ui:AppText Text="{x:Static resources:AppearanceText.Mode}" Classes="type-13" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
        <ui:AppButton Classes="ghost theme-mode-button"
                      Classes.selected="{Binding IsSystemThemeSelected}"
                      AutomationProperties.Name="系统主题" ToolTip.Tip="跟随系统"
                      Command="{Binding SelectThemeCommand}" CommandParameter="System">
          <ui:AppViewbox Classes="theme-mode-thumbnail">
            <ui:AppThemePreview Classes="preview-system" />
          </ui:AppViewbox>
        </ui:AppButton>
        <ui:AppButton Classes="ghost theme-mode-button"
                      Classes.selected="{Binding IsLightThemeSelected}"
                      AutomationProperties.Name="浅色主题" ToolTip.Tip="浅色"
                      Command="{Binding SelectThemeCommand}" CommandParameter="Light">
          <ui:AppViewbox Classes="theme-mode-thumbnail">
            <ui:AppThemePreview Classes="preview-light" />
          </ui:AppViewbox>
        </ui:AppButton>
        <ui:AppButton Classes="ghost theme-mode-button"
                      Classes.selected="{Binding IsDarkThemeSelected}"
                      AutomationProperties.Name="深色主题" ToolTip.Tip="深色"
                      Command="{Binding SelectThemeCommand}" CommandParameter="Dark">
          <ui:AppViewbox Classes="theme-mode-thumbnail">
            <ui:AppThemePreview Classes="preview-dark" />
          </ui:AppViewbox>
        </ui:AppButton>
      </StackPanel>
    </Grid>
  </ui:AppCard>
</ui:AppUserControl>
