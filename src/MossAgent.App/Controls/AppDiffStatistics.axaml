<ui:AppUserControl xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:MossAgent.App.Controls"
                   x:Class="MossAgent.App.Controls.AppDiffStatistics" x:Name="Root" x:CompileBindings="False">
  <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
    <ui:AppText Classes="diff-statistics-added" Text="{Binding AddedLabel, ElementName=Root}" />
    <ui:AppText Classes="diff-statistics-removed" Text="{Binding RemovedLabel, ElementName=Root}" />
  </StackPanel>
</ui:AppUserControl>
