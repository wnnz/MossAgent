<ui:AppUserControl xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="clr-namespace:MossAgent.App.Controls"
                   x:Class="MossAgent.App.Views.WorkspaceFollowupQueueView" x:CompileBindings="False">
  <ui:AppCard Classes="card-inset-composer" IsVisible="{Binding IsVisible}">
    <ui:AppScrollViewer Classes="followup-queue" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="6">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
        <ui:AppText Classes="type-11" Text="{Binding Title}" VerticalAlignment="Center" />
        <ui:AppButton Grid.Column="1" Classes="ghost menu-option" Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}" />
        <ui:AppButton Grid.Column="2" Classes="ghost menu-option" Content="{Binding ContinueLabel}" Command="{Binding ContinueCommand}" />
      </Grid>
        <ui:AppItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="3" Margin="0,0,0,6">
                <ui:AppText Classes="type-11" Text="{Binding Prompt}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                <ui:AppText Classes="type-10-5 text-muted" Text="{Binding ModelLabel}" TextTrimming="CharacterEllipsis" />
                <ui:AppText Classes="type-10-5 text-muted" Text="{Binding AttachmentLabel}" IsVisible="{Binding HasAttachments}" />
                <WrapPanel Orientation="Horizontal">
                  <ui:AppButton Classes="ghost menu-option" Content="{Binding EditLabel}" Command="{Binding EditCommand}" />
                  <ui:AppButton Classes="ghost menu-option" Content="{Binding UpLabel}" Command="{Binding MoveUpCommand}" />
                  <ui:AppButton Classes="ghost menu-option" Content="{Binding DownLabel}" Command="{Binding MoveDownCommand}" />
                  <ui:AppButton Classes="ghost menu-option" Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" />
                </WrapPanel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ui:AppItemsControl>
      <ui:AppContentControl Content="{Binding Editor}">
        <ContentControl.ContentTemplate>
          <DataTemplate>
            <ui:AppInput Classes="followup-editor" Text="{Binding EditText}" AcceptsReturn="True" TextWrapping="Wrap" />
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ui:AppContentControl>
      <WrapPanel Orientation="Horizontal" IsVisible="{Binding HasEditor}">
        <ui:AppButton Classes="ghost menu-option" Content="{Binding SaveLabel}" Command="{Binding SaveEditCommand}" />
        <ui:AppButton Classes="ghost menu-option" Content="{Binding CancelLabel}" Command="{Binding CancelEditCommand}" />
      </WrapPanel>
      <ui:AppText Classes="type-10-5 text-muted" Text="{Binding Hint}" TextWrapping="Wrap" />
      <ui:AppText Classes="type-11 status-warning" Text="{Binding Notice}" TextWrapping="Wrap" IsVisible="{Binding HasNotice}" />
    </StackPanel>
    </ui:AppScrollViewer>
  </ui:AppCard>
</ui:AppUserControl>
